{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fullchaos.dev/contracts/auth/v1/jsonschema/organization-read.v1.schema.json",
  "title": "Auth Control Plane organization read (v1 wire format)",
  "description": "An organization as the versioned read API serves it. Same members as organization.v1; the ids are the wire form of provisioning-event.v1 (a prefix and 1 to 64 id characters).",
  "type": "object",
  "required": [
    "schema_version",
    "organization_id",
    "slug",
    "name",
    "status",
    "revision",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "organization-read.v1",
      "description": "Contract identifier. A reader MUST reject an unrecognised value (G-26: unknown denies)."
    },
    "organization_id": {
      "type": "string",
      "pattern": "^org_[A-Za-z0-9_-]{1,64}$",
      "description": "The organization."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "description": "Stable external handle."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Mutable display label."
    },
    "status": {
      "enum": [
        "active",
        "suspended"
      ],
      "description": "Current state."
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Aggregate revision. 0 means the aggregate has no revision row yet; a caller treats 0 as 'none' and never as a version to send back. Integer token only; a decimal-form token is refused by every client (README, integer guard)."
    },
    "created_at": {
      "type": "string",
      "pattern": "^([0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?(Z|[+-](0[0-9]|1[0-9]|2[0-3]):[0-5][0-9])$",
      "description": "Creation instant."
    },
    "updated_at": {
      "type": "string",
      "pattern": "^([0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?(Z|[+-](0[0-9]|1[0-9]|2[0-3]):[0-5][0-9])$",
      "description": "Last change instant."
    }
  }
}
