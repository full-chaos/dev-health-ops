  "reject_by_client": [
    {
      "file": "client-rejected-lifetime-over-the-ceiling.json",
      "why": "exp - iat one second over the 300 s ceiling."
    },
    {
      "file": "client-rejected-lifetime-one-hour.json",
      "why": "exp - iat of 3600 s, the user access token's ceiling: a service account token never lives that long."
    },
    {
      "file": "client-rejected-exp-equals-nbf.json",
      "why": "exp equals nbf: an empty validity window."
    },
    {
      "file": "client-rejected-nbf-before-iat.json",
      "why": "nbf one second before iat: the schema accepts it, only the client rule refuses it."
    },
    {
      "file": "client-rejected-duplicate-claim-aud.json",
      "why": "aud appears twice (acr-api, then dev-health-api): the schema sees the survivor."
    },
    {
      "file": "client-rejected-duplicate-claim-cid.json",
      "why": "cid appears twice: the schema sees the survivor."
    },
    {
      "file": "client-rejected-duplicate-header-typ.json",
      "why": "typ appears twice (at+jwt, then sa+jwt): the schema sees the survivor."
    },
    {
      "file": "client-rejected-exp-decimal-form.json",
      "why": "exp in decimal form (a NumericDate is an integer token): the schema accepts 1760000300.0."
    }
  ]
}
