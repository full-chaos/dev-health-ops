{
  "$defs": {
    "AskDevSurfaceRouteID": {
      "enum": [
        "diagnose_overview",
        "flow_metrics",
        "investment",
        "work_graph",
        "complexity",
        "cognitive_load",
        "bottlenecks",
        "repository_detail",
        "project_detail",
        "work_unit_detail",
        "issue_detail",
        "pull_request_detail",
        "data_health"
      ],
      "title": "AskDevSurfaceRouteID",
      "type": "string"
    },
    "DevEntityRef": {
      "additionalProperties": false,
      "properties": {
        "display_label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Display Label",
          "type": "string"
        },
        "entity_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/#-]{0,127}$",
          "title": "Entity Id",
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/EntityType"
        },
        "repository_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/#-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Id"
        }
      },
      "required": [
        "entity_type",
        "entity_id",
        "display_label"
      ],
      "title": "DevEntityRef",
      "type": "object"
    },
    "DevScopeV2": {
      "additionalProperties": false,
      "properties": {
        "comparison_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/DevTimeRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "direct_scope": {
          "$ref": "#/$defs/DirectScope"
        },
        "entity_refs": {
          "items": {
            "$ref": "#/$defs/DevEntityRef"
          },
          "maxItems": 20,
          "title": "Entity Refs",
          "type": "array"
        },
        "organization_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/#-]{0,127}$",
          "title": "Organization Id",
          "type": "string"
        },
        "repositories": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/#-]{0,127}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Repositories",
          "type": "array"
        },
        "schema_version": {
          "const": "dev_scope.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "surface_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/DevSurfaceContextV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "team_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/#-]{0,127}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Team Ids",
          "type": "array"
        },
        "time_range": {
          "$ref": "#/$defs/DevTimeRange"
        }
      },
      "required": [
        "schema_version",
        "organization_id",
        "direct_scope",
        "time_range"
      ],
      "title": "DevScopeV2",
      "type": "object"
    },
    "DevSurfaceContextV2": {
      "additionalProperties": false,
      "properties": {
        "entity_refs": {
          "items": {
            "$ref": "#/$defs/DevEntityRef"
          },
          "maxItems": 20,
          "title": "Entity Refs",
          "type": "array"
        },
        "filter_fingerprint": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/#-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filter Fingerprint"
        },
        "route_id": {
          "$ref": "#/$defs/AskDevSurfaceRouteID"
        }
      },
      "required": [
        "route_id"
      ],
      "title": "DevSurfaceContextV2",
      "type": "object"
    },
    "DevTimeRange": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "timezone": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "title": "DevTimeRange",
      "type": "object"
    },
    "DirectScope": {
      "enum": [
        "organization",
        "repository",
        "project",
        "work_unit",
        "issue",
        "pull_request"
      ],
      "title": "DirectScope",
      "type": "string"
    },
    "EntityType": {
      "enum": [
        "repository",
        "project",
        "work_unit",
        "issue",
        "pull_request"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "MetricID": {
      "enum": [
        "items_completed",
        "cycle_time_p50_hours",
        "avg_wip",
        "deployments_count",
        "change_failure_rate",
        "investment_allocation_pct",
        "cyclomatic_per_kloc",
        "compounding_risk_score"
      ],
      "title": "MetricID",
      "type": "string"
    },
    "QuestionClass": {
      "enum": [
        "status",
        "remaining_work",
        "observed_change",
        "registered_statistics",
        "data_trust",
        "investigation"
      ],
      "title": "QuestionClass",
      "type": "string"
    }
  },
  "$id": "https://api.fullchaos.dev/contracts/ask-dev/v2/dev_message_request.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Request amendment: no authoritative client-supplied ``question_class``.\n\n``question_class_hint`` retains the v1 field for migration-window\ncompatibility, but it is documented and enforced (by\n``DevQuestionIntent.client_hint_deprecation_warning``) as untrusted\ninput the interpreter must ignore for planning.",
  "properties": {
    "client_message_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/#-]{0,127}$",
      "title": "Client Message Id",
      "type": "string"
    },
    "conversation_id": {
      "anyOf": [
        {
          "maxLength": 36,
          "minLength": 36,
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conversation Id"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/#-]{0,127}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "question": {
      "maxLength": 8192,
      "minLength": 1,
      "title": "Question",
      "type": "string",
      "x-max-utf8-bytes": 8192
    },
    "question_class_hint": {
      "anyOf": [
        {
          "$ref": "#/$defs/QuestionClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/#-]{0,127}$",
      "title": "Request Id",
      "type": "string"
    },
    "requested_metric_ids": {
      "items": {
        "$ref": "#/$defs/MetricID"
      },
      "maxItems": 8,
      "title": "Requested Metric Ids",
      "type": "array"
    },
    "retry_of_run_id": {
      "anyOf": [
        {
          "maxLength": 36,
          "minLength": 36,
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retry Of Run Id"
    },
    "schema_version": {
      "const": "dev_message_request.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/DevScopeV2"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "client_message_id",
    "idempotency_key",
    "question",
    "scope"
  ],
  "title": "DevMessageRequestV2",
  "type": "object"
}
