    helm.sh/chart: ops-0.1.0
  name: dev-health-ops-query-api-mcp
  namespace: dev-health
spec:
  ingress:
  - ports:
    - port: 8090
      protocol: TCP
  - from:
    - podSelector:
        matchLabels:
          app.kubernetes.io/component: api
          app.kubernetes.io/instance: dev-health-acr
          app.kubernetes.io/name: acr
    ports:
    - port: 8092
      protocol: TCP
  podSelector:
    matchLabels:
      app.kubernetes.io/component: query-api
      app.kubernetes.io/instance: dev-health
      app.kubernetes.io/name: ops
  policyTypes:
  - Ingress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  labels:
    app.kubernetes.io/component: query-api-internal
    app.kubernetes.io/instance: dev-health
    app.kubernetes.io/name: ops
  name: dev-health-ops-query-api-internal
  namespace: dev-health
spec:
  ingress:
  - ports:
    - port: 8090
      protocol: TCP
  - from:
    - podSelector:
        matchLabels:
          app.kubernetes.io/component: api
          app.kubernetes.io/instance: dev-health-acr
          app.kubernetes.io/name: acr
    - podSelector:
        matchLabels:
          app.kubernetes.io/component: go-api-tools
    ports:
    - port: 8091
      protocol: TCP
  podSelector:
    matchLabels:
      app.kubernetes.io/component: query-api
      app.kubernetes.io/instance: dev-health
      app.kubernetes.io/name: ops
  policyTypes:
  - Ingress
---
