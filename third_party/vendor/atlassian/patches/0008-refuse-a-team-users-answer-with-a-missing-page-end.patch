+// checkTeamUsersShape refuses a teamworkGraph_teamUsers answer that does not say where its list ends (local
+// modification, patch 0008). The typed decode above reads a missing or null pageInfo, and a missing or null
+// hasNextPage, as "no next page"; a caller that takes the result for the whole roster would then drop every
+// member the answer did not carry. A page end counts only when the answer states it.
+func checkTeamUsersShape(body []byte) error {
+	var shape struct {
+		Result *struct {
+			PageInfo *struct {
+				HasNextPage *bool `json:"hasNextPage"`
+			} `json:"pageInfo"`
+		} `json:"teamworkGraph_teamUsers"`
+	}
+	if err := json.Unmarshal(body, &shape); err != nil {
+		return err
+	}
+	if shape.Result == nil {
+		return errors.New("missing teamworkGraph_teamUsers")
+	}
+	if shape.Result.PageInfo == nil || shape.Result.PageInfo.HasNextPage == nil {
+		return errors.New("missing teamworkGraph_teamUsers.pageInfo.hasNextPage")
+	}
+	return nil
+}
