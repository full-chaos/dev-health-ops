      "results-by-result": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "match, mismatch, error, dropped, skipped, impersonation_refused, decided_no_question. Zero mismatches is not good while all calls are error, dropped, skipped, impersonation_refused or decided_no_question.",
            "name": "Shadow results by result (coverage)"
          },
          "links": null,
          "plugin": {
            "kind": "signoz/BarChartPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": null,
                "softMin": null
              },
              "formatting": {
                "decimalPrecision": "2",
                "unit": ""
              },
              "legend": {
                "customColors": null,
