# stack.files (CHAOS-8693): the ONE list of what `stack.sh` hands to docker compose for the bigboy stack.
# Line format: <set> <kind> <value>
#   kind project   : the compose project name (-p)
#   kind env-file  : an --env-file path, relative to the bigboy root
#   kind profile   : a --profile name
#   kind root      : a compose file, relative to the bigboy root (BIGBOY_ROOT, the running tree)
#   kind tools     : a compose file, relative to this directory (BIGBOY_TOOLS_DIR, travels with the checkout)
# `root`/`tools` lines are ordered: later files win. Add a file HERE, never as a `-f` in a script.
# Sets: `stack` is the live chain bigboy-cut.sh runs; the others are the one-off chains of one step each.
# Each set below equals, file for file, the chain its legacy script builds today
# (tests/tooling/test_bigboy_stack_files.py reads both and fails on any difference).

stack project  dev-health
stack env-file ops/.env
stack root     compose.yml
stack root     compose/compose.go.workers.yml
stack root     .remember/lanes/team-lead/reconciler-sweep-override.yml
stack root     compose/compose.bigboy.images.yml
stack tools    compose.bigboy.workers.yml
stack tools    compose.bigboy.clickhouse-users.yml
stack tools    compose.bigboy.billing-edge.yml
stack tools    compose.bigboy.router.yml

smoke project  dev-health
smoke env-file ops/.env
smoke root     compose.yml
smoke root     compose/compose.go.workers.yml
smoke root     .remember/lanes/team-lead/reconciler-sweep-override.yml
smoke root     compose/compose.bigboy.images.yml
smoke tools    compose.bigboy.router.yml
smoke tools    compose.bigboy.smoke.yml

prove project  dev-health
prove env-file ops/.env
prove profile  venue
prove root     compose.yml
prove root     compose/compose.go.workers.yml
prove root     .remember/lanes/team-lead/reconciler-sweep-override.yml
prove root     compose/compose.bigboy.images.yml
prove tools    compose.bigboy.prove.yml

hook-check project  dev-health
hook-check env-file ops/.env
hook-check profile  venue
hook-check root     compose.yml
hook-check tools    compose.bigboy.hook-check.yml

river-apply project  dev-health
river-apply env-file ops/.env
river-apply profile  venue
river-apply root     compose.yml
river-apply tools    compose.bigboy.river-apply.yml
