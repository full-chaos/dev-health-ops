{
  "schema_version": 1,
  "name": "linear canonical work-items route and effect recovery",
  "build": [
    "go",
    "test",
    "-run",
    "^$",
    "./internal/providersync/"
  ],
  "mutations": [
    {
      "id": "L1-route-rejects-wrong-provider",
      "file": "internal/providersync/linear_work_items_route.go",
      "find": "ctx == nil || claim.Validate() != nil || claim.Provider != \"linear\" ||",
      "replace": "ctx == nil || claim.Validate() != nil || false ||",
      "rationale": "the provider-only route must not accept a claim owned by another provider",
      "proof": [["go", "test", "-count=1", "-run", "^TestLinearWorkItemsRouteRejectsInvalidScopeAndLease$", "./internal/providersync/"]]
    },
    {
      "id": "L2-route-rejects-credential-provider-mismatch",
      "file": "internal/providersync/linear_work_items_route.go",
      "find": "claim.Dataset != \"work-items\" || credential.Provider != \"linear\" ||",
      "replace": "claim.Dataset != \"work-items\" || false ||",
      "rationale": "the provider-only route must not send a Linear request with a credential owned by another provider",
      "proof": [["go", "test", "-count=1", "-run", "^TestLinearWorkItemsRouteRejectsInvalidScopeAndLease$", "./internal/providersync/"]]
    },
    {
      "id": "L3-pagination-cap-fails-closed",
      "file": "internal/providersync/linear_work_items_route.go",
      "find": "if page.CapReached {\n\t\treturn CompleteRouteBatch{}, ErrPaginationCapExceeded\n\t}",
      "replace": "if false {\n\t\treturn CompleteRouteBatch{}, ErrPaginationCapExceeded\n\t}",
      "rationale": "a capped GraphQL collection cannot advance the watermark as if the provider result were complete",
      "proof": [["go", "test", "-count=1", "-run", "^TestLinearWorkItemsRouteFailsClosedOnGraphQLErrorsAndCaps$", "./internal/providersync/"]]
    },
    {
      "id": "L4-effects-are-readback-required",
      "file": "internal/providersync/linear_work_items_effects.go",
      "find": "destination, EffectReadbackRequired, projections[destination],",
      "replace": "destination, EffectReplaySafe, projections[destination],",
      "rationale": "all six Linear raw destinations can be durably written before acknowledgement and therefore require semantic readback recovery",
      "proof": [["go", "test", "-count=1", "-run", "^TestBuildLinearWorkItemEffectsIsDeterministicAndExhaustive$", "./internal/providersync/"]]
    },
    {
      "id": "L5-readback-is-tenant-fenced",
      "file": "internal/providersync/linear_work_items_effects.go",
      "find": "OrgID: claim.OrgID, Provider: claim.Provider, Dataset: claim.Dataset,",
      "replace": "OrgID: \"org-hard-coded\", Provider: claim.Provider, Dataset: claim.Dataset,",
      "rationale": "effect identity must use the claimed tenant and never a constant or row-provided organization",
      "proof": [["go", "test", "-count=1", "-run", "^TestLinearWorkItemEffectsFenceLeaseTenantAndTampering$", "./internal/providersync/"]]
    },
    {
      "id": "L6-readback-is-generation-fenced",
      "file": "internal/providersync/linear_work_items_effects.go",
      "find": "Generation: claim.GenerationKey(), Destination: effect.Destination,",
      "replace": "Generation: \"sync-unit:wrong\", Destination: effect.Destination,",
      "rationale": "recovery must reconcile the same stable sync-unit generation rather than another unit's destination",
      "proof": [["go", "test", "-count=1", "-run", "^TestLinearWorkItemEffectsFenceLeaseTenantAndTampering$", "./internal/providersync/"]]
    },
    {
      "id": "L7-effect-digest-is-recomputed",
      "file": "internal/providersync/linear_work_items_effects.go",
      "find": "rebuilt.ContentDigest != effect.ContentDigest ||",
      "replace": "false ||",
      "rationale": "a caller-mutated payload must not be authorized by a stale digest",
      "proof": [["go", "test", "-count=1", "-run", "^TestLinearWorkItemEffectsFenceLeaseTenantAndTampering$", "./internal/providersync/"]]
    },
    {
      "id": "L8-all-adapters-required-before-write",
      "file": "internal/providersync/linear_work_items_effects.go",
      "find": "if err != nil || !sink.complete() {",
      "replace": "if err != nil || false {",
      "rationale": "a partially constructed six-destination sink must fail before any destination can land alone",
      "proof": [["go", "test", "-count=1", "-run", "^TestLinearWorkItemEffectsFenceLeaseTenantAndTampering$", "./internal/providersync/"]]
    },
    {
      "id": "L9-destination-dispatch-is-not-cross-wired",
      "file": "internal/providersync/linear_work_items_effects.go",
      "find": "case \"work_items\":\n\t\treturn sink.WorkItems, true",
      "replace": "case \"work_items\":\n\t\treturn sink.StatusTransitions, true",
      "rationale": "the named work_items adapter must receive the work_items effect, not the transition adapter",
      "proof": [["go", "test", "-count=1", "-run", "^TestLinearWorkItemEffectsFenceLeaseTenantAndTampering$", "./internal/providersync/"]]
    },
    {
      "id": "L10-post-write-lease-fence-is-retained",
      "file": "internal/providersync/linear_work_items_effects.go",
      "find": "return sink.Lease.Assert(ctx)\n}",
      "replace": "return nil\n}",
      "rationale": "losing the lease after a destination write must leave the effect eligible for exact recovery rather than reporting success",
      "proof": [["go", "test", "-count=1", "-run", "^TestLinearWorkItemEffectsFenceLeaseTenantAndTampering$", "./internal/providersync/"]]
    },
    {
      "id": "L11-exact-readback-marks-landed-effect",
      "file": "internal/providersync/linear_work_items_effects.go",
      "find": "case EffectExact, EffectAbsent, EffectConflict:\n\t\treturn inspection, nil",
      "replace": "case EffectAbsent, EffectConflict:\n\t\treturn inspection, nil",
      "rationale": "a destination that landed before a crash must be marked committed from exact readback, not replayed",
      "proof": [["go", "test", "-count=1", "-run", "^TestLinearWorkItemEffectsRecoverAfterMidWrite$", "./internal/providersync/"]]
    },
    {
      "id": "L12-completed-timestamp-wins-canceled-timestamp",
      "file": "internal/providersync/linear_work_items_route.go",
      "find": "if item.ClosedAt == nil && payload.CanceledAt != nil {",
      "replace": "if payload.CanceledAt != nil {",
      "rationale": "Python's closed_at uses completed_at or canceled_at, so a completed timestamp must remain authoritative when both provider fields are present",
      "proof": [["go", "test", "-count=1", "-run", "^TestLinearWorkItemClosedAtPrefersCompletedAt$", "./internal/providersync/"]]
    },
    {
      "id": "L13-trusted-scm-host-fences-attachments",
      "file": "internal/providersync/linear_work_items_route.go",
      "find": "if _, ok := linearTrustedSCMHosts()[strings.ToLower(parsed.Host)]; !ok {",
      "replace": "if false {",
      "rationale": "a user-controlled Linear attachment must not mint a PR or MR edge from an untrusted host",
      "proof": [["go", "test", "-count=1", "-run", "^TestLinearWorkItemsRouteCollectsRawLinearSurfaces$", "./internal/providersync/"]]
    },
    {
      "id": "L14-relation-orientation-is-canonical",
      "file": "internal/providersync/linear_work_items_route.go",
      "find": "case \"blocked_by\", \"is_blocked_by\", \"blocked\":\n\t\t\t\tsource, target, relationType = target, source, \"blocks\"",
      "replace": "case \"blocked_by\", \"is_blocked_by\", \"blocked\":\n\t\t\t\tsource, target, relationType = source, target, \"blocks\"",
      "rationale": "native Linear relation direction must remain source blocker to target blocked issue in the canonical graph",
      "proof": [["go", "test", "-count=1", "-run", "^TestLinearWorkItemsRouteCollectsRawLinearSurfaces$", "./internal/providersync/"]]
    },
    {
      "id": "L15-empty-comments-are-not-interactions",
      "file": "internal/providersync/linear_work_items_route.go",
      "find": "if comment.Body == \"\" {",
      "replace": "if false {",
      "rationale": "empty comments do not represent an interaction and must not create a zero-length fact",
      "proof": [["go", "test", "-count=1", "-run", "^TestLinearWorkItemsRouteCollectsRawLinearSurfaces$", "./internal/providersync/"]]
    },
    {
      "id": "L16-interaction-length-is-codepoint-count",
      "file": "internal/providersync/linear_work_items_route.go",
      "find": "BodyLength: len([]rune(comment.Body)), LastSynced: normalizedAt.UTC(),",
      "replace": "BodyLength: len(comment.Body), LastSynced: normalizedAt.UTC(),",
      "rationale": "the Python interaction contract uses Unicode code-point length, not UTF-8 byte length",
      "proof": [["go", "test", "-count=1", "-run", "^TestLinearWorkItemsRouteCollectsRawLinearSurfaces$", "./internal/providersync/"]]
    },
    {
      "id": "L17-cycle-completion-wins-state",
      "file": "internal/providersync/linear_work_items_route.go",
      "find": "if cycle.CompletedAt != nil && parseLinearTimePtr(cycle.CompletedAt) != nil {",
      "replace": "if false {",
      "rationale": "a completed Linear cycle must be emitted as closed even if its progress is nonzero",
      "proof": [["go", "test", "-count=1", "-run", "^TestLinearWorkItemsRouteCollectsRawLinearSurfaces$", "./internal/providersync/"]]
    },
    {
      "id": "L18-all-raw-destinations-dispatch",
      "file": "internal/providersync/linear_work_items_effects.go",
      "find": "case \"sprints\":\n\t\treturn sink.Sprints, true",
      "replace": "case \"sprints\":\n\t\treturn sink.WorkItems, true",
      "rationale": "every declared raw destination must dispatch to its own named adapter rather than silently cross-writing another table",
      "proof": [["go", "test", "-count=1", "-run", "^TestLinearWorkItemEffectsDispatchEveryRawDestination$", "./internal/providersync/"]]
    }
  ]
}
