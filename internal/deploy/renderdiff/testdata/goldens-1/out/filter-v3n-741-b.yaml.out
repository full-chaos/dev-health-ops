    horizontalPodAutoscalerConfig:
      behavior:
        scaleDown:
          stabilizationWindowSeconds: 300
  cooldownPeriod: 300
  maxReplicaCount: 2
  minReplicaCount: 1
  pollingInterval: 30
  scaleTargetRef:
    name: dev-health-ops-go-sync
  triggers:
  - authenticationRef:
      name: dev-health-ops-go-worker-river-ro
    metadata:
      dbName: placeholder
      host: dev-health-ops-go-pgbouncer-transaction.dev-health.svc.cluster.local
      port: '6432'
      query: SELECT count(*) FROM river.river_job WHERE queue IN ('sync') AND state
        IN ('available', 'scheduled', 'retryable') AND (scheduled_at IS NULL OR scheduled_at
        <= now())
      sslmode: disable
      targetQueryValue: '5'
      userName: devhealth_keda_readonly
    type: postgresql
  - authenticationRef:
      name: dev-health-ops-go-worker-river-ro
    metadata:
      dbName: placeholder
      host: dev-health-ops-go-pgbouncer-transaction.dev-health.svc.cluster.local
      port: '6432'
      query: SELECT count(*) FROM public.sync_run_units WHERE status = 'planned' AND
        (available_at IS NULL OR available_at <= now())
      sslmode: disable
      targetQueryValue: '150'
      userName: devhealth_keda_readonly
    name: planned-units
    type: postgresql
