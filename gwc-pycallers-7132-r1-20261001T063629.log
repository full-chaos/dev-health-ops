func TestReviewDiscoveryDegradedPayloadRetainsBareCredentialEcho(t *testing.T) {
	secret := os.Getenv("CODEX_REVIEW_JIRA_TOKEN")
	if secret == "" { t.Fatal("CODEX_REVIEW_JIRA_TOKEN is required") }
	collector := &fakeTeamCatalogCollector{result: providersync.TeamCatalogResult{
		TeamsWritten: 1,
		DegradedLegs: []providersync.DegradedLeg{{Dataset: "teams", Leg: "jira_atlassian_teams", Outcome: "failed", Reason: "unclassified", Detail: secret}},
	}}
	executor := &TeamCatalogDiscoveryExecutor{
		Native: map[string]providersync.TeamCatalogCollector{"jira": collector},
		Clients: &fakeProviderClientResolver{credential: providerfoundation.Credential{Provider: "jira"}, integrationID: "integration-1"},
		Selections: &fakeTeamCatalogSelectionsResolver{selections: providersync.TeamCatalogSelections{Teams: true}},
	}
	summary, err := executor.Discover(context.Background(), testOrg, testRun, "jira")
	if err != nil { t.Fatalf("Discover: %v", err) }
	legs, ok := summary["degraded"].([]map[string]string)
	if !ok || len(legs) != 1 { t.Fatalf("degraded payload = %#v", summary["degraded"]) }
	hasSecret := strings.Contains(legs[0]["detail"], secret)
	fmt.Printf("REPRO discovery_ledger_payload detail_has_test_credential=%t outcome=%s leg=%s\n", hasSecret, summary["outcome"], legs[0]["leg"])
	if hasSecret { t.Errorf("discovery payload carries an unlabelled credential value after sanitizeErrorText") }
}

