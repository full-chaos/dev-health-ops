{
  "schema_version": 1,
  "name": "GitLab commits native route structural closure (CHAOS-3346)",
  "build": ["go", "test", "-run", "^$", "./internal/providersync/", "./cmd/dev-health-worker/"],
  "mutations": [
    {
      "id": "G1-claim-provider-guard",
      "file": "internal/providersync/gitlab_commits_route.go",
      "find": "claim.Provider != \"gitlab\" ||",
      "replace": "false ||",
      "rationale": "a GitLab commit handler must reject a claim owned by another provider before issuing any request or effect",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabCommitsRouteRejectsCrossScopeAndProjectMismatch$", "./internal/providersync/"]]
    },
    {
      "id": "G2-claim-dataset-guard",
      "file": "internal/providersync/gitlab_commits_route.go",
      "find": "claim.Dataset != \"commits\" || client == nil",
      "replace": "false || client == nil",
      "rationale": "the commits handler must not accept a different GitLab dataset merely because it shares project credentials",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabCommitsRouteRejectsCrossScopeAndProjectMismatch$", "./internal/providersync/"]]
    },
    {
      "id": "G3-client-provider-guard",
      "file": "internal/providersync/gitlab_commits_route.go",
      "find": "client.Provider != \"gitlab\" ||",
      "replace": "false ||",
      "rationale": "GitLab PRIVATE-TOKEN and URL semantics must come only from a GitLab-resolved canonical client",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabCommitsRouteRejectsCrossScopeAndProjectMismatch$", "./internal/providersync/"]]
    },
    {
      "id": "G4-claimed-project-binding",
      "file": "internal/providersync/gitlab_commits_route.go",
      "find": "strconv.FormatInt(parsedProjectID, 10) != projectID",
      "replace": "strconv.FormatInt(parsedProjectID, 10) == projectID && false",
      "rationale": "the fetched project must be the exact numeric project claimed by the leased unit",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabCommitsRouteRejectsCrossScopeAndProjectMismatch$", "./internal/providersync/"]]
    },
    {
      "id": "G5-pagination-cap-fails-closed",
      "file": "internal/providersync/gitlab_commits_route.go",
      "find": "if page.CapReached {",
      "replace": "if false {",
      "rationale": "a capped traversal is incomplete and must not emit an effect or advance the watermark",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabCommitsRouteFailsClosedOnCapMalformedAndPartialFetch$/cap$", "./internal/providersync/"]]
    },
    {
      "id": "G6-upper-window-clause",
      "file": "internal/providersync/gitlab_commits_route.go",
      "find": "committedWhen.After(claim.BeforeAt.UTC())",
      "replace": "false",
      "rationale": "the client-side upper-window check must mirror the Python producer and exclude future commits",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabCommitsRouteEmitsCompleteNullableEffectAcrossPages$", "./internal/providersync/"]]
    },
    {
      "id": "G7-lower-window-clause",
      "file": "internal/providersync/gitlab_commits_route.go",
      "find": "committedWhen.Before(claim.SinceAt.UTC())",
      "replace": "false",
      "rationale": "the descending commit traversal must stop at Python's lower-window boundary instead of persisting older commits",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabCommitsRouteEmitsCompleteNullableEffectAcrossPages$", "./internal/providersync/"]]
    },
    {
      "id": "G8-nullable-message-construction",
      "file": "internal/providersync/gitlab_commits_route.go",
      "find": "Hash: stringValue(payload.ID), Message: payload.Message,",
      "replace": "Hash: stringValue(payload.ID), Message: nil,",
      "rationale": "the Go row must preserve every non-null GitLab message while retaining null as null",
      "proof": [["go", "test", "-count=1", "-run", "^TestGenericOracleMatchesLivePythonForGitLabCommitsRowConstruction$", "./internal/providersync/"]]
    },
    {
      "id": "G9-null-empty-readback",
      "file": "internal/providersync/github_commits_effects_clickhouse.go",
      "find": "!stringPointersEqual(actual.Row.Message, expected.Message) ||",
      "replace": "false ||",
      "rationale": "recovery readback must distinguish a nullable message from an empty string",
      "proof": [["go", "test", "-count=1", "-run", "^TestCompareGitCommitVersionDistinguishesNullAndEmptyMessage$", "./internal/providersync/"]]
    },
    {
      "id": "G10-readback-tenant-predicate",
      "file": "internal/providersync/github_commits_effects_clickhouse.go",
      "find": "WHERE org_id = ? AND repo_id = ? AND hash = ?",
      "replace": "WHERE org_id != ? AND repo_id = ? AND hash = ?",
      "rationale": "recovery must inspect the claim tenant when identical repository and commit keys exist in another organization",
      "build": ["go", "test", "-tags", "integration", "-run", "^$", "./internal/providersync/"],
      "proof": [["go", "test", "-count=1", "-tags", "integration", "-run", "^TestGitLabCommitsReadbackSeparatesTenantsAndConvergesAfterRetry$", "./internal/providersync/"]]
    },
    {
      "id": "G11-accepted-python-budget",
      "file": "internal/providersync/request_plan.go",
      "find": "Units: max(2, 2*spanDays),",
      "replace": "Units: max(1, spanDays),",
      "rationale": "the Go request plan must port the accepted Python GitLab commits budget instead of inventing a lower allowance",
      "proof": [["go", "test", "-count=1", "-run", "^TestProviderRequestPlansMatchLivePythonBudgetFunctions$", "./internal/providersync/"]]
    },
    {
      "id": "G12-route-readiness",
      "file": "internal/providersync/execution_registry.go",
      "find": "case provider == \"gitlab\" && dataset == \"commits\":\n\t\tdescriptor.Destinations = []string{\"git_commits\"}\n\t\tdescriptor.RouteReady = true\n\t\tdescriptor.RouteEnabled = switches.GitlabCommits",
      "replace": "case provider == \"gitlab\" && dataset == \"commits\":\n\t\tdescriptor.Destinations = []string{\"git_commits\"}\n\t\tdescriptor.RouteReady = false\n\t\tdescriptor.RouteEnabled = switches.GitlabCommits",
      "rationale": "the completed pair must be visible through the canonical descriptor and checked-in matrix, not left as dead handler code",
      "proof": [["go", "test", "-count=1", "-run", "^TestProviderMatrixMatchesCheckedInContract$", "./internal/providersync/"]]
    },
    {
      "id": "G13-worker-activation-switch",
      "file": "cmd/dev-health-worker/provider_sync.go",
      "find": "cfg.WorkerGitlabCommitsEnabled ||",
      "replace": "false ||",
      "rationale": "enabling only GitLab commits must construct the provider-unit worker family rather than dispatching to no handler",
      "proof": [["go", "test", "-count=1", "-run", "^TestBuildProviderSyncWorkerConstructsForEveryRouteReadySwitch$/gitlab_commits$", "./cmd/dev-health-worker/"]]
    }
  ]
}
