{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fullchaos.dev/contracts/auth/v1/credential-classes.schema.json",
  "title": "Dev Health credential-class inventory",
  "description": "CHAOS-3273 Wave 0 freeze of every credential class observed across dev-health-ops, dev-health-web, and dev-health-acr, as of the anchors' commit. This is the closed vocabulary a later CI gate keys on: a class missing here is a class the gate cannot catch. Produced by lane auth-cp/L0; do not hand-edit without re-verifying anchors.",
  "type": "object",
  "required": ["schema_version", "generated_at", "source_commits", "classes"],
  "properties": {
    "schema_version": { "const": "credential-classes.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_commits": {
      "type": "object",
      "description": "The exact commit each repo was read at. Anchors are only valid against these commits.",
      "required": ["ops", "web", "acr"],
      "properties": {
        "ops": { "type": "string" },
        "web": { "type": "string" },
        "acr": { "type": "string" }
      },
      "additionalProperties": false
    },
    "classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/credentialClass" },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "anchor": {
      "description": "A repo-relative file:line citation, or null when the fact could not be anchored to source. null MUST be paired with an entry in the class's gaps array explaining why.",
      "oneOf": [
        {
          "type": "object",
          "required": ["repo", "path", "line"],
          "properties": {
            "repo": { "enum": ["ops", "web", "acr"] },
            "path": { "type": "string", "description": "Repo-relative path." },
            "line": { "type": "integer", "minimum": 1 },
            "line_end": { "type": "integer", "minimum": 1 },
            "note": { "type": "string" }
          },
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "anchorList": {
      "type": "array",
      "items": { "$ref": "#/$defs/anchor" }
    },
    "credentialClass": {
      "type": "object",
      "required": [
        "class_id",
        "display_name",
        "status",
        "transport",
        "issuer",
        "validators",
        "backing_store",
        "principal_type",
        "audience_and_scope",
        "lifecycle",
        "consumers",
        "bootstrap",
        "gaps"
      ],
      "properties": {
        "class_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Stable snake_case identifier. Never renamed once a CI gate references it."
        },
        "display_name": { "type": "string" },
        "status": {
          "enum": ["active", "unconsumed", "legacy_permissive", "optional_feature"],
          "description": "active = minted and validated on the paths inspected. unconsumed = minted/defined but no validator found in ops/web/acr for it. legacy_permissive = validator degrades to no-op when unconfigured (guardrail violation candidate). optional_feature = gated behind a license/feature flag or optional import."
        },
        "new_vs_ticket": {
          "type": "boolean",
          "description": "true if this class was not in CHAOS-3273's minimum list and was discovered during this inventory."
        },
        "transport": {
          "type": "object",
          "required": ["header_or_cookie", "shape"],
          "properties": {
            "header_or_cookie": { "type": "string", "description": "e.g. 'Authorization: Bearer', 'X-API-Key', 'X-ACR-Web-Assertion', cookie name." },
            "shape": { "type": "string", "description": "Token prefix / format, e.g. 'fcacr_<43 char urlsafe base64>' or 'HS256 JWT'." }
          }
        },
        "issuer": {
          "type": "object",
          "required": ["description", "anchors"],
          "properties": {
            "description": { "type": "string" },
            "anchors": { "$ref": "#/$defs/anchorList" }
          }
        },
        "validators": {
          "type": "array",
          "description": "EVERY validator that can observe this credential, including generic middleware that touches it before its intended validator (the CHAOS-3271 class). List order is not significance order.",
          "items": {
            "type": "object",
            "required": ["description", "anchor", "is_intended_validator"],
            "properties": {
              "description": { "type": "string" },
              "anchor": { "$ref": "#/$defs/anchor" },
              "is_intended_validator": { "type": "boolean" },
              "reachable_but_not_owner": {
                "type": "boolean",
                "description": "true marks a CHAOS-3271-class finding: this validator can see the credential but does not own its class."
              }
            }
          }
        },
        "backing_store": {
          "type": "object",
          "required": ["store", "secret_at_rest", "anchors"],
          "properties": {
            "store": { "type": "string", "description": "e.g. 'Postgres internal_service_credentials', 'JWT (stateless, no store)', 'env var', 'k8s Secret'." },
            "secret_at_rest": {
              "enum": ["hashed_sha256", "encrypted", "plaintext_env_var", "plaintext_file", "stateless_signed", "not_applicable", "unknown"]
            },
            "anchors": { "$ref": "#/$defs/anchorList" }
          }
        },
        "principal_type": {
          "enum": ["human", "service_account", "workload", "client_credential", "external_source", "infrastructure"]
        },
        "audience_and_scope": {
          "type": "object",
          "properties": {
            "audience": { "type": ["string", "null"] },
            "scopes_or_actions": { "type": "array", "items": { "type": "string" } },
            "tenant_binding": { "type": "string", "description": "How org/tenant scoping is carried, e.g. 'org_id JWT claim' or 'none (global)'." },
            "resource_binding": { "type": "string" },
            "anchors": { "$ref": "#/$defs/anchorList" }
          }
        },
        "lifecycle": {
          "type": "object",
          "required": ["owner", "rotation", "revocation", "audit_source"],
          "properties": {
            "owner": { "type": "string" },
            "rotation": { "type": "object", "properties": { "description": { "type": "string" }, "anchors": { "$ref": "#/$defs/anchorList" } } },
            "revocation": { "type": "object", "properties": { "description": { "type": "string" }, "anchors": { "$ref": "#/$defs/anchorList" } } },
            "audit_source": { "type": "object", "properties": { "description": { "type": "string" }, "anchors": { "$ref": "#/$defs/anchorList" } } }
          }
        },
        "consumers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "anchor": { "$ref": "#/$defs/anchor" }
            }
          }
        },
        "bootstrap": {
          "type": "object",
          "properties": {
            "production": { "type": "string" },
            "local_compose": { "type": "string" },
            "self_hosted": { "type": "string" },
            "anchors": { "$ref": "#/$defs/anchorList" }
          }
        },
        "permissive_when_unconfigured": {
          "type": "boolean",
          "description": "true if a missing/unset config value silently disables auth instead of fail-closed. Guardrail: this must never be true in production."
        },
        "gaps": {
          "type": "array",
          "description": "Every field that could not be anchored, with the search performed. Empty array means fully anchored.",
          "items": { "type": "string" }
        }
      }
    }
  }
}
