            "type": "string"
          },
          "maxItems": 25,
          "title": "Evidence Ref Ids",
          "type": "array"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required"
        },
        "skipped_required_work": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skipped Required Work"
        }
      },
      "required": [
        "entity_id",
        "display_label",
        "conclusion",
        "observed_at"
      ],
      "title": "DevCIFact",
      "type": "object"
