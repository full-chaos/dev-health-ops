{
  "schema_version": 1,
  "name": "GitLab PR/MR family provider parity (CHAOS-3124)",
  "build": ["go", "test", "-run", "^$", "./internal/providersync/"],
  "$limitation": "Provider-local parity only: typed MR/review normalization, pagewise enrichment, failure and watermark behavior, tenant/lease-bound sinks, migrated ClickHouse readback, and live Python producer agreement. This slice deliberately excludes registry, matrix, config, scheduler, worker construction, deployment, and cutover wiring.",
  "mutations": [
    {
      "id": "GPR-claim-provider-guard",
      "file": "internal/providersync/gitlab_prs_route.go",
      "find": "claim.Provider != \"gitlab\" ||",
      "replace": "false ||",
      "rationale": "the GitLab MR collector must reject a claim owned by another provider before any source request",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabPullRequestRouteRejectsInvalidConfigurationBeforeRequest/wrong_claim_provider$", "./internal/providersync/"]]
    },
    {
      "id": "GPR-claim-dataset-guard",
      "file": "internal/providersync/gitlab_prs_route.go",
      "find": "!isPRSocialDataset(claim.Dataset) || client == nil ||",
      "replace": "false || client == nil ||",
      "rationale": "prs, pr-reviews, and pr-comments are the only aliases allowed to share this complete producer",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabPullRequestRouteRejectsInvalidConfigurationBeforeRequest/wrong_claim_dataset$", "./internal/providersync/"]]
    },
    {
      "id": "GPR-client-provider-guard",
      "file": "internal/providersync/gitlab_prs_route.go",
      "find": "client.Provider != \"gitlab\" ||",
      "replace": "false ||",
      "rationale": "the resolved HTTP client must carry GitLab request semantics, not merely a GitLab claim",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabPullRequestRouteRejectsInvalidConfigurationBeforeRequest/wrong_client_provider$", "./internal/providersync/"]]
    },
    {
      "id": "GPR-normalized-at-guard",
      "file": "internal/providersync/gitlab_prs_route.go",
      "find": "client.Provider != \"gitlab\" || client.BaseURL == nil || normalizedAt.IsZero() {",
      "replace": "client.Provider != \"gitlab\" || client.BaseURL == nil || false {",
      "rationale": "retry-stable LastSynced values require the executor-supplied normalization instant",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabPullRequestRouteRejectsInvalidConfigurationBeforeRequest/zero_normalized_at$", "./internal/providersync/"]]
    },
    {
      "id": "GPR-page-limit-guard",
      "file": "internal/providersync/gitlab_prs_route.go",
      "find": "if perPage < 1 || perPage > gitLabPullRequestDefaultPerPage || maxPages < 1 || maxPages > gitLabPullRequestDefaultMaxPages {",
      "replace": "if false {",
      "rationale": "invalid page limits must fail closed before a provider request rather than becoming an unbounded traversal",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabPullRequestRouteRejectsInvalidConfigurationBeforeRequest/negative_per_page$", "./internal/providersync/"]]
    },
    {
      "id": "GPR-project-identity-binding",
      "file": "internal/providersync/gitlab_prs_route.go",
      "find": "strconv.FormatInt(parsedProjectID, 10) != projectID",
      "replace": "false",
      "rationale": "the project response must prove the exact numeric project claimed by the unit before merge-request traversal",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabPullRequestRouteRejectsProjectIDMismatchBeforeListRequests$", "./internal/providersync/"]]
    },
    {
      "id": "GPR-since-stop",
      "file": "internal/providersync/gitlab_prs_route.go",
      "find": "return updatedAt != nil && updatedAt.Before(claim.SinceAt.UTC())",
      "replace": "return updatedAt != nil && !updatedAt.Before(claim.SinceAt.UTC())",
      "rationale": "the newest-updated-first list must stop at the since boundary and never fetch an older MR or advance past it",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabPullRequestRouteMirrorsPythonFamilyAndEarlyStop$", "./internal/providersync/"]]
    },
    {
      "id": "GPR-notes-incomplete-fails-closed",
      "file": "internal/providersync/gitlab_prs_route.go",
      "find": "return result, ErrGitLabPullRequestReviewsIncomplete",
      "replace": "return result, nil",
      "rationale": "authoritative notes failure must preserve existing metrics by refusing a durable batch and watermark",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabPullRequestRouteFailsClosedWhenNotesAreIncomplete$", "./internal/providersync/"]]
    },
    {
      "id": "GPR-author-self-review-exclusion",
      "file": "internal/providersync/gitlab_pr_reviews.go",
      "find": "if author != \"\" && strings.ToLower(strings.TrimSpace(username)) == author {\n\t\t\tcontinue\n\t\t}",
      "replace": "if author == \"\" && strings.ToLower(strings.TrimSpace(username)) == author {\n\t\t\tcontinue\n\t\t}",
      "rationale": "the MR author’s own DiffNote is ordinary chatter and must not inflate review rows or first-review time",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabPullRequestRouteMirrorsPythonFamilyAndEarlyStop$", "./internal/providersync/"]]
    },
    {
      "id": "GPR-normalized-at-milliseconds",
      "file": "internal/providersync/gitlab_prs_route.go",
      "find": "normalizedAt = normalizedAt.UTC().Truncate(time.Millisecond)\n\trequests := 0",
      "replace": "normalizedAt = normalizedAt.UTC()\n\trequests := 0",
      "rationale": "DateTime64(3) persistence and retry readback require millisecond-normalized timestamps",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabPullRequestRouteMirrorsPythonFamilyAndEarlyStop$", "./internal/providersync/"]]
    },
    {
      "id": "GPR-physical-request-accounting",
      "file": "internal/providersync/gitlab_prs_route.go",
      "find": "attempts := *doer.attempts + 1",
      "replace": "attempts := *doer.attempts",
      "rationale": "accepted evidence must count every physical project/list/approval/notes request",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabPullRequestRouteMirrorsPythonFamilyAndEarlyStop$", "./internal/providersync/"]]
    },
    {
      "id": "GPR-sink-provider-fence",
      "file": "internal/providersync/github_pr_reviews_effects_clickhouse.go",
      "find": "claim.Provider != sink.provider() || !isPRSocialDataset(claim.Dataset)",
      "replace": "false || !isPRSocialDataset(claim.Dataset)",
      "rationale": "the provider-bound social sink must reject a foreign provider ledger claim before empty or non-empty effects",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabPullRequestSocialEffectsAcceptEveryAliasAndTenantFence$", "./internal/providersync/"]]
    },
    {
      "id": "GPR-sink-dataset-fence",
      "file": "internal/providersync/github_pr_reviews_effects_clickhouse.go",
      "find": "!isPRSocialDataset(claim.Dataset)",
      "replace": "false",
      "expect_occurrences": 2,
      "rationale": "the shared sink must accept only the three GitLab PR-social aliases and never an unrelated dataset",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabPullRequestSocialEffectsAcceptEveryAliasAndTenantFence$", "./internal/providersync/"]]
    }
  ]
}
