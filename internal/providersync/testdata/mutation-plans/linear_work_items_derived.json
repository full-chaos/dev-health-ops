{
  "schema_version": 1,
  "name": "linear derived work-item effects, parity, tenancy, and recovery",
  "build": [
    "go",
    "test",
    "-tags",
    "integration",
    "-run",
    "^$",
    "./internal/providersync/"
  ],
  "mutations": [
    {
      "id": "LD1-all-ten-derived-destinations-are-declared",
      "file": "internal/providersync/linear_work_items_derived.go",
      "find": "var linearWorkItemDerivedEffectDestinations = []string{\n\t\"ai_attribution\",",
      "replace": "var linearWorkItemDerivedEffectDestinations = []string{\n\t\"ai_attribution_omitted\",",
      "rationale": "The recovery manifest must enumerate all ten derived destinations, including explicit Linear issue-label AI attribution; a missing key makes a complete Linear computation appear partial.",
      "proof": [
        [
          "go",
          "test",
          "-count=1",
          "-run",
          "^TestLinearWorkItemDeriverUsesLinearRowsAndEvaluatesAllTenDestinations$",
          "./internal/providersync/"
        ]
      ]
    },
    {
      "id": "LD2-derived-effects-require-readback",
      "file": "internal/providersync/linear_work_items_derived.go",
      "find": "\t\t\tdestination, EffectReadbackRequired, rows[destination],",
      "replace": "\t\t\tdestination, EffectReplaySafe, rows[destination],",
      "rationale": "Every derived destination can be durably written before acknowledgement, so the effect ledger must recover it by semantic readback rather than assuming replay safety.",
      "proof": [
        [
          "go",
          "test",
          "-count=1",
          "-run",
          "^TestBuildLinearWorkItemDerivedEffectsKeepsAllTenDestinations$|^TestLinearDerivedSinkRejectsReplaySafeRecoveryPolicy$",
          "./internal/providersync/"
        ]
      ]
    },
    {
      "id": "LD3-deriver-rejects-non-linear-claim",
      "file": "internal/providersync/linear_work_items_derived.go",
      "find": "\tif ctx == nil || deriver.Source == nil || claim.Validate() != nil ||\n\t\tclaim.Provider != \"linear\" || claim.Dataset != \"work-items\" ||",
      "replace": "\tif ctx == nil || deriver.Source == nil || claim.Validate() != nil ||\n\t\tfalse || claim.Dataset != \"work-items\" ||",
      "rationale": "The Linear derivation seam must not compute a GitHub or other provider claim under Linear's namespace, even when the dataset name is shared.",
      "proof": [
        [
          "go",
          "test",
          "-count=1",
          "-run",
          "^TestLinearWorkItemDeriverRejectsWrongProviderClaim$",
          "./internal/providersync/"
        ]
      ]
    },
    {
      "id": "LD4-malformed-repository-id-fails-closed",
      "file": "internal/providersync/linear_work_items_derived.go",
      "find": "\t\t\t\treturn githubWorkItemRows{}, ErrInvalidConfiguration",
      "replace": "\t\t\t\treturn result, nil",
      "rationale": "A non-empty malformed Linear repository id cannot be silently converted to a nil id, because that changes its attribution grouping and can merge it into a different bucket.",
      "proof": [
        [
          "go",
          "test",
          "-count=1",
          "-run",
          "^TestLinearWorkItemDeriverRejectsMalformedRepositoryID$",
          "./internal/providersync/"
        ]
      ]
    },
    {
      "id": "LD5-derived-row-provider-fence-is-enforced",
      "file": "internal/providersync/linear_work_items_derived.go",
      "find": "\t\t\tif err := json.Unmarshal(providerRaw, &provider); err != nil || provider != \"linear\" {",
      "replace": "\t\t\tif err := json.Unmarshal(providerRaw, &provider); err != nil || false {",
      "rationale": "A derived row from another provider must not be written through a Linear effect identity; the provider field is part of the persisted semantic namespace.",
      "proof": [
        [
          "go",
          "test",
          "-count=1",
          "-run",
          "^TestLinearDerivedAdapterRejectsProviderAndTenantCrossingRows$",
          "./internal/providersync/"
        ]
      ]
    },
    {
      "id": "LD6-derived-row-tenant-fence-is-enforced",
      "file": "internal/providersync/linear_work_items_derived.go",
      "find": "\t\tif err := json.Unmarshal(orgRaw, &orgID); err != nil || orgID != identity.OrgID {",
      "replace": "\t\tif err := json.Unmarshal(orgRaw, &orgID); err != nil || false {",
      "rationale": "A row carrying another tenant's org_id must not be authorized by a Linear effect identity, even if its natural key is valid.",
      "proof": [
        [
          "go",
          "test",
          "-count=1",
          "-run",
          "^TestLinearDerivedAdapterRejectsProviderAndTenantCrossingRows$",
          "./internal/providersync/"
        ]
      ]
    },
    {
      "id": "LD7-ai-source-provenance-is-enforced",
      "file": "internal/providersync/linear_work_items_derived.go",
      "find": "\t\t\t\trow.Kind == \"\" || row.Source != \"issue_label\" || row.Confidence != 0.95 ||",
      "replace": "\t\t\t\trow.Kind == \"\" || false || row.Confidence != 0.95 ||",
      "rationale": "A Linear issue-label effect must carry truthful issue_label provenance; accepting another source would authorize a semantically false attribution row under the Linear claim.",
      "proof": [
        [
          "go",
          "test",
          "-count=1",
          "-run",
          "^TestLinearDerivedAdapterRejectsCrossProviderAIEffect$|^TestLinearAIAttributionMatchesLivePythonProductionRow$",
          "./internal/providersync/"
        ]
      ]
    },
    {
      "id": "LD14-ai-producer-reaches-derived-effect",
      "file": "internal/providersync/linear_work_items_derived.go",
      "find": "\tderived := map[string][]json.RawMessage{\"ai_attribution\": aiRows}",
      "replace": "\tderived := map[string][]json.RawMessage{\"ai_attribution\": aiRows[:0]}",
      "rationale": "An explicit Linear AI issue label must reach the durable derived effect; evaluating the destination as empty would preserve the old false-complete behavior.",
      "proof": [
        [
          "go",
          "test",
          "-count=1",
          "-run",
          "^TestLinearWorkItemDeriverUsesLinearRowsAndEvaluatesAllTenDestinations$",
          "./internal/providersync/"
        ]
      ]
    },
    {
      "id": "LD15-non-ai-labels-do-not-become-attribution",
      "file": "internal/providersync/linear_work_items_derived.go",
      "find": "\t\t\tif !matched {\n\t\t\t\tcontinue\n\t\t\t}",
      "replace": "\t\t\tif !matched {\n\t\t\t\tkind = \"ai_assisted\"\n\t\t\t}",
      "rationale": "Only labels in the fixed canonical AI registry may create attribution; ordinary issue labels and issue text must remain non-signals.",
      "proof": [
        [
          "go",
          "test",
          "-count=1",
          "-run",
          "^TestLinearAIAttributionDoesNotInferFromIssueText$",
          "./internal/providersync/"
        ]
      ]
    },
    {
      "id": "LD16-issue-label-source-is-ranked-by-the-live-view",
      "file": "src/dev_health_ops/migrations/clickhouse/076_ai_attribution_issue_label.sql",
      "find": "            source = 'issue_label',     2,",
      "replace": "            source = 'issue_label',     9,",
      "rationale": "The authoritative resolved view must recognize issue_label with explicit-label precedence rather than falling through as an unknown source.",
      "proof": [
        [
          "pytest",
          "-q",
          "tests/test_migration_076_ai_issue_label.py"
        ]
      ]
    },
    {
      "id": "LD8-incomplete-derived-sink-fails-before-dispatch",
      "file": "internal/providersync/linear_work_items_derived.go",
      "find": "\tif err != nil || !sink.complete() {",
      "replace": "\tif err != nil || false {",
      "rationale": "All ten adapters must exist before any derived destination is accepted; otherwise an evaluated empty destination can report success while another destination is unwired.",
      "proof": [
        [
          "go",
          "test",
          "-count=1",
          "-run",
          "^TestLinearDerivedSinkRejectsIncompleteBeforeDispatch$",
          "./internal/providersync/"
        ]
      ]
    },
    {
      "id": "LD9-derived-identity-requires-readback-policy",
      "file": "internal/providersync/linear_work_items_derived.go",
      "find": "\t\t!linearWorkItemDerivedDestination(effect.Destination) || effect.Recovery != EffectReadbackRequired ||",
      "replace": "\t\t!linearWorkItemDerivedDestination(effect.Destination) || effect.Recovery != EffectReplaySafe ||",
      "rationale": "The identity constructor must reject a replay-safe manifest for these durable derived destinations; otherwise recovery can skip a required semantic check.",
      "proof": [
        [
          "go",
          "test",
          "-count=1",
          "-run",
          "^TestLinearDerivedSinkRejectsReplaySafeRecoveryPolicy$",
          "./internal/providersync/"
        ]
      ]
    },
    {
      "id": "LD10-post-write-lease-fence-is-retained",
      "file": "internal/providersync/linear_work_items_derived.go",
      "find": "\treturn sink.Lease.Assert(ctx)\n}\n\nfunc (sink LinearWorkItemDerivedClickHouseEffects) InspectEffect(",
      "replace": "\treturn nil\n}\n\nfunc (sink LinearWorkItemDerivedClickHouseEffects) InspectEffect(",
      "rationale": "A lease loss after the real ClickHouse write must return an error so the effect remains recoverable by readback; reporting success would skip the recovery ledger path.",
      "proof": [
        [
          "go",
          "test",
          "-tags",
          "integration",
          "-count=1",
          "-run",
          "^TestLinearDerivedClickHouseEffectsRecoverAfterLeaseLoss$",
          "./internal/providersync/"
        ]
      ]
    },
    {
      "id": "LD11-coverage-window-remains-half-open",
      "file": "internal/providersync/github_work_item_derived_surfaces.go",
      "find": "\t\tif !createdAt.Before(end) {",
      "replace": "\t\tif createdAt.Before(end) && false {",
      "rationale": "The shared coverage builder must exclude an item created exactly at the UTC window end; Linear uses the same day and grouping semantics as the provider-neutral builder.",
      "proof": [
        [
          "env",
          "DEV_HEALTH_LIVE_PYTHON_ORACLES=1",
          "DEV_HEALTH_LIVE_PYTHON_ORACLE_PROOF_DIR=/tmp/linear-derived-proofs",
          "PYTHONPATH=../../src",
          "GOCACHE=/tmp/linear-derived-go-cache",
          "GOTOOLCHAIN=go1.25.9",
          "go",
          "test",
          "-count=1",
          "-run",
          "^TestLinearWorkItemDerivedSurfacesMatchLivePythonProduction$",
          "./internal/providersync/"
        ]
      ]
    },
    {
      "id": "LD12-coverage-team-name-first-writer-wins",
      "file": "internal/providersync/github_work_item_derived_surfaces.go",
      "find": "\t\t\t\tteamName: normalizeGitHubWorkItemDerivedTeamName(teamName),",
      "replace": "\t\t\t\tteamName: normalizeGitHubWorkItemDerivedTeamName(teamName) + \"-mutated\",",
      "rationale": "Coverage grouping preserves the first contributing team's name; changing the field at bucket creation changes the persisted grouping row even when the team id is unchanged.",
      "proof": [
        [
          "env",
          "DEV_HEALTH_LIVE_PYTHON_ORACLES=1",
          "DEV_HEALTH_LIVE_PYTHON_ORACLE_PROOF_DIR=/tmp/linear-derived-proofs",
          "PYTHONPATH=../../src",
          "GOCACHE=/tmp/linear-derived-go-cache",
          "GOTOOLCHAIN=go1.25.9",
          "go",
          "test",
          "-count=1",
          "-run",
          "^TestLinearWorkItemDerivedSurfacesMatchLivePythonProduction$",
          "./internal/providersync/"
        ]
      ]
    },
    {
      "id": "LD13-metric-window-end-remains-exclusive",
      "file": "internal/providersync/github_work_item_metric_triplet.go",
      "find": "\treturn value != nil && !value.Before(start) && value.Before(end)",
      "replace": "\treturn value != nil && !value.Before(start) && !value.After(end)",
      "rationale": "The shared metric triplet uses a UTC half-open window; including the next midnight double-counts a Linear item at the boundary.",
      "proof": [
        [
          "env",
          "DEV_HEALTH_LIVE_PYTHON_ORACLES=1",
          "DEV_HEALTH_LIVE_PYTHON_ORACLE_PROOF_DIR=/tmp/linear-derived-proofs",
          "PYTHONPATH=../../src",
          "GOCACHE=/tmp/linear-derived-go-cache",
          "GOTOOLCHAIN=go1.25.9",
          "go",
          "test",
          "-count=1",
          "-run",
          "^TestBuildGitHubWorkItemMetricTripletWindowIsUTCAndHalfOpen$|^TestLinearWorkItemMetricTripletMatchesLivePythonProduction$",
          "./internal/providersync/"
        ]
      ]
    }
  ]
}
