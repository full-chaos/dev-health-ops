type reviewNonNilConn struct{ driver.Conn }

type reviewJiraClientResolver struct{}

func (reviewJiraClientResolver) ResolveClient(context.Context, string, string, string) (providerfoundation.Credential, *providerfoundation.HTTPClient, string, error) {
	return providerfoundation.Credential{Provider: "jira"}, &providerfoundation.HTTPClient{}, "integration-1", nil
}

func TestReviewGraphQLErrorEchoReachesWarnAndDegradedDetail(t *testing.T) {
	secret := os.Getenv("CODEX_REVIEW_JIRA_TOKEN")
	if secret == "" {
		t.Fatal("CODEX_REVIEW_JIRA_TOKEN is required")
	}
	var logs strings.Builder
	previous := slog.Default()
	slog.SetDefault(slog.New(slog.NewTextHandler(&logs, &slog.HandlerOptions{Level: slog.LevelInfo})))
	t.Cleanup(func() { slog.SetDefault(previous) })
	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		body, _ := json.Marshal(map[string]any{"errors": []any{map[string]string{"message": secret}}})
		w.Header().Set("Content-Type", "application/json")
		_, _ = w.Write(body)
	}))
	defer server.Close()
	baseURL, err := url.Parse(server.URL)
	if err != nil { t.Fatal(err) }
	credential := providerfoundation.NewCredential("jira", "cred-1", map[string]string{
		"base_url": server.URL, "atlassian_cloud_id": "cloud-id", "atlassian_organization_id": "org-id",
	}, map[string]secrets.Value{"email": secrets.NewValue("sync@example.test"), "api_token": secrets.NewValue(secret)})
	collector := jiraCombinedTeamCatalogCollector{
		ProjectAsTeam: &fakeProjectAsTeamCollector{result: providersync.TeamCatalogResult{TeamsWritten: 1}},
		Conn: reviewNonNilConn{},
		NewClient: func(gatewayURL string, auth atlassian.AuthProvider) atlassianteams.Client {
			return &graph.Client{BaseURL: gatewayURL, Auth: auth, HTTPClient: server.Client(), Strict: true, MaxRetries429: -1}
		},
	}
	result, err := collector.CollectTeamCatalog(context.Background(), providersync.TeamCatalogReference{
		OrgID: testOrg, SyncRunID: testRun, Strict: true,
	}, credential, &providerfoundation.HTTPClient{BaseURL: baseURL}, providersync.TeamCatalogSelections{Teams: true}, time.Now())
	if err != nil { t.Fatalf("an additive gateway failure should degrade: %v", err) }
	warningHasToken := strings.Contains(logs.String(), secret)
	detailHasToken := len(result.DegradedLegs) == 1 && strings.Contains(result.DegradedLegs[0].Detail, secret)
	fmt.Printf("REPRO graphql_error_token warning_has_token=%t degraded_detail_has_token=%t reason=%q\n", warningHasToken, detailHasToken, result.DegradedLegs[0].Reason)
	if warningHasToken || detailHasToken { t.Errorf("external GraphQL error echoed the Jira credential into a warning or degraded detail") }
}

func TestReviewPostSyncDegradedLegLeavesRunResultClean(t *testing.T) {
	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
	defer cancel()
	instance, err := containers.StartPostgres(ctx)
	if err != nil { t.Fatal(err) }
	defer instance.Close(context.Background())
	pool, err := pgxpool.New(ctx, instance.URI)
	if err != nil { t.Fatal(err) }
	defer pool.Close()
	const runID = "review-postsync-run"
	if _, err := pool.Exec(ctx, `CREATE TABLE sync_runs(id text PRIMARY KEY, status text NOT NULL, result jsonb NOT NULL)`); err != nil { t.Fatal(err) }
	if _, err := pool.Exec(ctx, `INSERT INTO sync_runs VALUES($1, 'success', '{"completed_units":14,"failed_units":0}')`, runID); err != nil { t.Fatal(err) }
	collector := &linearCollectorSpy{result: providersync.TeamCatalogResult{
		TeamsWritten: 1,
		DegradedLegs: []providersync.DegradedLeg{{Dataset: "teams", Leg: "jira_atlassian_teams", Outcome: "failed", Reason: "unclassified", Detail: "Invalid Organization Ari"}},
	}}
	observer := &fakeTeamCatalogObserver{}
	dispatcher := &nativeTeamAutoimportDispatcher{
		resolveProvider: func(context.Context, string, string) (string, error) { return "jira", nil },
		native: map[string]providersync.TeamCatalogCollector{"jira": collector},
		clients: reviewJiraClientResolver{},
		selections: fakeAutoimportSelectionsResolver{selections: providersync.TeamCatalogSelections{Teams: true}},
		observer: observer,
	}
	if err := dispatcher.TeamAutoImport(ctx, syncdispatchruntime.DomainReference{OrganizationID: testOrg, SyncRunID: runID}); err != nil { t.Fatalf("TeamAutoImport: %v", err) }
	var status string
	var result []byte
	if err := pool.QueryRow(ctx, `SELECT status, result::text FROM sync_runs WHERE id=$1`, runID).Scan(&status, &result); err != nil { t.Fatal(err) }
	outcome := "none"
	if len(observer.dispatches) > 0 { outcome = string(observer.dispatches[0].outcome) }
	fmt.Printf("REPRO post_sync_degraded status=%s result=%s dispatch_outcome=%s\n", status, result, outcome)
	if status != "partial_failed" && !strings.Contains(string(result), `"degraded"`) { t.Errorf("post-sync degraded leg left a clean run result") }
	if outcome != string(jobruntime.TeamCatalogOutcomeNativeFailedNonfatal) { t.Errorf("dispatch outcome=%s", outcome) }
}
