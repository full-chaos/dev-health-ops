TRUST_FAIL = {"fail-tls-untrusted"}

class Server(threading.Thread):
    def __init__(self, routes, h2=False):
        super().__init__(daemon=True)
        self.routes, self.log = routes, []
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.load_cert_chain(work + "/c.pem", work + "/k.pem")
        if h2: ctx.set_alpn_protocols(["h2"])
        self.sock = socket.socket(); self.sock.bind(("127.0.0.1", 0)); self.sock.listen(32)
        self.port = self.sock.getsockname()[1]
        self.ctx = ctx
        self.start()
    def run(self):
        while True:
            try:
                conn, _ = self.sock.accept()
            except OSError:
                return
            threading.Thread(target=self.handle, args=(conn,), daemon=True).start()
    def handle(self, conn):
        try:
            conn.settimeout(30)
            tls = self.ctx.wrap_socket(conn, server_side=True)
            data = b""
            while b"\r\n\r\n" not in data:
                chunk = tls.recv(4096)
                if not chunk:
                    return
                data += chunk
            lines = data.decode("latin-1").split("\r\n")
            method, path, _ = lines[0].split(" ")
            ua = ""
            for l in lines[1:]:
                if l.lower().startswith("user-agent:"):
                    ua = l.split(":", 1)[1].strip()
            self.log.append(f"{method} {path} {ua}")
            resp = self.routes.get(path, self.routes["*"])
            if resp == b"HANG":
                time.sleep(25); return
            if resp == b"RESET":
                tls.sendall(b"HTTP/1.1 200 OK\r\nX-A: b"); tls.close(); return
            tls.sendall(resp.replace(b"{ORIGIN}", f"https://127.0.0.1:{self.port}".encode()).replace(b"{HOSTPORT}", f"127.0.0.1:{self.port}".encode()))
            tls.close()
        except Exception:
            pass

shutil.rmtree(outdir, ignore_errors=True)
for name, c in cases.items():
    srv = Server({k: v for k, v in c["routes"].items()}, name in ALPN_H2)
    wd = tempfile.mkdtemp(dir=work)
    tsvb = c["tsv"] if isinstance(c["tsv"], bytes) else c["tsv"].encode("utf-8")
    open(wd + "/redirects.tsv", "wb").write(tsvb)
    hostport = f"127.0.0.1:{srv.port}"
    if c["args"] is None:
        argline = "--origin {ORIGIN} --redirects redirects.tsv"
    else:
        argline = c["args"]
    import shlex
    argv = shlex.split(argline.replace("{ORIGIN}", f"https://{hostport}").replace("{HOSTPORT}", hostport))
    env = {"PATH": os.environ["PATH"]}
    if name not in TRUST_FAIL:
        env["SSL_CERT_FILE"] = work + "/c.pem"
    p = subprocess.run([sys.executable, "-I", script] + argv, cwd=wd, env=env, capture_output=True, timeout=120)
    srv.sock.close()
    d = os.path.join(outdir, name); os.makedirs(d)
    sub = lambda s: s.replace(f"https://{hostport}", "{ORIGIN}").replace(hostport, "{HOSTPORT}")
    def jroutes(r):
        return {k: (v.decode("latin-1") if v not in (b"HANG", b"RESET") else v.decode()) for k, v in r.items()}
    json.dump(jroutes(c["routes"]), open(d + "/routes.json", "w"), indent=1, sort_keys=True)
    open(d + "/redirects.tsv", "wb").write(tsvb)
    if c["args"] is not None:
        open(d + "/args", "w").write(argline + "\n")
    open(d + "/stdout", "w").write(sub(p.stdout.decode()))
    open(d + "/stderr", "w").write(sub(p.stderr.decode()))
    if name in TRUST_FAIL: open(d + "/untrusted", "w").write("system roots only, no SSL_CERT_FILE\n")
    if name in ALPN_H2: open(d + "/alpn-h2", "w").write("server offers only h2 in ALPN\n")
    if name in HANGS: open(d + "/hang", "w").write("server never answers /use/; replayed in-process with a short timeout\n")
    open(d + "/rc", "w").write(f"{p.returncode}\n")
    open(d + "/requests", "w").write("".join(sub(l) + "\n" for l in srv.log))
    print(name, p.returncode, repr(sub(p.stdout.decode()))[:100], repr(sub(p.stderr.decode()))[-90:])
