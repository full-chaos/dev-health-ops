#!/usr/bin/env python3
"""Records the Python side of the host-smoke parity cases (CHAOS-10434). Usage: record_host_smoke.py SCRIPT OUTDIR.
SCRIPT is scripts/check_docs_cloudflare_host.py at the merge base. Needs python 3.14 and openssl. Each case under
OUTDIR/<name>/: routes.json (path -> raw response; "*" = default), redirects.tsv, args (optional, {ORIGIN}), stdout,
stderr, rc, requests (method path user-agent per request, in order)."""
import json, os, shutil, socket, ssl, subprocess, sys, tempfile, threading, time

script, outdir = sys.argv[1], sys.argv[2]
work = tempfile.mkdtemp()
subprocess.run(["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-keyout", work + "/k.pem", "-out", work + "/c.pem",
                "-days", "2", "-subj", "/CN=127.0.0.1", "-addext", "subjectAltName=IP:127.0.0.1,DNS:localhost"], check=True,
               capture_output=True)

def raw(status, headers=None, body=b"", reason="X"):
    if isinstance(body, str):
        body = body.encode()
    h = {"Content-Length": str(len(body)), "Connection": "close"}
    h.update(headers or {})
    head = f"HTTP/1.1 {status} {reason}\r\n" + "".join(f"{k}: {v}\r\n" for k, v in h.items()) + "\r\n"
    return head.encode("latin-1") + body

GOOD_HEADERS = {"X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin"}
def good_routes():
    page = raw(200, GOOD_HEADERS, "<title>Dev Health</title>")
    return {
        "/": page, "/use/": raw(200, {}, "use"), "/reference/metrics/weighting-and-aggregation/": raw(200, {}, "m"),
        "/phase-11-intentional-missing-page/": raw(404, {}, "nope"),
        "/old/": raw(301, {"Location": "/new/"}),
        "*": raw(404, {}, "x"),
    }
TSV = "source_path\ttarget_path\tdisposition\tmigration_phase\tsource_file\n/old/\t/new/\tmove\tPhase 1\tdocs/old.md\n"
cases = {}
def case(name, routes=None, tsv=TSV, args=None, **patch):
    r = good_routes()
    r.update(routes or {})
    cases[name] = dict(routes=r, tsv=tsv, args=args)

def home(status=200, headers=GOOD_HEADERS, body="<title>Dev Health</title>"):
    return raw(status, headers, body)

case("ok")
case("ok-308", {"/old/": raw(308, {"Location": "/new/"})})
case("ok-location-absolute", {"/old/": raw(301, {"Location": "{ORIGIN}/new/"})})
