apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  labels:
    app.kubernetes.io/component: auth-migrate
    app.kubernetes.io/instance: dev-health
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/name: ops
    app.kubernetes.io/part-of: dev-health
    app.kubernetes.io/version: 0.1.0
    helm.sh/chart: ops-0.1.0
  name: dev-health-ops-auth-migrate
  namespace: dev-health
spec:
  egress:
  - ports:
    - port: 53
      protocol: UDP
    - port: 53
      protocol: TCP
    to:
    - namespaceSelector: {}
  - ports:
    - port: 5432
      protocol: TCP
    to:
    - podSelector:
        matchLabels:
          app.kubernetes.io/component: postgresql
          app.kubernetes.io/instance: dev-health
          app.kubernetes.io/name: ops
  ingress: []
  podSelector:
    matchLabels:
      app.kubernetes.io/component: auth-migrate
      app.kubernetes.io/instance: dev-health
      app.kubernetes.io/name: ops
  policyTypes:
  - Ingress
  - Egress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  labels:
    app.kubernetes.io/component: auth-service
    app.kubernetes.io/instance: dev-health
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/name: ops
    app.kubernetes.io/part-of: dev-health
    app.kubernetes.io/version: 0.1.0
    helm.sh/chart: ops-0.1.0
  name: dev-health-ops-auth-service
  namespace: dev-health
spec:
  egress:
  - ports:
    - port: 53
      protocol: UDP
    - port: 53
      protocol: TCP
    to:
    - namespaceSelector: {}
  - ports:
    - port: 5432
      protocol: TCP
    to:
    - podSelector:
        matchLabels:
          app.kubernetes.io/component: postgresql
          app.kubernetes.io/instance: dev-health
          app.kubernetes.io/name: ops
  - ports:
    - port: 6379
      protocol: TCP
    to:
    - podSelector:
        matchLabels:
          app.kubernetes.io/component: valkey
          app.kubernetes.io/instance: dev-health
          app.kubernetes.io/name: ops
  - ports:
    - port: 4317
      protocol: TCP
    to:
    - ipBlock:
        cidr: 10.0.0.151/32
    - podSelector:
        matchLabels:
          app.kubernetes.io/component: collector
          app.kubernetes.io/instance: dev-health
          app.kubernetes.io/name: otel-collector
  ingress:
  - from:
    - podSelector:
        matchLabels:
          app.kubernetes.io/component: go-api
          app.kubernetes.io/instance: dev-health
          app.kubernetes.io/name: ops
    ports:
    - port: 8095
      protocol: TCP
  - from:
    - podSelector:
        matchLabels:
          app.kubernetes.io/component: collector
          app.kubernetes.io/instance: dev-health
          app.kubernetes.io/name: otel-collector
    ports:
    - port: 8096
      protocol: TCP
  podSelector:
    matchLabels:
      app.kubernetes.io/component: auth-service
      app.kubernetes.io/instance: dev-health
      app.kubernetes.io/name: ops
  policyTypes:
  - Ingress
  - Egress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  labels:
    app.kubernetes.io/component: go-api-internal
    app.kubernetes.io/instance: dev-health
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/name: ops
    app.kubernetes.io/part-of: dev-health
    app.kubernetes.io/version: 0.1.0
    helm.sh/chart: ops-0.1.0
  name: dev-health-ops-go-api-internal
  namespace: dev-health
spec:
  ingress:
  - ports:
    - endPort: 7999
      port: 1
      protocol: TCP
    - endPort: 8009
      port: 8001
      protocol: TCP
    - endPort: 8090
      port: 8011
      protocol: TCP
    - endPort: 65535
      port: 8092
      protocol: TCP
  - from:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: ingress-nginx
      podSelector:
        matchLabels:
          app.kubernetes.io/component: controller
          app.kubernetes.io/name: ingress-nginx
    ports:
    - port: 8000
      protocol: TCP
    - port: 8010
      protocol: TCP
  - from:
    - podSelector:
        matchLabels:
          app.kubernetes.io/component: api
          app.kubernetes.io/instance: dev-health-acr
          app.kubernetes.io/name: acr
    - podSelector:
        matchLabels:
          app.kubernetes.io/component: go-worker
          app.kubernetes.io/instance: dev-health
          app.kubernetes.io/name: ops
          dev-health.io/worker-group: heavy
    ports:
    - port: 8091
      protocol: TCP
  podSelector:
    matchLabels:
      app.kubernetes.io/component: go-api
      app.kubernetes.io/instance: dev-health
      app.kubernetes.io/name: ops
  policyTypes:
  - Ingress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  labels:
    app.kubernetes.io/component: query-api-mcp
    app.kubernetes.io/instance: dev-health
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/name: ops
    app.kubernetes.io/part-of: dev-health
