{
  "description": "Golden corpus for service-account-token.v1 (the decoded header and claims of the service account token): accept, schema rejects and client-enforced rejects. The signed vectors are in golden/service-account-token.",
  "accept": [
    {
      "file": "valid-dev-health-api.json",
      "why": "The ordinary service account token: audience dev-health-api, typ sa+jwt, the account, its organization and the key row, five minutes."
    },
    {
      "file": "valid-lifetime-at-the-ceiling.json",
      "why": "exp - iat equals the 300 s ceiling: the longest lifetime a verifier accepts."
    },
    {
      "file": "valid-lifetime-short-key-expiry.json",
      "why": "exp - iat of 42 s: a key close to its expiry gets a shorter token, never a longer one."
    },
    {
      "file": "valid-delayed-nbf.json",
      "why": "nbf later than iat, inside the lifetime: iat <= nbf < exp."
    }
  ],
  "reject": [
    {
      "file": "invalid-header-alg-hs256.json",
      "expect_instance_location": "/header/alg",
      "expect_keyword": "const",
      "why": "HS256: a symmetric algorithm is never this token's."
    },
    {
      "file": "invalid-header-alg-none.json",
      "expect_instance_location": "/header/alg",
      "expect_keyword": "const",
      "why": "alg none: an unsigned token."
    },
    {
      "file": "invalid-header-alg-lowercase.json",
      "expect_instance_location": "/header/alg",
      "expect_keyword": "const",
      "why": "alg is case-sensitive."
    },
    {
      "file": "invalid-header-typ-access-token.json",
      "expect_instance_location": "/header/typ",
      "expect_keyword": "const",
      "why": "typ at+jwt is the user access token's type, never a service account token's."
    },
    {
      "file": "invalid-header-typ-workload.json",
      "expect_instance_location": "/header/typ",
      "expect_keyword": "const",
      "why": "typ workload+jwt is the workload token's type, never a service account token's."
    },
    {
      "file": "invalid-header-typ-jwt.json",
      "expect_instance_location": "/header/typ",
      "expect_keyword": "const",
      "why": "typ JWT is the HS256 token's type."
    },
    {
      "file": "invalid-header-typ-lowercase-jwt.json",
      "expect_instance_location": "/header/typ",
      "expect_keyword": "const",
      "why": "typ jwt is the envelope's type."
    },
    {
      "file": "invalid-header-typ-uppercase.json",
      "expect_instance_location": "/header/typ",
      "expect_keyword": "const",
      "why": "typ is case-sensitive."
    },
    {
      "file": "invalid-header-typ-mixed-case.json",
      "expect_instance_location": "/header/typ",
      "expect_keyword": "const",
      "why": "typ is case-sensitive: no mixed-case form."
    },
    {
      "file": "invalid-header-typ-application-prefix.json",
      "expect_instance_location": "/header/typ",
      "expect_keyword": "const",
      "why": "an application/-prefixed media type is not the typ."
    },
    {
      "file": "invalid-header-typ-empty.json",
      "expect_instance_location": "/header/typ",
      "expect_keyword": "const",
      "why": "an empty typ."
    },
    {
      "file": "invalid-header-typ-trailing-space.json",
      "expect_instance_location": "/header/typ",
      "expect_keyword": "const",
      "why": "a trailing space is not the typ."
    },
    {
      "file": "invalid-header-typ-absent.json",
      "expect_instance_location": "/header",
      "expect_keyword": "required",
      "why": "no typ member."
    },
    {
      "file": "invalid-header-kid-absent.json",
      "expect_instance_location": "/header",
      "expect_keyword": "required",
      "why": "no kid member."
    },
    {
      "file": "invalid-header-kid-empty.json",
