{
  "schema_version": 1,
  "name": "CHAOS-3846 worker profile replica controls",
  "$limitation": "The plan proves the declarative replica and drain contract, pre-claim readiness, process identity, expiring presence, operator telemetry, renderer parity, and bounded concurrent shutdown. The real multi-process River claim and restart proof belongs to CHAOS-3847.",
  "mutations": [
    {
      "id": "RC01-desired-replica-upper-bound",
      "file": "internal/deploymentcontract/manifest.go",
      "find": "\t\tprocess.DesiredReplicas < process.MinReplicas || process.DesiredReplicas > process.MaxReplicas ||",
      "replace": "\t\tprocess.DesiredReplicas < process.MinReplicas || false ||",
      "expect_occurrences": 1,
      "rationale": "A requested profile size must not exceed its reviewed maximum or its connection and concurrency budgets become false.",
      "build": ["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-run", "^$", "./internal/deploymentcontract"],
      "proof": [["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-count=1", "-run", "^TestManifestRejectsReplicaRequestOrShutdownWindowOutsideProfileContract$", "./internal/deploymentcontract"]]
    },
    {
      "id": "RC02-longest-claim-drain-buffer",
      "file": "internal/deploymentcontract/manifest.go",
      "find": "\t\tif longestTimeout == 0 || process.ShutdownGraceSeconds < longestTimeout+60 {",
      "replace": "\t\tif longestTimeout == 0 || process.ShutdownGraceSeconds < longestTimeout {",
      "expect_occurrences": 1,
      "rationale": "The orchestrator grace period must cover the longest claim plus the reviewed finalization buffer.",
      "build": ["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-run", "^$", "./internal/deploymentcontract"],
      "proof": [["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-count=1", "-run", "^TestManifestRejectsReplicaRequestOrShutdownWindowOutsideProfileContract$", "./internal/deploymentcontract"]]
    },
    {
      "id": "RC03-preclaim-readiness",
      "file": "cmd/dev-health-worker/dependencies.go",
      "find": "\tif component.registry == nil || !component.registry.CheckRequired(ctx).Ready {",
      "replace": "\tif component.registry == nil || false {",
      "expect_occurrences": 1,
      "rationale": "A new replica must pass its required dependencies before any River client can claim shared-queue work.",
      "build": ["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-run", "^$", "./cmd/dev-health-worker"],
      "proof": [["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-count=1", "-run", "^TestPreclaimReadinessRefusesFailedDependenciesBeforeConsumersStart$", "./cmd/dev-health-worker"]]
    },
    {
      "id": "RC04-process-shutdown-contract",
      "file": "cmd/dev-health-worker/dependencies.go",
      "find": "\tif cfg.ShutdownTimeout > 0 && cfg.ShutdownTimeout < dependencies.shutdownGrace {",
      "replace": "\tif cfg.ShutdownTimeout > 0 && cfg.ShutdownTimeout > dependencies.shutdownGrace {",
      "expect_occurrences": 1,
      "rationale": "A process must refuse a configured shutdown deadline shorter than its profile drain contract.",
      "build": ["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-run", "^$", "./cmd/dev-health-worker"],
      "proof": [["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-count=1", "-run", "^TestWorkerProfileRejectsProcessShutdownTimeoutBelowContract$", "./cmd/dev-health-worker"]]
    },
    {
      "id": "RC05-concurrent-client-shutdown",
      "file": "cmd/dev-health-worker/dependencies.go",
      "find": "\t\tgo func(child lifecycle.Component) { results <- child.Shutdown(ctx) }(child)",
      "replace": "\t\tfunc(child lifecycle.Component) { results <- child.Shutdown(ctx) }(child)",
      "expect_occurrences": 1,
      "rationale": "Independent River clients in one profile must drain concurrently so their claim timeouts do not add together.",
      "build": ["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-run", "^$", "./cmd/dev-health-worker"],
      "proof": [["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-count=1", "-run", "^TestWorkerProfileComponentStopsIndependentRiverClientsConcurrently$", "./cmd/dev-health-worker"]]
    },
    {
      "id": "RC06-expired-presence-is-not-live",
      "file": "internal/jobruntime/profile_presence.go",
      "find": "\t\tWHERE expires_at > statement_timestamp()",
      "replace": "\t\tWHERE expires_at < statement_timestamp()",
      "expect_occurrences": 1,
      "rationale": "A crashed replica must disappear from the live count after its presence lease expires.",
      "build": ["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-tags=integration", "-run", "^$", "./internal/jobruntime"],
      "proof": [["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-tags=integration", "-count=1", "-run", "^TestProfilePresenceCountsIndependentReplicasAndDrainExpiry$", "./internal/jobruntime"]]
    },
    {
      "id": "RC07-drain-component-wiring",
      "file": "cmd/dev-health-worker/dependencies.go",
      "find": "\tif presence != nil {\n\t\tcomponents = append(components, profileDrainComponent{presence: presence})",
      "replace": "\tif false && presence != nil {\n\t\tcomponents = append(components, profileDrainComponent{presence: presence})",
      "expect_occurrences": 1,
      "rationale": "Production replicas must mark themselves draining before their River clients stop during reverse-order shutdown.",
      "build": ["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-run", "^$", "./cmd/dev-health-worker"],
      "proof": [["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-count=1", "-run", "^TestProductionOpsBuilderConstructsNativeSyncCoverageRefresh$", "./cmd/dev-health-worker"]]
    },
    {
      "id": "RC08-operator-scheduled-backlog",
      "file": "cmd/dev-health-workerctl/main.go",
      "find": "\t\t\tstatus.QueueBacklog += queue.Available + queue.Retryable + queue.Scheduled",
      "replace": "\t\t\tstatus.QueueBacklog += queue.Available + queue.Retryable",
      "expect_occurrences": 1,
      "rationale": "Operator backlog must include scheduled jobs so scaling decisions do not under-report queued work.",
      "build": ["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-run", "^$", "./cmd/dev-health-workerctl"],
      "proof": [["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-count=1", "-run", "^TestManifestProfileStatusSourceCombinesFreshQueueAndPresenceState$", "./cmd/dev-health-workerctl"]]
    },
    {
      "id": "RC09-kubernetes-profile-maxima",
      "file": "deploy/kubernetes/go-workers.yaml",
      "find": "metadata: {name: dev-health-go-worker-ops, namespace: dev-health}\nspec:\n  scaleTargetRef: {apiVersion: apps/v1, kind: Deployment, name: dev-health-go-worker-ops}\n  minReplicas: 0\n  maxReplicas: 2",
      "replace": "metadata: {name: dev-health-go-worker-ops, namespace: dev-health}\nspec:\n  scaleTargetRef: {apiVersion: apps/v1, kind: Deployment, name: dev-health-go-worker-ops}\n  minReplicas: 0\n  maxReplicas: 1",
      "expect_occurrences": 1,
      "rationale": "The Kubernetes autoscaler maximum must come from the same reviewed profile contract as every other renderer.",
      "build": ["python", "-m", "py_compile", "tests/workers/test_go_worker_deployment_contract.py"],
      "proof": [["pytest", "-q", "--confcutdir=tests/workers", "tests/workers/test_go_worker_deployment_contract.py", "-k", "profile_replica_and_drain_contract_matches_every_renderer"]]
    },
    {
      "id": "RC10-presence-schema-is-payload-free",
      "file": "src/dev_health_ops/alembic/versions/0104_add_worker_profile_instances.py",
      "find": "        sa.Column(\"heartbeat_at\", sa.DateTime(timezone=True), nullable=False),",
      "replace": "        sa.Column(\"payload\", sa.DateTime(timezone=True), nullable=False),",
      "expect_occurrences": 1,
      "rationale": "Replica presence stores bounded identity and liveness only; it must never grow a payload-shaped field.",
      "build": ["env", "PYTHONPATH=src", "python", "-m", "py_compile", "src/dev_health_ops/alembic/versions/0104_add_worker_profile_instances.py"],
      "proof": [["pytest", "-q", "--confcutdir=tests", "tests/test_worker_profile_instances_migration.py"]]
    },
    {
      "id": "RC11-one-process-identity",
      "file": "cmd/dev-health-worker/dependencies.go",
      "find": "\treturn cfg.WorkerInstanceID + \"-\" + family",
      "replace": "\treturn family",
      "expect_occurrences": 1,
      "rationale": "All River clients in one process need a common process identity prefix for claim attribution while keeping family IDs distinct.",
      "build": ["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-run", "^$", "./cmd/dev-health-worker"],
      "proof": [["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-count=1", "-run", "^TestRiverClientsShareOneProcessIdentityWithDistinctFamilySuffixes$", "./cmd/dev-health-worker"]]
    },
    {
      "id": "RC12-reviewed-runtime-shutdown-budget",
      "file": "internal/platform/lifecycle/runtime.go",
      "find": "\t\t\tattemptBudget = min(source.ShutdownBudget(), remainingBudget)",
      "replace": "\t\t\tattemptBudget = remainingBudget / time.Duration(remainingComponents)",
      "expect_occurrences": 1,
      "rationale": "The profile worker composite must receive its reviewed claim-drain budget instead of the generic equal component share.",
      "build": ["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-run", "^$", "./internal/platform/lifecycle"],
      "proof": [["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-count=1", "-run", "^TestShutdownHonorsReviewedComponentBudget$", "./internal/platform/lifecycle"]]
    },
    {
      "id": "RC13-draining-presence-state",
      "file": "internal/jobruntime/profile_presence.go",
      "find": "\t\tSET state = 'draining', heartbeat_at = statement_timestamp(),",
      "replace": "\t\tSET state = 'active', heartbeat_at = statement_timestamp(),",
      "expect_occurrences": 1,
      "rationale": "A replica must publish draining before it stops claiming so operators can distinguish rollout drain from a crash.",
      "build": ["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-tags=integration", "-run", "^$", "./internal/jobruntime"],
      "proof": [["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-tags=integration", "-count=1", "-run", "^TestProfilePresenceCountsIndependentReplicasAndDrainExpiry$", "./internal/jobruntime"]]
    },
    {
      "id": "RC14-finalization-budget-reserve",
      "file": "cmd/dev-health-worker/dependencies.go",
      "find": "\tdependencies.workerDrainBudget = dependencies.shutdownGrace - profileFinalizationBuffer",
      "replace": "\tdependencies.workerDrainBudget = dependencies.shutdownGrace",
      "expect_occurrences": 1,
      "rationale": "River clients may use the reviewed claim window, but the final 60 seconds must remain available for presence and database cleanup.",
      "build": ["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-run", "^$", "./cmd/dev-health-worker"],
      "proof": [["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-count=1", "-run", "^TestHeavyProfileComposesMultipleBuilderFamilies$", "./cmd/dev-health-worker"]]
    },
    {
      "id": "RC15-noninteractive-coordinator-provisioning",
      "file": "deploy/docker-compose/compose.go-workers.yml",
      "find": "          --set=coordinator_password=\"$$RIVER_COORDINATOR_DATABASE_PASSWORD\" \\",
      "replace": "",
      "expect_occurrences": 1,
      "rationale": "The default-off Compose bootstrap must pass all three role passwords and must never wait for an interactive coordinator password prompt.",
      "build": ["python", "-m", "py_compile", "tests/workers/test_go_worker_deployment_contract.py"],
      "proof": [["pytest", "-q", "--confcutdir=tests/workers", "tests/workers/test_go_worker_deployment_contract.py", "-k", "go_compose_bootstrap_is_post_alembic_fail_closed_and_route_inert"]]
    },
    {
      "id": "RC16-compose-transaction-pooler-mode",
      "file": "deploy/docker-compose/compose.go-workers.yml",
      "find": "      PGBOUNCER_TRANSACTION_MODE: ${PGBOUNCER_TRANSACTION_MODE:-true}",
      "replace": "      PGBOUNCER_TRANSACTION_MODE: ${PGBOUNCER_TRANSACTION_MODE:-false}",
      "expect_occurrences": 1,
      "rationale": "Compose describes POSTGRES_URI as the domain transaction-pool endpoint, so the runtime must enable the transaction-pool safety path by default.",
      "build": ["python", "-m", "py_compile", "tests/workers/test_go_worker_deployment_contract.py"],
      "proof": [["pytest", "-q", "--confcutdir=tests/workers", "tests/workers/test_go_worker_deployment_contract.py", "-k", "go_deployment_surfaces_are_additive_default_off_and_profile_complete"]]
    },
    {
      "id": "RC17-profile-presence-runtime-grant",
      "file": "internal/storage/river/migrate.go",
      "find": "\t\t\"DO $$ BEGIN IF to_regclass('public.worker_profile_instances') IS NOT NULL THEN GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE public.worker_profile_instances TO \" + domainRole + \"; END IF; END $$\",",
      "replace": "\t\t\"DO $$ BEGIN IF to_regclass('public.worker_profile_instances') IS NOT NULL THEN GRANT SELECT ON TABLE public.worker_profile_instances TO \" + domainRole + \"; END IF; END $$\",",
      "expect_occurrences": 1,
      "rationale": "The domain runtime role must receive the same profile-presence privileges that the production SQL surface and readiness posture require.",
      "build": ["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-run", "^$", "./internal/domaingrants"],
      "proof": [["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-count=1", "-run", "^TestDomainGrantSurfaceMatchesQuerySurface$", "./internal/domaingrants"]]
    },
    {
      "id": "RC18-concurrency-lease-runtime-grant",
      "file": "internal/storage/river/migrate.go",
      "find": "\t\t\"DO $$ BEGIN IF to_regclass('public.worker_concurrency_leases') IS NOT NULL THEN GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE public.worker_concurrency_leases TO \" + domainRole + \"; END IF; END $$\",",
      "replace": "\t\t\"DO $$ BEGIN IF to_regclass('public.worker_concurrency_leases') IS NOT NULL THEN GRANT SELECT ON TABLE public.worker_concurrency_leases TO \" + domainRole + \"; END IF; END $$\",",
      "expect_occurrences": 1,
      "rationale": "The durable fleet lease table needs the complete least-privilege grant set used by its atomic admission, renewal, and fenced release operations.",
      "build": ["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-run", "^$", "./internal/domaingrants"],
      "proof": [["env", "GOCACHE=/tmp/chaos3846-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-count=1", "-run", "^TestDomainGrantSurfaceMatchesQuerySurface$", "./internal/domaingrants"]]
    }
  ]
}
