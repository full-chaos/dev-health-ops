{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fullchaos.dev/contracts/auth/v1/jsonschema/action-catalog.v1.schema.json",
  "title": "Auth Control Plane action-catalog (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "description",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": "actions.v1"
    },
    "catalog_version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "scope",
          "resource_kind",
          "risk_class",
          "cache_class",
          "impersonation"
        ],
        "properties": {
          "action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          },
          "scope": {
            "enum": [
              "platform",
              "organization"
            ]
          },
          "resource_kind": {
            "enum": [
              "platform",
              "organization",
              "repository"
            ]
          },
          "risk_class": {
            "enum": [
              "low",
              "high"
            ]
          },
          "cache_class": {
            "enum": [
              "none",
              "decision_bound",
              "resource_revision_bound"
            ]
          },
          "impersonation": {
            "enum": [
              "denied",
              "allowed"
            ],
            "description": "Whether a delegated session may exercise this action (G-51, ACP-ADR-10). denied is the safe value."
          },
          "repository_scope": {
            "enum": [
              "filtered",
              "none"
            ],
            "description": "filtered: an allow of this action carries the repositories the principal may read as an obligation (repository_allowlist), because the action reads repository-bound data. none: it does not. Optional; an absent member is none. A census requires the member on every action whose id ends in .read or .export and on every repository-kind action, so a new such action makes an explicit choice."
          },
          "platform_admin": {
            "enum": [
              "allowed",
              "denied"
            ],
            "description": "allowed: a principal whose platform role holds admin.orgs is allowed this organization action in any active or suspended organization, or one with no organization row, with the obligations of an owner and no membership read (the legacy rule). Only an organization-scope, organization-kind action may carry allowed. Optional; an absent member is denied."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "risk_class": {
                  "const": "high"
                }
              },
              "required": [
                "risk_class"
              ]
            },
            "then": {
              "properties": {
                "cache_class": {
                  "const": "none"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "platform_admin": {
                  "const": "allowed"
                }
              },
              "required": [
                "platform_admin"
              ]
            },
            "then": {
              "properties": {
                "scope": {
                  "const": "organization"
                },
                "resource_kind": {
                  "const": "organization"
                }
              }
            }
          }
        ]
      }
    }
  }
}
