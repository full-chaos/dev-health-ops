   217	// Materializer holds the collaborators one org-scoped run needs. All three are
   218	// required; a nil one is a wiring bug, not a degraded mode.
   219	type Materializer struct {
   220		reader   *chquery.Reader
   221		writer   *chwrite.Writer
   222		provider categorize.Provider
   223		logger   *slog.Logger
   224		// shadow is the optional shadow phase (shadowphase.go). Nil is the default
   225		// and means no phase.
   226		shadow *ShadowPhase
   227		// served is the optional served decision backend (serveddecision.go). Nil is
   228		// the default and means the generative provider serves the run.
   229		served *ServedDecision
   230		// systemOne is the SystemOne backend of the run; every call goes through
   231		// backend(), which falls back to served when this is unset.
   232		systemOne SystemOne
   233		// llmTelemetry receives the investment LLM signals of the generative path
   234		// (CHAOS-8722). Nil records nothing.
   235		llmTelemetry categorize.LLMTelemetry
   236		// batchAnswered is true once a provider batch answered the units of the
   237		// run; it only picks a metric label (failedUnitModel).
   238		batchAnswered bool
   239	}
   240	
   241	// failedUnitModel is the model label of a failed unit's llm_task_failed
   242	// outcome. Python labels a failed batch unit with the provider's model
   243	// (materialize.py:608-672) and a failed synchronous one with the configured
   244	// model (:1676).
   245	func (m *Materializer) failedUnitModel(cfg Config) string {
   246		if m.batchAnswered {
   247			return m.provider.Model()
   248		}
   249		return cfg.Model
   250	}
   251	
   252	// SetLLMTelemetry wires the investment LLM signals. Nil records nothing.
   253	func (m *Materializer) SetLLMTelemetry(telemetry categorize.LLMTelemetry) {
   254		if m != nil {
   255			m.llmTelemetry = telemetry
   256		}
   257	}
   258	
   259	// ErrUnavailable reports a Materializer built without a collaborator it needs.
   260	var ErrUnavailable = errors.New("investment: materializer dependency unavailable")
   261	
   262	// NewMaterializer refuses rather than degrading. A nil provider in particular
   263	// is CHAOS-2476's exact shape -- that bug was "silently persists MOCK
   264	// categorization when no API key set", and the fix is that there is no such
   265	// thing as a materializer without a provider.
   266	func NewMaterializer(reader *chquery.Reader, writer *chwrite.Writer, provider categorize.Provider, logger *slog.Logger) (*Materializer, error) {
   267		if reader == nil || writer == nil || provider == nil || logger == nil {
   268			return nil, ErrUnavailable
   269		}
   270		return &Materializer{reader: reader, writer: writer, provider: provider, logger: logger}, nil
   271	}
   272	
   273	// preprocessed is materialize.py's PreprocessedComponent plus the assembled
   274	// record, since materializecomponent.go produces both in one pass.
   275	type preprocessed struct {
   276		index  int
   277		result MaterializeComponentResult
   278	}
   279	
   280	// Run executes one materialization. The step order is materialize.py's and the
   281	// ordering is load-bearing at three points, each noted at its site.
   282	func (m *Materializer) Run(ctx context.Context, cfg Config) (Stats, error) {
   283		if m == nil || m.reader == nil || m.writer == nil || m.provider == nil {
   284			return Stats{}, ErrUnavailable
   285		}
   286	
   287		repoIDs, err := m.resolveRepoIDs(ctx, cfg)
   288		if err != nil {
   289			return Stats{}, err
   290		}
   291	
   292		edgeRows, err := m.reader.FetchWorkGraphEdges(ctx, chquery.EdgeQueryOptions{
   293			OrganizationID: cfg.OrgID,
   294			RepoIDs:        repoIDs,
   295			// IncludeHeuristic stays false: heuristic edges fuse unrelated work
   296			// into one component (CHAOS-2775) and the zero value is the safe one.
   297		})
   298		if err != nil {
   299			return Stats{}, fmt.Errorf("fetch work graph edges: %w", err)
   300		}
   301	
   302		stats := Stats{LLMFailureCounts: map[string]int{}, failureClassByIndex: map[int]string{}}
   303		buildStats := &units.BuildStats{}
   304		components := units.BuildComponentsWithOptions(
   305			chquery.ComponentEdges(edgeRows),
   306			units.BuildOptions{
   307				MaxComponentNodes:       cfg.MaxComponentNodes,
   308				PartitionHubs:           partitionOversizedHubs,
   309				ProtectPullRequestLinks: units.ProtectPullRequestLinks,
   310				IssueLinksAreReferences: units.IssueLinksAreReferences,
   311			},
   312			buildStats,
   313		)
   314		stats.OversizedComponents = buildStats.OversizedComponents
   315		stats.ReferenceLinks = buildStats.ReferenceLinks
   316		stats.ReferenceOnlyUnits = buildStats.ReferenceOnlyUnits
   317		stats.DroppedEdges = buildStats.DroppedEdges
   318		stats.DroppedNodes = buildStats.DroppedNodes
   319		stats.PartitionedHubs = buildStats.PartitionedHubs
   320		stats.TotalComponents = len(components)
   321		stats.Components = len(components)
   322	
   323		if len(components) == 0 {
   324			// materialize.py:1217-1226 returns the component stats and nothing
   325			// else. Note it reports components=0 and OMITS total_components, so the
   326			// two disagree on this path in the reference; Stats carries both and
   327			// they are both zero here, which is the same information.
   328			m.logger.InfoContext(ctx, "no work graph components found for investment materialization")
   329			m.logRepoAttribution(ctx, cfg, stats)
   330			return stats, nil
   331		}
   332	
   333		entities, err := m.fetchEntities(ctx, cfg, components)
   334		if err != nil {
   335			return Stats{}, err
   336		}
   337		edgeRepoIDs := make(map[string]string, len(edgeRows))
   338		for _, row := range edgeRows {
   339			if row.RepoID != "" {
   340				edgeRepoIDs[row.Edge.EdgeID] = row.RepoID
   341			}
   342		}
   343	
   344		// CHAOS-5359 (R22, 4452 design-of-record vol.2): a pre-pass computing each
   345		// component's OWN repo resolution (the same collectSingleRepoID logic
   346		// MaterializeComponent runs per-component, mirrored here org-wide so the
   347		// cascade below can see EVERY component's own resolution, not just this
   348		// one's), then walking the issue hierarchy for every component that came
   349		// back unresolved. This has to run before the per-component loop, because
   350		// an ancestor/child's resolution can only be known once every component in
   351		// the batch has been examined.
   352		ownRepoByComponent := make(map[int]*uuid.UUID, len(components))
   353		for index, component := range components {
   354			repoID := collectSingleRepoID(component.Edges, edgeRepoIDs)
   355			if repoID == nil {
   356				// CHAOS-5459: a component whose repo comes from its own PR or
   357				// commit CHURN is just as much an "own signal" as one whose edges
   358				// carry a repo_id -- it is the same claim ("this unit's own work
   359				// happened in repo X"), arrived at from the PR/commit node id
   360				// instead of the edge row. Seeding only from edges meant a
   361				// PR-linked parent was invisible to its own children: measured on
   362				// org 70d529e0, `own_edges` appears on 648 issues while pr_churn
   363				// resolves 497 units per run, and NONE of the 198 unresolved
   364				// sub-issues had a parent with an `own_edges` repo.
   365				repoID = churnRepoForComponent(component, entities)
   366			}
   367			ownRepoByComponent[index] = repoID
   368		}
   369		issueComponent := buildIssueComponentIndex(components)
   370		repoCascades := computeRepoHierarchyCascade(components, ownRepoByComponent, entities.WorkItems, issueComponent)
   371		maxHops := 0
   372		for _, cascade := range repoCascades {
   373			switch {
   374			case cascade.Source == RepoSourceChildren:
   375				stats.RepoCascadeChildren++
   376			case cascade.Source != "":
   377				stats.RepoCascadeAncestor++
   378			}
   379			// Hop buckets, not a new metric label: the counter's `source`
   380			// vocabulary stays closed, and a cascade that starts reaching further
   381			// than it used to shows up in the run's log line instead.
   382			switch {
   383			case cascade.Hops <= 1:
   384				stats.RepoCascadeHop1++
   385			default:
   386				stats.RepoCascadeHop2Plus++
   387			}
   388			if cascade.Hops > maxHops {
   389				maxHops = cascade.Hops
   390			}
   391		}
   392		stats.RepoCascadeMaxHops = maxHops
   393		stats.RepoCascadeOwn = 0
   394		for _, repoID := range ownRepoByComponent {
   395			if repoID != nil {
   396				stats.RepoCascadeOwn++
   397			}
   398		}
   399		stats.RepoCascadeUnassigned = len(components) - stats.RepoCascadeOwn - stats.RepoCascadeAncestor - stats.RepoCascadeChildren
   400	
   401		// PREPROCESS. Every component is assembled deterministically first, then
   402		// split into "needs an LLM call" and "already has its answer". The split
   403		// has to happen before any call is made, because the skip-existing lookup
   404		// below is a single batched query over the whole pending set.
   405		var pending, gated []preprocessed
   406		outcomes := make(map[int]categorize.CategorizationOutcome, len(components))
   407		all := make([]preprocessed, 0, len(components))
   408		var promptRedactions promptpii.Counts
   409		for index, component := range components {
   410			cascade := repoCascades[index]
   411			componentInput := MaterializeComponentInput{
   412				Component: component, WorkItems: entities.WorkItems, PRs: entities.PRs, Commits: entities.Commits,
   413				EdgeRepoIDs: edgeRepoIDs, PRChurn: entities.PRChurn, CommitChurn: entities.CommitChurn,
   414				ActiveHours: entities.ActiveHours, StoryPoints: entities.StoryPoints,
   415				ParentTitles: entities.ParentTitles, EpicTitles: entities.EpicTitles,
   416				FromTS: cfg.FromTS, ToTS: cfg.ToTS,
   417				CascadeRepoID: cascade.RepoID, CascadeRepoSource: cascade.Source,
   418			}
   419			result, err := MaterializeComponent(componentInput)
   420			if err != nil {
   421				return Stats{}, fmt.Errorf("assemble component %d: %w", index, err)
   422			}
   423			stats.RejectedConfidences += result.RejectedConfidences
   424			promptRedactions = promptRedactions.Add(result.PromptRedactions)
   425			if result.Skipped != "" {
   426				continue // no bounds, or entirely outside the window
   427			}
   428			entry := preprocessed{index: index, result: result}
   429			all = append(all, entry)
   430	
   431			// materialize.py:1363-1381. Both gates produce a fallback outcome
   432			// rather than skipping the unit: a low-evidence unit still gets an
   433			// investment row, carrying the fallback distribution and a status
   434			// naming why. Dropping it instead would make the unit vanish from the
   435			// allocation view rather than show up as uncategorised.
   436			switch {
   437			case result.Bundle.TextCharCount < minEvidenceChars:
   438				outcomes[index] = categorize.RecordedFallbackOutcome(m.llmTelemetry, categorize.StatusInsufficientChars, cfg.ProviderName, cfg.Model)
   439				gated = append(gated, entry)
   440			case result.Bundle.TextSourceCount == 0:
   441				outcomes[index] = categorize.RecordedFallbackOutcome(m.llmTelemetry, categorize.StatusNoTextSources, cfg.ProviderName, cfg.Model)
   442			default:
   443				pending = append(pending, entry)
   444			}
   445		}
   446		fallbackCount := len(outcomes)
   447	
   448		modelVersion := m.modelVersion(cfg)
   449	
   450		m.logRepoAttribution(ctx, cfg, stats)
   451	
   452		// SKIP-EXISTING. Runs only when not forced, over the pending set and the units
   453		// under the evidence gate (their fallback row, CHAOS-9270).
   454		skippedExisting := map[int]struct{}{}
   455		skippedTerminal := 0
   456		skippedFallback := 0
   457		if (len(pending) > 0 || len(gated) > 0) && !cfg.Force {
   458			candidates := append(append([]preprocessed(nil), pending...), gated...)
   459			keys := make([]chquery.InvestmentKey, 0, len(candidates))
   460			for _, entry := range candidates {
   461				keys = append(keys, chquery.InvestmentKey{
   462					WorkUnitID: entry.result.Investment.WorkUnitID,
   463					InputHash:  entry.result.Bundle.InputHash,
   464				})
   465			}
   466			existing, err := m.reader.FetchExistingInvestmentKeys(ctx, cfg.OrgID, keys, modelVersion)
   467			if err != nil {
   468				return Stats{}, fmt.Errorf("fetch existing investment keys: %w", err)
   469			}
