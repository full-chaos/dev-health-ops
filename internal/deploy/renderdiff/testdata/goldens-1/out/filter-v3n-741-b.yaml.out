---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  annotations:
    nginx.ingress.kubernetes.io/proxy-body-size: 50m
    nginx.ingress.kubernetes.io/proxy-read-timeout: '60'
    nginx.ingress.kubernetes.io/proxy-send-timeout: '60'
    nginx.ingress.kubernetes.io/ssl-redirect: 'false'
    nginx.ingress.kubernetes.io/use-regex: 'true'
  labels:
    app.kubernetes.io/component: go-api
    app.kubernetes.io/instance: dev-health
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/name: ops
    app.kubernetes.io/part-of: dev-health
  name: dev-health-ops-go-api-ingress-nginx-controller-ingress-nginx-sv
  namespace: dev-health
spec:
  ingressClassName: nginx
  rules:
  - host: ingress-nginx-controller.ingress-nginx.svc.cluster.local
