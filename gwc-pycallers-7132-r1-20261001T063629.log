func (e *LocalRateLimitError) Error() string {
	return fmt.Sprintf(
		"local rate limit exceeded; estimated_cost=%.2f; wait_seconds=%.3f exceeds max_wait_seconds=%.3f",
		e.EstimatedCost,
		e.WaitSeconds,
		e.MaxWaitSeconds,
	)
