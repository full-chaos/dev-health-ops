    {
      "file": "invalid-header-x5u.json",
      "expect_instance_location": "/header",
      "expect_keyword": "additionalProperties",
      "why": "x5u: a verifier never reads a certificate URL from the token."
    },
    {
      "file": "invalid-header-jwk.json",
      "expect_instance_location": "/header",
