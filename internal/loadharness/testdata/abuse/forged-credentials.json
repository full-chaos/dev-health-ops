{
  "base_url": "http://127.0.0.1:8081",
  "targets": [
    {
      "name": "forged-garbage", "method": "GET", "path": "/v1/sessions/current",
      "headers": {"Authorization": "Bearer not-a-credential"},
      "expect_status": [401], "forbid_status": [200], "forbid_5xx": true, "require_status": [401]
    },
    {
      "name": "forged-jwt-shape", "method": "GET", "path": "/v1/sessions/current",
      "headers": {"Authorization": "Bearer aaaa.bbbb.cccc"},
      "expect_status": [401], "forbid_status": [200], "forbid_5xx": true, "require_status": [401]
    },
    {
      "name": "forged-wrong-class", "method": "GET", "path": "/v1/sessions/current",
      "headers": {"Authorization": "Bearer svc_loadtest_forged"},
      "expect_status": [401], "forbid_status": [200], "forbid_5xx": true, "require_status": [401]
    }
  ]
}
