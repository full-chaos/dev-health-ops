{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fullchaos.dev/contracts/auth/v1/jsonschema/oauth-clients.v1.schema.json",
  "title": "Auth Control Plane OAuth client registry (v1)",
  "description": "The static registry of the OAuth authorization server (ACP-ADR-13 decision 7; D0 section 8): the trusted source of a client's class and first-party status. One contract file, no overlay, no per-environment file. A row holds no environment value: a first-party row holds a redirect path, resolved against AUTH_OAUTH_WEB_ORIGIN, a fixed-URI row holds its exact https redirect URIs, and a row holds audience names, never resource URIs. An MCP client can never ask for the browser audience.",
  "type": "object",
  "required": [
    "schema_version",
    "clients"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "oauth-clients.v1"
    },
    "clients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/client"
      }
    }
  },
  "$defs": {
    "client": {
      "type": "object",
      "required": [
        "client_id",
        "client_name",
        "client_class",
        "first_party",
        "audiences"
      ],
      "additionalProperties": false,
      "properties": {
        "client_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}[a-z0-9]$",
          "description": "A plain name. A client-ID metadata URL has no row: such a client is class mcp by rule (D0 section 6)."
        },
        "client_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "client_class": {
          "enum": [
            "browser",
            "mcp"
          ]
        },
        "first_party": {
          "type": "boolean",
          "description": "A first-party client has no consent click (ADR-13 decision 7). It still needs the session binding (D0 section 7)."
        },
        "audiences": {
          "type": "array",
          "description": "Exactly one audience, by class (the allOf below): an audience name, never a resource URI."
        },
        "redirect_path": {
          "type": "string",
          "pattern": "^(/[A-Za-z0-9_~-][A-Za-z0-9._~-]*)+$",
          "maxLength": 256,
          "description": "A first-party row's redirect: a path only, resolved against AUTH_OAUTH_WEB_ORIGIN."
        },
        "redirect_uris": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https://[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?(:[0-9]{1,5})?(/[A-Za-z0-9_~-][A-Za-z0-9._~-]*)*$"
          },
          "description": "A fixed-URI row's exact redirect URIs: https only, so a loopback or a test host cannot be a redirect in a prod binary."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "first_party": {
                "const": true
              }
            },
            "required": [
              "first_party"
            ]
          },
          "then": {
            "properties": {
              "redirect_path": true
            },
            "required": [
              "redirect_path"
            ],
            "not": {
              "properties": {
                "redirect_uris": true
              },
              "required": [
                "redirect_uris"
              ]
            }
          },
          "else": {
            "properties": {
              "redirect_uris": true
            },
            "required": [
              "redirect_uris"
            ],
            "not": {
              "properties": {
                "redirect_path": true
              },
              "required": [
                "redirect_path"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "client_class": {
                "const": "mcp"
              }
            },
            "required": [
              "client_class"
            ]
          },
          "then": {
            "properties": {
              "audiences": {
                "const": [
                  "acr-mcp"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "audiences": {
                "const": [
                  "acr-api"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
