# GENERATED by generate-plane-split-router.py from deploy/values.prod.yaml's
# ingress.goApiPaths + ingress.queryApiPaths -- do not hand-edit the rule values, regenerate.
# Traefik file-provider dynamic config (mounted into the traefik container, hot-reloaded).
http:
  routers:
    go-api-paths:
      rule: "Host(`traefik`) && PathRegexp(`^(/api/v1/external-ingest/schemas|/api/v1/external-ingest/schemas/[^/]+|/api/v1/external-ingest/availability|/api/v1/external-ingest/batches|/api/v1/external-ingest/batches/[^/]+|/api/v1/external-ingest/validate|/api/v1/webhooks/health|/api/v1/webhooks/github|/api/v1/webhooks/gitlab|/api/v1/webhooks/jira|/api/v1/webhooks/pagerduty/[^/]+|/api/v1/billing/plans|/api/v1/billing/plans/[^/]+|/api/v1/billing/plans/[^/]+/sync-stripe|/api/v1/billing/invoices|/api/v1/billing/invoices/[^/]+|/api/v1/billing/invoices/[^/]+/void|/api/v1/billing/refunds|/api/v1/billing/refunds/[^/]+|/api/v1/billing/webhooks/stripe|/api/v1/billing/checkout|/api/v1/billing/portal|/api/v1/billing/entitlements/[^/]+|/api/v1/billing/subscriptions|/api/v1/billing/subscriptions/list|/api/v1/billing/subscriptions/history|/api/v1/billing/subscriptions/change-plan|/api/v1/billing/subscriptions/cancel|/api/v1/billing/subscriptions/reactivate|/api/v1/billing/audit|/api/v1/billing/audit/[^/]+|/api/v1/billing/audit/[^/]+/resolve|/api/v1/billing/reconcile|/api/v1/admin/audit-logs|/api/v1/admin/audit-logs/resource/[^/]+/[^/]+|/api/v1/admin/audit-logs/user/[^/]+|/api/v1/admin/audit-logs/[^/]+|/api/v1/admin/feature-flags|/api/v1/admin/feature-flags/[^/]+|/api/v1/admin/ip-allowlist|/api/v1/admin/ip-allowlist/[^/]+|/api/v1/admin/settings|/api/v1/admin/settings/[^/]+|/api/v1/admin/settings/[^/]+/[^/]+|/api/v1/admin/identities|/api/v1/admin/platform/audit-logs|/api/v1/admin/platform/stats|/api/v1/admin/users|/api/v1/admin/users/[^/]+|/api/v1/admin/users/[^/]+/password|/api/v1/admin/orgs|/api/v1/admin/orgs/[^/]+|/api/v1/admin/orgs/[^/]+/feature-overrides|/api/v1/admin/orgs/[^/]+/feature-overrides/[^/]+|/api/v1/admin/orgs/[^/]+/invites|/api/v1/admin/orgs/[^/]+/members|/api/v1/admin/orgs/[^/]+/members/[^/]+|/api/v1/admin/orgs/[^/]+/transfer-ownership|/api/v1/admin/impersonate|/api/v1/admin/impersonate/status|/api/v1/admin/impersonate/stop|/api/v1/admin/credentials|/api/v1/admin/credentials/test|/api/v1/admin/credentials/[^/]+/[^/]+|/api/v1/admin/backfill-jobs|/api/v1/admin/backfill-jobs/[^/]+|/api/v1/admin/sync-runs/[^/]+|/api/v1/admin/sync-runs/[^/]+/units|/api/v1/admin/sync-targets|/api/v1/admin/setup/status|/api/v1/admin/llm-settings|/api/v1/admin/llm-settings/budget|/api/v1/admin/llm-settings/spend|/api/v1/admin/llm-settings/status|/api/v1/admin/customer-push/batches/[^/]+|/api/v1/admin/customer-push/schemas|/api/v1/admin/customer-push/schemas/[^/]+|/api/v1/admin/customer-push/sources|/api/v1/admin/customer-push/sources/[^/]+|/api/v1/admin/customer-push/sources/[^/]+/batches|/api/v1/admin/customer-push/sources/[^/]+/tokens|/api/v1/admin/customer-push/sources/[^/]+/validate|/api/v1/admin/customer-push/tokens|/api/v1/admin/customer-push/tokens/[^/]+/revoke|/api/v1/admin/customer-push/tokens/[^/]+/rotate|/api/v1/admin/teams|/api/v1/admin/teams/[^/]+|/api/v1/admin/teams/[^/]+/approve-changes|/api/v1/admin/teams/[^/]+/confirm-inferred-members|/api/v1/admin/teams/[^/]+/confirm-members|/api/v1/admin/teams/[^/]+/discover-members|/api/v1/admin/teams/[^/]+/dismiss-changes|/api/v1/admin/teams/[^/]+/infer-members|/api/v1/admin/integrations|/api/v1/admin/integrations/github/install-callback|/api/v1/admin/integrations/github/install-url|/api/v1/admin/integrations/pagerduty/api-token|/api/v1/admin/integrations/pagerduty/authorize|/api/v1/admin/integrations/pagerduty/callback|/api/v1/admin/integrations/pagerduty/client-credentials|/api/v1/admin/integrations/pagerduty/disconnect|/api/v1/admin/integrations/pagerduty/preflight|/api/v1/admin/integrations/pagerduty/services|/api/v1/admin/integrations/pagerduty/status|/api/v1/admin/integrations/pagerduty/webhook-bindings|/api/v1/admin/integrations/pagerduty/webhook-bindings/[^/]+|/api/v1/admin/integrations/pagerduty/webhook-bindings/[^/]+/activate|/api/v1/admin/integrations/pagerduty/webhook-bindings/[^/]+/revoke|/api/v1/admin/integrations/pagerduty/webhook-bindings/[^/]+/rotate|/api/v1/admin/integrations/[^/]+|/api/v1/admin/integrations/[^/]+/backfill|/api/v1/admin/integrations/[^/]+/datasets|/api/v1/admin/integrations/[^/]+/discover|/api/v1/admin/integrations/[^/]+/sources|/api/v1/admin/integrations/[^/]+/sources/[^/]+|/api/v1/admin/integrations/[^/]+/sync|/api/v1/admin/sync-configs|/api/v1/admin/sync-configs/[^/]+|/api/v1/admin/sync-configs/[^/]+/coverage|/api/v1/admin/sync-configs/[^/]+/jobs|/api/v1/admin/sync-configs/[^/]+/repositories|/api/v1/admin/sync-configs/[^/]+/trigger|/api/v1/admin/sync-configs/[^/]+/backfill|/api/v1/admin/retention-policies|/api/v1/admin/retention-policies/[^/]+|/api/v1/admin/retention-policies/[^/]+/execute|/health|/ready|/health/workers|/api/v1/telemetry/status|/api/v1/licensing/entitlements/[^/]+|/api/v1/auth/login|/api/v1/auth/social-login|/api/v1/auth/refresh|/api/v1/auth/me|/api/v1/auth/me/organizations|/api/v1/auth/switch-org|/api/v1/auth/validate|/api/v1/auth/logout|/api/v1/auth/accept-invite|/api/v1/auth/onboard|/api/v1/auth/onboarding/state|/api/v1/auth/onboarding/skip-integration|/api/v1/auth/forgot-password|/api/v1/auth/reset-password|/api/v1/auth/register|/api/v1/auth/verify|/api/v1/auth/resend-verification|/api/v1/orgs/me|/api/v1/product-telemetry/events|/api/v1/telemetry/opt-in|/api/v1/telemetry/opt-out|/api/v1/telemetry/report|/api/v1/ingest/commits|/api/v1/ingest/pull-requests|/api/v1/ingest/work-items|/api/v1/ingest/deployments|/api/v1/ingest/incidents|/api/v1/ingest/telemetry)$`)"
      entryPoints: [web]
      priority: 1000
      service: go-api-paths
    query-api-paths:
      rule: "Host(`traefik`) && PathRegexp(`^(/api/v1/meta|/api/v1/filters/options|/api/v1/investment/explain|/api/v1/flame/aggregated|/api/v1/people|/api/v1/people/[^/]+/metric|/api/v1/quadrant|/api/v1/people/[^/]+/summary|/api/v1/explain|/api/v1/drilldown/issues|/api/v1/people/[^/]+/drilldown/issues|/api/v1/flame|/api/v1/sankey|/api/v1/people/[^/]+/drilldown/prs|/api/v1/heatmap|/api/v1/drilldown/prs|/api/v1/opportunities|/api/v1/investment/sunburst|/api/v1/investment/flow/repo-team|/api/v1/investment/flow|/api/v1/investment|/api/v1/work-units/[^/]+/explain|/api/v1/home|/api/v1/work-units)$`)"
      entryPoints: [web]
      priority: 1000
      service: query-api-paths
    # Everything else on the internal traefik hostname (web's own server-side BACKEND_URL calls)
    # falls through to the Python api, mirroring compose.yml's own browser-origin web router
    # (which only matches commanderkeen.dev/localhost, never the internal `traefik` hostname).
    # Without this, a non-split path called via BACKEND_URL=http://traefik:3000 would 404.
    api-internal-catchall:
      rule: "Host(`traefik`)"
      entryPoints: [web]
      priority: 1
      service: api-internal-catchall
  services:
    go-api-paths:
      loadBalancer:
        servers:
          - url: "http://go-api:8000"
    query-api-paths:
      loadBalancer:
        servers:
          - url: "http://query-api:8090"
    api-internal-catchall:
      loadBalancer:
        servers:
          - url: "http://api:8000"

