{
  "schema_version": 1,
  "name": "CHAOS-3847 production multi-replica River gate",
  "$limitation": "The plan proves production client identity, complete ops-profile construction, graceful drain, cancelled-attempt restart recovery, and required cold-gate wiring. River's own SQL claim atomicity remains owned by the pinned River dependency and its upstream tests.",
  "mutations": [
    {
      "id": "MR01-production-claim-identity",
      "file": "cmd/dev-health-worker/dependencies.go",
      "find": "\treturn cfg.WorkerInstanceID + \"-\" + family",
      "replace": "\treturn family",
      "expect_occurrences": 1,
      "rationale": "Every durable River attempted_by value must retain the unique production process identity while naming its worker family.",
      "build": ["env", "GOCACHE=/tmp/chaos3847-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-tags=integration", "-run", "^$", "./cmd/dev-health-worker"],
      "proof": [["env", "DEV_HEALTH_GO_CACHE=/tmp/chaos3847-mutation-cache", "GOTOOLCHAIN=go1.25.9", "bash", "ci/check_go.sh", "multi-replica-workers"]]
    },
    {
      "id": "MR02-production-profile-coverage",
      "file": "cmd/dev-health-worker/operational.go",
      "find": "\t\tjobcontract.KindRetentionCleanup,",
      "replace": "\t\tjobcontract.KindHeartbeat,",
      "expect_occurrences": 1,
      "rationale": "Both replicas must construct the complete reviewed ops profile, including the second durable job kind used by the gate.",
      "build": ["env", "GOCACHE=/tmp/chaos3847-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-tags=integration", "-run", "^$", "./cmd/dev-health-worker"],
      "proof": [["env", "DEV_HEALTH_GO_CACHE=/tmp/chaos3847-mutation-cache", "GOTOOLCHAIN=go1.25.9", "bash", "ci/check_go.sh", "multi-replica-workers"]]
    },
    {
      "id": "MR03-production-drain-stops-claims",
      "file": "cmd/dev-health-worker/operational.go",
      "find": "\treturn component.client.Stop(ctx)",
      "replace": "\treturn nil",
      "expect_occurrences": 1,
      "rationale": "A drained replica must stop its River client before the surviving replica resumes and consumes the paused backlog.",
      "build": ["env", "GOCACHE=/tmp/chaos3847-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-tags=integration", "-run", "^$", "./cmd/dev-health-worker"],
      "proof": [["env", "DEV_HEALTH_GO_CACHE=/tmp/chaos3847-mutation-cache", "GOTOOLCHAIN=go1.25.9", "bash", "ci/check_go.sh", "multi-replica-workers"]]
    },
    {
      "id": "MR04-cancelled-job-restart-attempt",
      "file": "cmd/dev-health-worker/multi_replica_integration_test.go",
      "find": "const multiReplicaRetryAttempts = 3",
      "replace": "const multiReplicaRetryAttempts = 1",
      "expect_occurrences": 1,
      "rationale": "The fault fixture must leave retry capacity so a replacement production replica can claim the attempt cancelled during fleet-lease wait.",
      "build": ["env", "GOCACHE=/tmp/chaos3847-mutation-cache", "GOTOOLCHAIN=go1.25.9", "go", "test", "-tags=integration", "-run", "^$", "./cmd/dev-health-worker"],
      "proof": [["env", "DEV_HEALTH_GO_CACHE=/tmp/chaos3847-mutation-cache", "GOTOOLCHAIN=go1.25.9", "bash", "ci/check_go.sh", "multi-replica-workers"]]
    },
    {
      "id": "MR05-required-go-validation-path",
      "file": "ci/check_go.sh",
      "find": "    plan_providersync_test_shards\n    check_multi_replica_workers\n    check_grant_advisory",
      "replace": "    plan_providersync_test_shards\n    check_grant_advisory",
      "expect_occurrences": 2,
      "rationale": "Both required Go quality paths must execute the cold measured multi-replica gate; a public opt-in verb alone is not enforcement.",
      "build": ["bash", "-n", "ci/check_go.sh"],
      "proof": [["python", "-m", "pytest", "-q", "tests/tooling/test_check_go_public_verbs.py", "-k", "multi_replica_gate_is_cold_measured_and_required"]]
    }
  ]
}
