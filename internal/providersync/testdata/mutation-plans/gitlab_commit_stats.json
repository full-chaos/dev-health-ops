      "proof": [["go", "test", "-count=1", "-tags", "integration", "-run", "^(TestGitLabCommitStatsReadbackSeparatesTenantsAndConvergesAfterRetry|TestGitHubCommitStatsReadbackSelectsOwningTenantFromNaturalKeyCollision)$", "./internal/providersync/"]]
    },
