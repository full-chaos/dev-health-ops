# bigboy image pins (CHAOS-9962): the ONLY place the digests of ci/bigboy/compose.bigboy.yml live. Pass it after ops/.env:
#   docker compose ... --env-file ops/.env --env-file _records/images.env -f ci/bigboy/compose.bigboy.yml ...
# bigboy-repin.sh and bigboy-repin-web.sh rewrite the running copy _records/images.env at every cut (and write BIGBOY_OPERATOR_IMAGE into it);
# this tracked copy is the last pin a PR recorded, not the build bigboy runs now. BIGBOY_OPERATOR_IMAGE (the workers) is exported by the cut and written here by repin.
BIGBOY_API_TOOLS_IMAGE=ghcr.io/full-chaos/dev-health-go-api-tools@sha256:9acc77c8ecc742bb402d7b386d4b9b35d6d7c229b73c08d3b88a4b5dadf6a4e1
BIGBOY_DHO_IMAGE=ghcr.io/full-chaos/dev-health-go-dho@sha256:ffca8ecc8c94921023145a9bccdc96705d0d1926b1707b22b73ecba29dd96d31
BIGBOY_WEB_IMAGE=ghcr.io/full-chaos/dev-health-web@sha256:8665742e20b47671855714f0fd2777015ed0cf01b84501822f4542d1d23b8192
# The host file mounted into ClickHouse's users.d (declares dho_api_ch; bigboy-cut.sh checks it before it recreates go-api). The path stack.sh and the cut defaulted to:
DHO_API_CH_USERS_XML=/home/ubuntu/devhealth/.go-api-dev/dho_api_ch.xml
# The acr venue images (CHAOS-10004) are pinned by registry digest of the build that runs (c468110c: acr-api also runs the projector and the migrations). They are
# also built on the host (tagged acr-api:venue-c468110c / acr-mcp:venue-c468110c) with --build-arg VERSION=0.1.0 --build-arg COMMIT=<full sha>; without both args acr-api
# refuses the sidecar with a 426. The running copy _records/images.env holds the pins of the build that runs.
BIGBOY_ACR_API_IMAGE=ghcr.io/full-chaos/dev-health-acr/acr-api@sha256:ec6e39a98f560942bdda03e778c247a01faf0c170ccda078d8c64fd67e24ea3c
BIGBOY_ACR_MCP_IMAGE=ghcr.io/full-chaos/dev-health-acr/acr-mcp@sha256:b30cc1b4e28fe73b676afd3e04a994eef5334c2ac39f71dfece99718f0256546
# The third-party images of the acr venue stack, pinned by registry digest as the old project's compose.yml pinned them:
BIGBOY_ACR_POSTGRES_IMAGE=postgres:18-alpine@sha256:a1d02e4bd40c94d3bf2bdd3678c137388e76d9efcd23c285e9429d336a834b44
BIGBOY_ACR_NGINX_IMAGE=nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
BIGBOY_ACR_FALKORDB_IMAGE=falkordb/falkordb@sha256:ad09d5051bbda1cfee8cef9d7f41ffe1bcb1c5327b82c442c989e84ab8cc33d3
