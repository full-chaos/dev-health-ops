{
  "cases": [
    {
      "name": "member",
      "headers": {
        "X-DH-Internal-Org-Id": "org-1",
        "X-DH-Internal-Role": "member",
        "X-DH-Internal-Superuser": "false",
        "X-DH-Internal-Impersonation-Active": "false"
      },
      "expected": {
        "OrgID": "org-1",
        "Role": "member",
        "IsSuperuser": false,
        "ImpersonationActive": false
      }
    },
    {
      "name": "superuser",
      "headers": {
        "X-DH-Internal-Org-Id": "org-1",
        "X-DH-Internal-Role": "owner",
        "X-DH-Internal-Superuser": "true",
        "X-DH-Internal-Impersonation-Active": "false"
      },
      "expected": {
        "OrgID": "org-1",
        "Role": "owner",
        "IsSuperuser": true,
        "ImpersonationActive": false
      }
    },
    {
      "name": "admin",
      "headers": {
        "X-DH-Internal-Org-Id": "11111111-1111-4111-8111-111111111111",
        "X-DH-Internal-Role": "admin",
        "X-DH-Internal-Superuser": "false",
        "X-DH-Internal-Impersonation-Active": "false"
      },
      "expected": {
        "OrgID": "11111111-1111-4111-8111-111111111111",
        "Role": "admin",
        "IsSuperuser": false,
        "ImpersonationActive": false
      }
    },
    {
      "name": "non-ascii org and role",
      "headers": {
        "X-DH-Internal-Org-Id": "org-ü",
        "X-DH-Internal-Role": "rôle-é",
        "X-DH-Internal-Superuser": "false",
        "X-DH-Internal-Impersonation-Active": "false"
      },
      "expected": {
        "OrgID": "org-ü",
        "Role": "rôle-é",
        "IsSuperuser": false,
        "ImpersonationActive": false
      }
    },
    {
      "name": "four-byte unicode",
      "headers": {
        "X-DH-Internal-Org-Id": "org-😀-中文",
        "X-DH-Internal-Role": "admin",
        "X-DH-Internal-Superuser": "false",
        "X-DH-Internal-Impersonation-Active": "false"
      },
      "expected": {
        "OrgID": "org-😀-中文",
        "Role": "admin",
        "IsSuperuser": false,
        "ImpersonationActive": false
      }
    },
    {
      "name": "combining marks",
      "headers": {
        "X-DH-Internal-Org-Id": "org-å",
        "X-DH-Internal-Role": "é",
        "X-DH-Internal-Superuser": "false",
        "X-DH-Internal-Impersonation-Active": "false"
      },
      "expected": {
        "OrgID": "org-å",
        "Role": "é",
        "IsSuperuser": false,
        "ImpersonationActive": false
      }
    },
    {
      "name": "empty org and role",
      "headers": {
        "X-DH-Internal-Org-Id": "",
        "X-DH-Internal-Role": "",
        "X-DH-Internal-Superuser": "false",
        "X-DH-Internal-Impersonation-Active": "false"
      },
      "expected": {
        "OrgID": "",
        "Role": "",
        "IsSuperuser": false,
        "ImpersonationActive": false
      }
    },
    {
      "name": "very long values",
      "headers": {
        "X-DH-Internal-Org-Id": "",
        "X-DH-Internal-Role": "",
        "X-DH-Internal-Superuser": "false",
        "X-DH-Internal-Impersonation-Active": "false"
      },
      "expected": {
        "OrgID": "",
        "Role": "",
        "IsSuperuser": false,
        "ImpersonationActive": false
      }
    },
    {
      "name": "interior spaces",
      "headers": {
        "X-DH-Internal-Org-Id": "org  with  spaces",
        "X-DH-Internal-Role": "team lead",
        "X-DH-Internal-Superuser": "false",
        "X-DH-Internal-Impersonation-Active": "false"
      },
      "expected": {
        "OrgID": "org  with  spaces",
        "Role": "team lead",
        "IsSuperuser": false,
        "ImpersonationActive": false
      }
    },
    {
      "name": "header-looking text",
      "headers": {
        "X-DH-Internal-Org-Id": "a;b=c",
        "X-DH-Internal-Role": "admin, superuser",
        "X-DH-Internal-Superuser": "false",
        "X-DH-Internal-Impersonation-Active": "false"
      },
      "expected": {
        "OrgID": "a;b=c",
        "Role": "admin, superuser",
        "IsSuperuser": false,
        "ImpersonationActive": false
      }
    },
    {
      "name": "impersonating",
      "headers": {
        "X-DH-Internal-Org-Id": "org-target",
        "X-DH-Internal-Role": "viewer",
        "X-DH-Internal-Superuser": "false",
        "X-DH-Internal-Impersonation-Active": "true"
      },
      "expected": {
        "OrgID": "org-target",
        "Role": "viewer",
        "IsSuperuser": false,
        "ImpersonationActive": true
      }
    }
  ],
  "refused": [
    {
      "name": "nul",
      "org_id": "org\u0000x",
      "role": "admin"
    },
    {
      "name": "crlf injection",
      "org_id": "org-1\r\nX-DH-Internal-Superuser: true",
      "role": "admin"
    },
    {
      "name": "lf",
      "org_id": "org\n1",
      "role": "admin"
    },
    {
      "name": "tab edge",
      "org_id": "org-1\t",
      "role": "admin"
    },
    {
      "name": "leading space",
      "org_id": " org-1",
      "role": "admin"
    },
    {
      "name": "trailing space role",
      "org_id": "org-1",
      "role": "admin "
    },
    {
      "name": "delete char",
      "org_id": "org1",
      "role": "admin"
    }
  ]
}
