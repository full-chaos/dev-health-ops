   152		OversizedComponents int            `json:"oversized_components"`
   153		DroppedEdges        int            `json:"dropped_edges"`
   154		DroppedNodes        int            `json:"dropped_nodes"`
   155		PartitionedHubs     int            `json:"partitioned_hubs"`
   156		// ReferenceLinks and ReferenceOnlyUnits are units.BuildStats' counters of
