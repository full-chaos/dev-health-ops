{
  "schema_version": 1,
  "name": "scheduled-sync-materializer",
  "$comment": "CHAOS-3145 structural closures. Each mutation removes one readiness, routing, generated-manifest, or initialized-state guard and must drive its real producer or PostgreSQL proof green to red to green.",
  "build": [
    "go",
    "build",
    "-tags",
    "integration",
    "./..."
  ],
  "mutations": [
    {
      "id": "SSM1",
      "file": "internal/syncreconciler/materializer.go",
      "find": "\t\t\trun.triggered_by <> 'schedule'\n\t\t\tOR EXISTS (",
      "replace": "\t\t\tTRUE\n\t\t\tOR EXISTS (",
      "expect_occurrences": 2,
      "rationale": "Both Go dispatch and zero-unit finalize candidates must reject a scheduled domain graph until the coordinator occurrence link commits; ordinary non-scheduled runs retain the explicit bypass.",
      "proof": [["go", "test", "-tags=integration", "-count=1", "-timeout", "10m", "-run", "TestMaterializerPostgresConcurrencyAndRollback/scheduled", "./internal/syncreconciler/"]]
    },
    {
      "id": "SSM2",
      "file": "src/dev_health_ops/workers/sync_reconciler.py",
      "find": "or_(SyncRun.triggered_by != \"schedule\", scheduled_plan_ready)",
      "replace": "or_(SyncRun.triggered_by != \"schedule\", True)",
      "expect_occurrences": 2,
      "rationale": "The active Python reconciler must enforce the identical occurrence-link fence for dispatch and finalize; otherwise its 60-second beat can publish the first transaction's partial graph.",
      "proof": [["pytest", "-q", "tests/test_sync_reconciler.py::test_scheduled_dispatch_waits_for_committed_occurrence_readiness", "tests/test_sync_reconciler.py::test_scheduled_zero_unit_finalize_waits_for_committed_occurrence_readiness"]]
    },
    {
      "id": "SSM3",
      "file": "internal/scheduler/sync/materializer.go",
      "find": "\tif sourceID == nil || len(targets) == 0 {",
      "replace": "\tif len(targets) == 0 {",
      "expect_occurrences": 1,
      "rationale": "Parent configurations leave dataset scope unset in the live Python producer; applying their legacy sync_targets narrows the scheduled plan incorrectly.",
      "proof": [["go", "test", "-count=1", "-run", "TestBuildScheduledPlanMatchesLivePythonPlanner|TestRequestedDatasetKeysPreservesLiveConfigRoutingSemantics", "./internal/scheduler/sync/"]]
    },
    {
      "id": "SSM4",
      "file": "internal/scheduler/sync/materializer.go",
      "find": "\tif len(requested) == 0 {\n\t\treturn nil\n\t}",
      "replace": "\tif false {\n\t\treturn nil\n\t}",
      "expect_occurrences": 1,
      "rationale": "A child whose targets map to no provider datasets falls back to all enabled datasets in the live Python producer rather than materializing an empty plan.",
      "proof": [["go", "test", "-count=1", "-run", "TestBuildScheduledPlanMatchesLivePythonPlanner|TestRequestedDatasetKeysPreservesLiveConfigRoutingSemantics", "./internal/scheduler/sync/"]]
    },
    {
      "id": "SSM5",
      "file": "internal/storage/postgres/role_posture_integration_test.go",
      "find": "\t\tcolumnNames[column.TableName][column.ColumnName] = struct{}{}",
      "replace": "\t\t_ = column.ColumnName",
      "expect_occurrences": 2,
      "rationale": "The real-manifest gate must construct every column named by both generated ColumnScoped manifests before applying the generated grants.",
      "proof": [["go", "test", "-tags=integration", "-count=1", "-timeout", "10m", "-run", "TestDomainAndCoordinatorPosturesSatisfyAttributionAgainstTheRealManifest", "./internal/storage/postgres/"]]
    },
    {
      "id": "SSM6",
      "file": "internal/scheduler/sync/materializer.go",
      "find": "persistedStartedAt != nil",
      "replace": "false",
      "expect_occurrences": 1,
      "rationale": "An orphan replay must reject a sync-run lifecycle field that differs from its initialized state before the readiness fence.",
      "proof": [["go", "test", "-tags=integration", "-count=1", "-timeout", "10m", "-run", "TestNativeMaterializerRejectsReplayAcrossInitializedFieldFamilies/sync_run_lifecycle", "./internal/scheduler/sync/"]]
    },
    {
      "id": "SSM7",
      "file": "internal/scheduler/sync/materializer.go",
      "find": "rateLimitDeferrals != 0",
      "replace": "false",
      "expect_occurrences": 1,
      "rationale": "Unit retry and lease lifecycle fields are initialized state during the fenced orphan window and must participate in replay verification.",
      "proof": [["go", "test", "-tags=integration", "-count=1", "-timeout", "10m", "-run", "TestNativeMaterializerRejectsReplayAcrossInitializedFieldFamilies/unit_retry_lifecycle", "./internal/scheduler/sync/"]]
    },
    {
      "id": "SSM8",
      "file": "internal/scheduler/sync/materializer.go",
      "find": "persistedJobDuration != nil",
      "replace": "false",
      "expect_occurrences": 1,
      "rationale": "The deterministic JobRun collision verifier must reject lifecycle state not initialized by scheduled materialization.",
      "proof": [["go", "test", "-tags=integration", "-count=1", "-timeout", "10m", "-run", "TestNativeMaterializerRejectsReplayAcrossInitializedFieldFamilies/job_run_lifecycle", "./internal/scheduler/sync/"]]
    },
    {
      "id": "SSM9",
      "file": "internal/scheduler/sync/materializer.go",
      "find": "discoveryError != nil",
      "replace": "false",
      "expect_occurrences": 1,
      "rationale": "The deterministic reference-discovery verifier must include its initialized completion, lease, error, and result family.",
      "proof": [["go", "test", "-tags=integration", "-count=1", "-timeout", "10m", "-run", "TestNativeMaterializerRejectsReplayAcrossInitializedFieldFamilies/discovery_lifecycle", "./internal/scheduler/sync/"]]
    },
    {
      "id": "SSM10",
      "file": "internal/scheduler/sync/materializer.go",
      "find": "outboxLastError != nil",
      "replace": "false",
      "expect_occurrences": 1,
      "rationale": "The deterministic discovery-outbox verifier must include its initialized claim, dispatch, error, and transport family.",
      "proof": [["go", "test", "-tags=integration", "-count=1", "-timeout", "10m", "-run", "TestNativeMaterializerRejectsReplayAcrossInitializedFieldFamilies/outbox_lifecycle", "./internal/scheduler/sync/"]]
    },
    {
      "id": "SSM11",
      "file": "internal/scheduler/sync/materializer.go",
      "find": "\t\tif raw := existing[dataset]; len(raw) > 0 {",
      "replace": "\t\tif raw := existing[dataset]; false && len(raw) > 0 {",
      "expect_occurrences": 1,
      "rationale": "PagerDuty repair must merge the live planner-produced services options so service_repository_mappings and per-dataset initial_sync_depth survive while legacy_targets is normalized.",
      "proof": [["go", "test", "-tags=integration", "-count=1", "-timeout", "10m", "-run", "TestNativeMaterializerRepairsPagerDutyInventoryWithoutReadingCiphertext", "./internal/scheduler/sync/"]]
    }
  ]
}
