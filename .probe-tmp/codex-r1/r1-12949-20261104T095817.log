   158		// for their otherwise unplaced endpoints.
   159		ReferenceLinks     int `json:"reference_links"`
   160		ReferenceOnlyUnits int `json:"reference_only_units"`
   161		// RepoCascadeOwn/Ancestor/Children/Unassigned (CHAOS-5359) partition every
   162		// component this run built by how (or whether) it resolved a repo --
   163		// own-edges, inherited from an ancestor, inherited from unanimous
   164		// children, or neither. They always sum to Components.
   165		RepoCascadeOwn        int `json:"repo_cascade_own"`
   166		RepoCascadeAncestor   int `json:"repo_cascade_ancestor"`
   167		RepoCascadeChildren   int `json:"repo_cascade_children"`
   168		RepoCascadeUnassigned int `json:"repo_cascade_unassigned"`
   169		// RepoCascadeHop1/Hop2Plus/MaxHops (CHAOS-5459) describe HOW FAR the
   170		// fixed-point cascade had to reach. Hop 1 is the pre-fix behaviour --
   171		// inheriting directly from a relative with its own signal; anything above
   172		// it only exists because the cascade now chains. They are reported in the
   173		// run's log line, deliberately NOT as a metric label: the counter's
   174		// `source` vocabulary is closed and a hop count would make it unbounded.
   175		RepoCascadeHop1     int `json:"repo_cascade_hop1"`
   176		RepoCascadeHop2Plus int `json:"repo_cascade_hop2_plus"`
   177		RepoCascadeMaxHops  int `json:"repo_cascade_max_hops"`
   178		// RejectedConfidences sums, across every component this run assembled, the
   179		// edge confidences excluded from evidence-quality scoring because they are
   180		// not finite (NaN or +/-Inf). Zero on a run where every confidence was
   181		// finite.
   182		RejectedConfidences int `json:"rejected_confidences"`
   183	}
   184	
   185	// logRepoAttribution emits the run's closed repo-attribution partition -- own,
   186	// ancestor, children, team and unassigned (CHAOS-5458) -- as one structured
   187	// log line carrying BOTH halves that used to live on two separate lines
   188	// correlated only by run_id: the cascade fields the OLD "investment repo
   189	// attribution" line had (own_signal/hierarchy_ancestor/hierarchy_children/
   190	// cascade_hop*/unassigned), PLUS the team partition and its NxM fan-out
   191	// (team_fallback/team_repo_shares) that only ever appeared on "investment team
   192	// repository fallback". That second line is UNCHANGED and still emitted
   193	// (logOwnershipFallback, called right before this) -- it carries the fuller
   194	// ownership-outcome breakdown (own_repo/stronger_allocation/direct_repo_
   195	// evidence/no_eligible_owner/donor_rows/donor_issues) that has no place in a
   196	// five-way closed partition. RepoAttributionCountsFromStats' own doc comment
   197	// has the proof that team is always a subset of the pre-team-split unassigned
   198	// count, which is what makes folding it into this line's `unassigned` field
   199	// exact rather than approximate. Called on every run, including a
   200	// zero-component run, so a stalled fleet reads as explicit zeros rather than
   201	// a missing line.
   202	func (m *Materializer) logRepoAttribution(ctx context.Context, cfg Config, stats Stats) {
   203		counts := RepoAttributionCountsFromStats(stats)
   204		m.logger.InfoContext(ctx, "investment repo attribution",
   205			"org_id", cfg.OrgID, "run_id", cfg.RunID,
   206			"components", stats.Components,
   207			"own_signal", counts.Own,
   208			"hierarchy_ancestor", counts.Ancestor,
   209			"hierarchy_children", counts.Children,
   210			"cascade_hop1", stats.RepoCascadeHop1,
   211			"cascade_hop2_plus", stats.RepoCascadeHop2Plus,
   212			"cascade_max_hops", stats.RepoCascadeMaxHops,
   213			"unassigned", counts.Unassigned,
   214		)
   215	}
