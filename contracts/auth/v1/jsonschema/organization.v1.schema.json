{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fullchaos.dev/contracts/auth/v1/jsonschema/organization.v1.schema.json",
  "title": "Auth Control Plane organization (v1 wire format)",
  "description": "An organization as auth-service serves it. Ids are server-minted and never echoed from a request. status is the organization's current state; a suspended organization denies its members.",
  "type": "object",
  "required": [
    "schema_version",
    "organization_id",
    "slug",
    "name",
    "status",
    "revision",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "organization.v1",
      "description": "Contract identifier. A reader MUST reject an unrecognised value (G-26: unknown denies)."
    },
    "organization_id": {
      "type": "string",
      "pattern": "^org_[A-Za-z0-9_-]{22,64}$",
      "description": "Organization id. Server-minted, never copied from caller input."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "description": "Stable external handle (organization.created/updated change.slug)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Mutable display label."
    },
    "status": {
      "enum": [
        "active",
        "suspended"
      ],
      "description": "Current state."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Aggregate revision (provisioning-event.v1 payload.revision). Integer token only; a decimal-form token is refused by every client (README, integer guard)."
    },
    "created_at": {
      "type": "string",
      "pattern": "^([0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?(Z|[+-](0[0-9]|1[0-9]|2[0-3]):[0-5][0-9])$",
      "description": "Creation instant."
    },
    "updated_at": {
      "type": "string",
      "pattern": "^([0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?(Z|[+-](0[0-9]|1[0-9]|2[0-3]):[0-5][0-9])$",
      "description": "Last change instant."
    }
  }
}
