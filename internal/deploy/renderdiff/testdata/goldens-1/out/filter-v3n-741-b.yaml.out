      app.kubernetes.io/component: clickhouse
      app.kubernetes.io/instance: dev-health
      app.kubernetes.io/name: ops
  serviceName: dev-health-ops-clickhouse
  template:
    metadata:
      annotations:
        checksum/clickhouse-configd: 6c697875f1e17b05063b5f9034706356814286d000f12f3b41d469c830e0512a
        checksum/clickhouse-usersd-files: 2dc76f412375d47484f84a2a8c806247fa0a4e3399aeb2823ab63b224708edd2
      labels:
        app.kubernetes.io/component: clickhouse
        app.kubernetes.io/instance: dev-health
        app.kubernetes.io/name: ops
    spec:
      automountServiceAccountToken: false
      containers:
      - env:
        - name: CLICKHOUSE_USER
          value: placeholder
        - name: CLICKHOUSE_PASSWORD
          value: <redacted>
        - name: CLICKHOUSE_DB
          value: placeholder
        - name: CLICKHOUSE_LISTEN_HOST
          value: 0.0.0.0
        image: clickhouse/clickhouse-server:latest@sha256:d7556a3841027651307b5aa08d72b5c467d0241d3db5b67d9e158ef3975626f5
        livenessProbe:
          httpGet:
            path: /ping
            port: http
          initialDelaySeconds: 30
          periodSeconds: 10
        name: clickhouse
        ports:
        - containerPort: 8123
          name: http
        - containerPort: 9000
          name: native
        readinessProbe:
          httpGet:
            path: /ping
            port: http
          initialDelaySeconds: 5
          periodSeconds: 5
        resources:
          limits:
            cpu: '3'
            memory: 6Gi
          requests:
            cpu: 250m
            memory: 1Gi
        volumeMounts:
        - mountPath: /var/lib/clickhouse
          name: clickhouse-data
        - mountPath: /etc/clickhouse-server/users.d
          name: clickhouse-usersd-links
        - mountPath: /etc/clickhouse-server/usersd-cm
          name: clickhouse-usersd
          readOnly: true
        - mountPath: /etc/clickhouse-server/config.d/system-logs.xml
          name: clickhouse-configd
          readOnly: true
          subPath: system-logs.xml
      initContainers:
      - command:
        - sh
        - -c
        - for n in "$@"; do ln -sfn "../usersd-cm/$n" "/links/$n"; done
        - --
        - acr_ro.xml
        - dho_api_ch.xml
        image: clickhouse/clickhouse-server:latest@sha256:d7556a3841027651307b5aa08d72b5c467d0241d3db5b67d9e158ef3975626f5
        name: clickhouse-usersd-links
        volumeMounts:
        - mountPath: /links
          name: clickhouse-usersd-links
      volumes:
      - configMap:
          name: dev-health-ops-clickhouse-usersd
        name: clickhouse-usersd
      - emptyDir: {}
        name: clickhouse-usersd-links
      - configMap:
          name: dev-health-ops-clickhouse-configd
        name: clickhouse-configd
  volumeClaimTemplates:
  - metadata:
      name: clickhouse-data
    spec:
      accessModes:
      - ReadWriteOnce
      resources:
        requests:
          storage: 10Gi
