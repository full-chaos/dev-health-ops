apiVersion: batch/v1
kind: Job
metadata:
  annotations:
    helm.sh/hook: post-install,pre-upgrade
    helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
    helm.sh/hook-weight: '0'
  labels:
    app.kubernetes.io/component: migrate
    app.kubernetes.io/instance: dev-health
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/name: ops
    app.kubernetes.io/part-of: dev-health
    app.kubernetes.io/version: 0.1.0
    helm.sh/chart: ops-0.1.0
  name: dev-health-ops-migrate
  namespace: dev-health
spec:
  activeDeadlineSeconds: 1800
  backoffLimit: 2
  template:
    metadata:
      labels:
        app.kubernetes.io/component: migrate
        app.kubernetes.io/instance: dev-health
        app.kubernetes.io/name: ops
    spec:
      automountServiceAccountToken: false
      containers:
      - args:
        - migrate
        - upgrade
        - --river=false
        env:
        - name: AUTH_DATABASE_SCHEMA
          value: auth
        - name: DEV_HEALTH_ALLOW_CELERY_RIVER_CUTOVER
          value: '1'
        - name: OPERATIONAL_ORDERING_CONTRACT
          value: '2'
        - name: AUTH_PROXY_SESSIONS
          value: 'true'
        - name: DHO_CH_CLOUD_HOST
          valueFrom:
            secretKeyRef:
              key: CH_CLOUD_HOST
              name: ch-cloud-default
        - name: DHO_CH_CLOUD_USER
          valueFrom:
            secretKeyRef:
              key: CH_CLOUD_USER
              name: ch-cloud-default
        - name: DHO_CH_CLOUD_PASSWORD
          valueFrom:
            secretKeyRef:
              key: CH_CLOUD_PASSWORD
              name: ch-cloud-default
        - name: CLICKHOUSE_URI
          value: <redacted>
        envFrom:
        - configMapRef:
            name: dev-health-ops-migrate-config
        - secretRef:
            name: dev-health-ops-migrate
        image: ghcr.io/full-chaos/dev-health-go-operator@sha256:2c87c3613bca406dd962673e7b6d15d7a15cf9dc71e59865a2e0574ec8a39dd6
        imagePullPolicy: IfNotPresent
        name: migrate
        resources:
          limits:
            cpu: 500m
            memory: 1Gi
          requests:
            cpu: 100m
            memory: 256Mi
        securityContext:
          allowPrivilegeEscalation: false
      imagePullSecrets:
      - name: ghcr-pull
      initContainers:
      - command:
        - sh
        - -ec
        - until pg_isready --host dev-health-ops-postgresql --port 5432 --username
          "placeholder" --dbname "placeholder"; do sleep 2; done
        image: postgres:18-alpine@sha256:9a8afca54e7861fd90fab5fdf4c42477a6b1cb7d293595148e674e0a3181de15
        imagePullPolicy: IfNotPresent
        name: wait-for-postgresql
        securityContext:
          allowPrivilegeEscalation: false
          runAsGroup: 70
          runAsUser: 70
      restartPolicy: Never
      securityContext:
        runAsNonRoot: true
---
