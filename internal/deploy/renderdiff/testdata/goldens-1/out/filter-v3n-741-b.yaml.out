apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app.kubernetes.io/component: auth-service
    app.kubernetes.io/instance: dev-health
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/name: ops
    app.kubernetes.io/part-of: dev-health
    app.kubernetes.io/version: 0.1.0
    helm.sh/chart: ops-0.1.0
  name: dev-health-ops-auth-service
  namespace: dev-health
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/component: auth-service
      app.kubernetes.io/instance: dev-health
      app.kubernetes.io/name: ops
  strategy:
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
    type: RollingUpdate
  template:
    metadata:
      labels:
        app.kubernetes.io/component: auth-service
        app.kubernetes.io/instance: dev-health
        app.kubernetes.io/name: ops
    spec:
      automountServiceAccountToken: false
      containers:
      - args:
        - --http-addr=:8095
        - --operator-http-addr=:8096
        - --shutdown-timeout=20s
        - --database-schema=auth
        - --database-max-conns=8
        - --signing-key-file=/run/auth/signing/signing-key.pem
        - --signing-key-id=auth-prod-2026-10
        env:
        - name: AUTH_DATABASE_URI
          valueFrom:
            secretKeyRef:
              key: AUTH_DATABASE_URI
