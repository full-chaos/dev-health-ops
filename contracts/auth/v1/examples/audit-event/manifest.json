{
  "description": "Golden corpus for audit-event.v1; the single inventory read by the Go, Python and ajv runners (G-70).",
  "accept": [
    {
      "file": "valid-full.json",
      "why": "Every optional member and every allowlisted attribute."
    },
    {
      "file": "valid-minimal.json",
      "why": "No actor, no subject, empty attributes: a failed login for an unknown identity genuinely has neither."
    },
    {
      "file": "valid-denied.json",
      "why": "A denial."
    },
    {
      "file": "valid-error.json",
      "why": "An error outcome."
    },
    {
      "file": "valid-policy-revision-zero.json",
      "why": "Policy revision 0, as principal.v1 allows."
    },
    {
      "file": "valid-producer-membership-role-changed.json",
      "why": "A real change-role row (the shape membership.auditFor builds), ids in the wire form."
    },
    {
      "file": "valid-producer-workload-token-issued.json",
      "why": "A workload token row: ids, a revision, a closed audience and an action list."
    },
    {
      "file": "valid-producer-session-issued.json",
      "why": "A delegated session row: amr is a list, source and credential_id are closed."
    },
    {
      "file": "valid-producer-signing-key-refused.json",
      "why": "A refused signing-key move: key ids and the rotation vocabulary."
    },
    {
      "file": "valid-producer-legacy-link-tokens-purged.json",
      "why": "Whole-number counters, zero included, and a run slug."
    },
    {
      "file": "valid-producer-authorize-high-risk-decided.json",
      "why": "The auth.authorize.high_risk_decided row (ops #5530): decision id, the 24-code decision vocabulary, a repository resource, the caller's workload attributes."
    },
    {
      "file": "valid-producer-authorize-delegated-decided.json",
      "why": "The auth.authorize.delegated_decided row: the real actor, the target user as subject, the delegated session as target_kind/target_id, the decision ids."
    },
    {
      "file": "valid-producer-authorize-platform-admin-allowed.json",
      "why": "A platform-admin allow: the wire code is allowed_by_platform_admin and the row carries no decision_internal_reason."
    },
    {
      "file": "valid-legacy-authorize-platform-admin-allowed.json",
      "why": "A stored row from before the wire named the reason: the wire code allowed_by_role and the legacy decision_internal_reason allowed_by_platform_admin. No producer writes decision_internal_reason any more; the schema still admits it for these rows."
    }
  ],
  "reject": [
    {
      "file": "invalid-outcome-absent.json",
      "expect_instance_location": "/",
      "expect_keyword": "required",
      "why": "No outcome."
    },
    {
      "file": "invalid-attributes-absent.json",
      "expect_instance_location": "/",
      "expect_keyword": "required",
      "why": "`attributes` is required (it may be empty)."
    },
    {
      "file": "invalid-outcome-unknown.json",
      "expect_instance_location": "/outcome",
      "expect_keyword": "enum",
      "why": "Outcome is a closed vocabulary; case matters."
    },
    {
      "file": "invalid-attributes-arbitrary-key.json",
      "expect_instance_location": "/attributes",
      "expect_keyword": "additionalProperties",
      "why": "An arbitrary key in audit metadata."
    },
    {
      "file": "invalid-attributes-email.json",
      "expect_instance_location": "/attributes",
      "expect_keyword": "additionalProperties",
      "why": "An email address: a high-cardinality identity."
    },
    {
      "file": "invalid-attributes-access-token.json",
      "expect_instance_location": "/attributes",
      "expect_keyword": "additionalProperties",
      "why": "A token field. Secrets are made unrepresentable, not prohibited."
    },
    {
      "file": "invalid-attributes-credential-secret.json",
      "expect_instance_location": "/attributes",
      "expect_keyword": "additionalProperties",
      "why": "A credential secret value in an audit payload (CHAOS-4934: a secret appears only in the receipt, never in audit metadata)."
    },
    {
      "file": "invalid-attributes-authorization-header.json",
      "expect_instance_location": "/attributes",
      "expect_keyword": "additionalProperties",
      "why": "A header value."
    },
    {
      "file": "invalid-attributes-reason-code-prose.json",
      "expect_instance_location": "/attributes/reason_code",
      "expect_keyword": "enum",
      "why": "A reason code is a stable token, not prose or an address."
    },
    {
      "file": "invalid-top-level-client-ip.json",
      "expect_instance_location": "/",
      "expect_keyword": "additionalProperties",
      "why": "The database column client_ip is not carried: an address is a high-cardinality identity."
    },
    {
      "file": "invalid-event-type-uppercase.json",
      "expect_instance_location": "/event_type",
      "expect_keyword": "pattern",
      "why": "Lowercase dotted names only."
    },
    {
      "file": "invalid-actor-wrong-prefix.json",
      "expect_instance_location": "/actor_principal_id",
      "expect_keyword": "pattern",
      "why": "An actor is a principal id."
    },
    {
      "file": "invalid-policy-revision-negative.json",
      "expect_instance_location": "/policy_revision",
      "expect_keyword": "minimum",
      "why": "Negative."
    },
    {
      "file": "invalid-policy-revision-past-2pow53.json",
      "expect_instance_location": "/policy_revision",
      "expect_keyword": "maximum",
      "why": "2^53+1 as an integer token, RAW TEXT."
    },
    {
      "file": "invalid-attributes-reason-code-secret-shaped.json",
      "expect_instance_location": "/attributes/reason_code",
      "expect_keyword": "enum",
      "why": "A lowercase secret-shaped value fits the old code pattern; the audit reason_code is a closed enum."
    },
    {
      "file": "invalid-attributes-reason-code-unlisted-code.json",
      "expect_instance_location": "/attributes/reason_code",
      "expect_keyword": "enum",
      "why": "A plausible code outside the closed vocabulary."
    },
    {
      "file": "invalid-attributes-target-id-not-uuid.json",
      "expect_instance_location": "/attributes/target_id",
      "expect_keyword": "pattern",
      "why": "An attribute id is the row uuid."
    },
    {
      "file": "invalid-attributes-target-kind-unlisted.json",
      "expect_instance_location": "/attributes/target_kind",
      "expect_keyword": "enum",
      "why": "A closed vocabulary."
    },
    {
      "file": "invalid-attributes-new-role-list-form.json",
      "expect_instance_location": "/attributes/new_role",
      "expect_keyword": "type",
      "why": "A single-member key is a string, not a list."
    },
    {
      "file": "invalid-attributes-changed-fields-empty.json",
      "expect_instance_location": "/attributes/changed_fields",
      "expect_keyword": "minItems",
      "why": "A change names at least one field."
    },
    {
      "file": "invalid-attributes-changed-fields-string.json",
      "expect_instance_location": "/attributes/changed_fields",
      "expect_keyword": "type",
      "why": "A list."
    },
    {
      "file": "invalid-attributes-actions-too-many.json",
      "expect_instance_location": "/attributes/actions",
      "expect_keyword": "maxItems",
      "why": "The registry bounds allowed actions at 64."
    },
    {
      "file": "invalid-attributes-revision-negative.json",
      "expect_instance_location": "/attributes/revision",
      "expect_keyword": "minimum",
      "why": "A revision counter is not negative."
    },
    {
      "file": "invalid-attributes-principal-enabled-false.json",
      "expect_instance_location": "/attributes/principal_enabled",
      "expect_keyword": "enum",
      "why": "Present only when the principal row was enabled."
    },
    {
      "file": "invalid-attributes-credential-class-unlisted.json",
      "expect_instance_location": "/attributes/credential_class",
      "expect_keyword": "enum",
      "why": "A closed set, not a lowercase pattern."
    },
    {
      "file": "invalid-actor-raw-uuid.json",
      "expect_instance_location": "/actor_principal_id",
      "expect_keyword": "pattern",
      "why": "The row holds a bare uuid; the wire form is prefixed."
    },
    {
      "file": "invalid-attributes-decision-reason-code-unlisted.json",
      "expect_instance_location": "/attributes/decision_reason_code",
      "expect_keyword": "enum",
      "why": "The decision reason code is a closed 24-code vocabulary."
    },
    {
      "file": "invalid-attributes-decision-id-malformed.json",
      "expect_instance_location": "/attributes/decision_id",
      "expect_keyword": "pattern",
      "why": "A decision id is dec_ plus 26 characters."
    },
    {
      "file": "invalid-attributes-resource-type-unlisted.json",
      "expect_instance_location": "/attributes/resource_type",
      "expect_keyword": "enum",
      "why": "The resource type is the closed authorization_request.v1 set."
    },
    {
      "file": "invalid-attributes-decision-internal-reason-unlisted.json",
      "expect_instance_location": "/attributes/decision_internal_reason",
      "expect_keyword": "enum",
      "why": "The legacy internal reason is a closed set: one value, allowed_by_platform_admin."
    }
  ],
  "reject_by_client": [
    {
      "file": "client-rejected-policy-revision-decimal-form.json",
      "why": "policy_revision `1.0`: schema-valid, refused by the clients on the raw token."
    },
    {
      "file": "client-rejected-occurred-at-below-utc-range.json",
      "why": "UTC year 0000."
    },
    {
      "file": "client-rejected-occurred-at-impossible-date.json",
      "why": "`2026-02-30`: schema-valid, refused by the clients."
    },
    {
      "file": "client-rejected-aggregate-revision-exponent-form.json",
      "why": "A decimal-form token inside attributes: the guard is not top-level only."
    },
    {
      "file": "client-rejected-revision-decimal-form.json",
      "why": "A decimal-form token for a whole-number attribute: the guard covers every integer member."
    }
  ]
}
