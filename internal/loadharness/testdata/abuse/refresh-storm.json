{
  "base_url": "http://127.0.0.1:8081",
  "targets": [
    {
      "name": "refresh", "method": "POST", "path": "/v1/token/refresh",
      "headers": {"Content-Type": "application/json"},
      "body": "{\"schema_version\":\"refresh-request.v1\",\"refresh_credential\":\"${POOL:AUTH_LOADTEST_REFRESH_POOL}\"}",
      "expect_status": [200, 401], "forbid_5xx": true, "max_error_rate": 0
    }
  ]
}
