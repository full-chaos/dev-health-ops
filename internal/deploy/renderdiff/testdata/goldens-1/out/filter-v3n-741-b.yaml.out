apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app.kubernetes.io/component: collector
    app.kubernetes.io/instance: dev-health
    app.kubernetes.io/name: otel-collector
  name: dev-health-otel-collector
  namespace: dev-health
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/component: collector
      app.kubernetes.io/instance: dev-health
      app.kubernetes.io/name: otel-collector
  strategy:
    type: Recreate
  template:
    metadata:
      annotations:
        checksum/config: d1eb8abf4cc0e970517ecfbdf35443125f61d9c810ca3696edeedb2001e2bc7d
      labels:
        app.kubernetes.io/component: collector
        app.kubernetes.io/instance: dev-health
        app.kubernetes.io/name: otel-collector
    spec:
      automountServiceAccountToken: true
      containers:
      - args:
        - --config=/etc/otelcol/config.yaml
        env:
        - name: K8S_NODE_IP
          valueFrom:
            fieldRef:
              fieldPath: status.hostIP
        - name: CF_ACCESS_CLIENT_ID
          valueFrom:
            secretKeyRef:
              key: CF_ACCESS_CLIENT_ID
              name: otel-collector-signoz
        - name: CF_ACCESS_CLIENT_SECRET
          valueFrom:
            secretKeyRef:
              key: CF_ACCESS_CLIENT_SECRET
              name: otel-collector-signoz
        - name: SIGNOZ_OTLP_HTTP_ENDPOINT
          valueFrom:
            secretKeyRef:
              key: SIGNOZ_OTLP_HTTP_ENDPOINT
              name: otel-collector-signoz
        - name: CLICKHOUSE_QUERYLOG_DSN
          valueFrom:
            secretKeyRef:
              key: CLICKHOUSE_QUERYLOG_DSN
              name: otel-collector-clickhouse
        image: ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector-contrib@sha256:fd328de2552466ad78385e1b1289c3f2402b1c45f265b252aab1955b42845ac1
        imagePullPolicy: IfNotPresent
        livenessProbe:
          httpGet:
            path: /
            port: health
          initialDelaySeconds: 20
          periodSeconds: 20
        name: collector
        ports:
        - containerPort: 4317
          hostPort: 4317
          name: otlp-grpc
          protocol: TCP
        - containerPort: 4318
          hostPort: 4318
          name: otlp-http
          protocol: TCP
        - containerPort: 13133
          name: health
          protocol: TCP
        readinessProbe:
          httpGet:
            path: /
            port: health
          periodSeconds: 10
        resources:
          limits:
            cpu: 500m
            memory: 768Mi
          requests:
            cpu: 50m
            memory: 256Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
        volumeMounts:
        - mountPath: /etc/otelcol
          name: config
          readOnly: true
        - mountPath: /hostfs
          mountPropagation: HostToContainer
          name: hostfs
          readOnly: true
        - mountPath: /var/log/pods
          name: pod-logs
          readOnly: true
        - mountPath: /var/lib/otelcol/storage
          name: pod-logs-storage
        - mountPath: /var/lib/otelcol/clickhouse-querylog
          name: clickhouse-querylog-storage
      securityContext:
        runAsGroup: 10001
        runAsNonRoot: true
        runAsUser: 10001
        seccompProfile:
          type: RuntimeDefault
        supplementalGroups:
        - 0
      serviceAccountName: dev-health-otel-collector
      volumes:
      - configMap:
          name: dev-health-otel-collector
        name: config
      - hostPath:
          path: /
          type: Directory
        name: hostfs
      - hostPath:
          path: /var/log/pods
          type: Directory
        name: pod-logs
      - emptyDir: {}
        name: pod-logs-storage
      - emptyDir: {}
        name: clickhouse-querylog-storage
