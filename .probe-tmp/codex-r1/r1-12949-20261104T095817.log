-SELECT ?, toUUID('00000000-0000-0000-0000-000000000000'), concat('wi-', toString(number)), 'linear', 'team', 'native_team', 1, 'high', 'e', ? FROM numbers(%d)`, attributionRows), orgAlpha, at)
