{
  "schema_version": 1,
  "name": "GitLab CI/CD native route structural closure (CHAOS-3352)",
  "build": ["go", "test", "-run", "^$", "./internal/providersync/", "./cmd/dev-health-worker/"],
  "$limitation": "This plan targets the isolated gitlab/cicd claim and client gates, project binding, intentional maximum window versus incomplete traversal, exact source-precision window membership, missing-created and malformed-status behavior, physical request evidence, accepted failure classification, Python estimator and actual-resolver identity, route readiness, worker activation, duplicate rejection, and tenant-scoped FINAL readback. The live Python oracle separately reflects every CiPipelineRun field and executes the active producer plus its surrounding started_at filter. It does not claim live credentialed GitLab traffic, the separately owned gitlab/tests columns, scheduler activation, schema redesign, migration 0066, deployment, or cutover evidence.",
  "mutations": [
    {
      "id": "C1-claim-provider-guard",
      "file": "internal/providersync/gitlab_cicd_route.go",
      "find": "claim.Provider != \"gitlab\" ||\n\t\tclaim.Dataset != \"cicd\" || client == nil",
      "replace": "false ||\n\t\tclaim.Dataset != \"cicd\" || client == nil",
      "rationale": "a GitHub claim must not enter the GitLab pipeline collector",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabCICDRouteRejectsCrossScopeAndProjectMismatch$/wrong_claim_provider$", "./internal/providersync/"]]
    },
    {
      "id": "C2-claim-dataset-guard",
      "file": "internal/providersync/gitlab_cicd_route.go",
      "find": "claim.Dataset != \"cicd\" || client == nil || client.Provider != \"gitlab\"",
      "replace": "false || client == nil || client.Provider != \"gitlab\"",
      "rationale": "the D16 pipeline collector must not accept another GitLab dataset",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabCICDRouteRejectsCrossScopeAndProjectMismatch$/wrong_claim_dataset$", "./internal/providersync/"]]
    },
    {
      "id": "C3-client-provider-guard",
      "file": "internal/providersync/gitlab_cicd_route.go",
      "find": "client.Provider != \"gitlab\" ||\n\t\tclient.BaseURL == nil",
      "replace": "false ||\n\t\tclient.BaseURL == nil",
      "rationale": "GitLab pipeline requests must use a canonical GitLab client",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabCICDRouteRejectsCrossScopeAndProjectMismatch$/wrong_client_provider$", "./internal/providersync/"]]
    },
    {
      "id": "C4-claimed-project-binding",
      "file": "internal/providersync/gitlab_cicd_route.go",
      "find": "strconv.FormatInt(parsedProjectID, 10) != projectID",
      "replace": "strconv.FormatInt(parsedProjectID, 10) == \"\" && false",
      "rationale": "the fetched project identity must equal the numeric project named by the leased unit",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabCICDRouteRejectsCrossScopeAndProjectMismatch$/project_id_mismatch$", "./internal/providersync/"]]
    },
    {
      "id": "C5-incomplete-traversal-fails-closed",
      "file": "internal/providersync/gitlab_cicd_route.go",
      "find": "page.CapReached && len(page.Items) < maxPipelines",
      "replace": "false",
      "rationale": "a traversal that exhausts its page allowance before filling Python's accepted maximum cannot emit effects or advance its watermark",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabCICDRouteAcceptsFullPythonWindowButRejectsIncompleteTraversal$/incomplete_before_max_window$", "./internal/providersync/"]]
    },
    {
      "id": "C6-intentional-max-window",
      "file": "internal/providersync/gitlab_cicd_route.go",
      "find": "if len(items) > maxPipelines {\n\t\titems = items[:maxPipelines]\n\t}",
      "replace": "if false {\n\t\titems = items[:maxPipelines]\n\t}",
      "rationale": "the accepted Python maximum must still bound emitted pipeline rows when more are advertised",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabCICDRouteAcceptsFullPythonWindowButRejectsIncompleteTraversal$/intentional_max_window$", "./internal/providersync/"]]
    },
    {
      "id": "C7-cap-evidence",
      "file": "internal/providersync/gitlab_cicd_route.go",
      "find": "CapReached: page.CapReached,",
      "replace": "CapReached: false,",
      "rationale": "an accepted maximum-window result must advertise the bound instead of looking like a complete traversal",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabCICDRouteAcceptsFullPythonWindowButRejectsIncompleteTraversal$/intentional_max_window$", "./internal/providersync/"]]
    },
    {
      "id": "C8-lower-window-source-precision",
      "file": "internal/providersync/gitlab_cicd_route.go",
      "find": "createdInstant.Before(since.UTC())",
      "replace": "createdInstant.Truncate(time.Millisecond).Before(since.UTC())",
      "rationale": "source timestamps must be compared before ClickHouse millisecond canonicalization or a value just above since is dropped",
      "proof": [["go", "test", "-count=1", "-run", "^TestNormalizeGitLabCICDPipelinesComparesBoundariesBeforeMillisecondStorage$", "./internal/providersync/"]]
    },
    {
      "id": "C9-upper-window-source-precision",
      "file": "internal/providersync/gitlab_cicd_route.go",
      "find": "startedInstant.After(claim.BeforeAt.UTC())",
      "replace": "startedInstant.Truncate(time.Millisecond).After(claim.BeforeAt.UTC())",
      "rationale": "source started_at must be compared before storage truncation or a value just above before is admitted",
      "proof": [["go", "test", "-count=1", "-run", "^TestNormalizeGitLabCICDPipelinesComparesBoundariesBeforeMillisecondStorage$", "./internal/providersync/"]]
    },
    {
      "id": "C10-missing-created-skip",
      "file": "internal/providersync/gitlab_cicd_route.go",
      "find": "if createdAt == nil {\n\t\t\tcontinue\n\t\t}",
      "replace": "if createdAt == nil {\n\t\t\treturn nil, providerfoundation.ErrNormalizationInvalid\n\t\t}",
      "rationale": "the active Python producer skips a pipeline whose created_at is missing and continues with later rows",
      "proof": [["bash", "ci/check_go.sh", "live-python-oracles"]]
    },
    {
      "id": "C11-malformed-status-fails-closed",
      "file": "internal/providersync/gitlab_cicd_route.go",
      "find": "if !ok {\n\t\t\t\treturn nil, providerfoundation.ErrNormalizationInvalid\n\t\t\t}",
      "replace": "if !ok && false {\n\t\t\t\treturn nil, providerfoundation.ErrNormalizationInvalid\n\t\t\t}",
      "rationale": "a non-string GitLab status cannot be silently normalized into an invented empty string",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabCICDRouteFailsClosedOnBudgetLeaseContextAndMalformedIdentity$/malformed_status$", "./internal/providersync/"]]
    },
    {
      "id": "C12-physical-request-evidence",
      "file": "internal/providersync/gitlab_cicd_route.go",
      "find": "attempts := doer.attempts\n\t*attempts = *attempts + 1",
      "replace": "attempts := doer.attempts\n\t*attempts = *attempts + 0",
      "rationale": "every accepted outcome must count physical project and list attempts, including retries and failed pages",
      "proof": [["go", "test", "-count=1", "-run", "^(TestGitLabCICDRouteClassifiesPythonSoftAndControlPlaneFailures|TestGitLabCICDRouteCountsLaterPageAttemptOnPythonSoftFailure|TestGitLabCICDRouteCountsPhysicalAttemptOnSuccessfulRetry|TestGitLabCICDRouteCountsPhysicalProjectAttemptOnSuccessfulRetry)$", "./internal/providersync/"]]
    },
    {
      "id": "C13-accepted-transient-list-failure",
      "file": "internal/providersync/gitlab_cicd_route.go",
      "find": "providerfoundation.ErrorTransient,\n\t\tproviderfoundation.ErrorPermanent,",
      "replace": "providerfoundation.ErrorClass(\"mutated-transient\"),\n\t\tproviderfoundation.ErrorPermanent,",
      "rationale": "D16 preserves Python's accepted empty result for an ordinary transient pipeline-list failure",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabCICDRouteClassifiesPythonSoftAndControlPlaneFailures$/transient_Python_soft$", "./internal/providersync/"]]
    },
    {
      "id": "C14-joined-soft-leaves",
      "file": "internal/providersync/gitlab_cicd_route.go",
      "find": "providerfoundation.ErrorNotFound,\n\t\tproviderfoundation.ErrorConflict,",
      "replace": "providerfoundation.ErrorClass(\"mutated-not-found\"),\n\t\tproviderfoundation.ErrorConflict,",
      "rationale": "the route-specific shared-classifier allowlist must admit every leaf in an all-provider soft tree while a joined budget leaf remains fatal",
      "proof": [["go", "test", "-count=1", "-run", "^TestGitLabCICDFatalListErrorClassification$/(joined_allowed_provider_leaves|joined_transient_and_budget)$", "./internal/providersync/"]]
    },
    {
      "id": "C15-python-budget-units",
      "file": "internal/providersync/request_plan.go",
      "find": "Dimension: BudgetRESTCore, Units: max(6, 6*spanDays),\n\t\t\tConfidence: \"low\", RouteFamily: \"pipelines\",",
      "replace": "Dimension: BudgetRESTCore, Units: max(5, 5*spanDays),\n\t\t\tConfidence: \"low\", RouteFamily: \"pipelines\",",
      "rationale": "the Go preflight plan must port Python's span-scaled low-confidence six-unit pipeline reservation",
      "proof": [["bash", "ci/check_go.sh", "live-python-oracles"]]
    },
    {
      "id": "C16-python-actual-resolver-identity",
      "file": "internal/providersync/request_plan.go",
      "find": "Confidence: \"low\", RouteFamily: \"pipelines\",",
      "replace": "Confidence: \"low\", RouteFamily: \"mutated-pipelines\",",
      "rationale": "the request plan family and dimension must agree with the actual live GitLab operation resolver used by the pipeline client",
      "proof": [["bash", "ci/check_go.sh", "live-python-oracles"]]
    },
    {
      "id": "C17-route-readiness",
      "file": "internal/providersync/execution_registry.go",
      "find": "\t\tdescriptor.RouteEnabled = switches.GitlabCICD",
      "replace": "\t\tdescriptor.RouteReady = true\n\t\tdescriptor.RouteEnabled = switches.GitlabCICD",
      "rationale": "the partial D16 row must remain unroutable until the companion gitlab/tests port can emit the complete shared ReplacingMergeTree row",
      "proof": [["go", "test", "-count=1", "-run", "^TestProviderMatrixMatchesCheckedInContract$", "./internal/providersync/"]]
    },
    {
      "id": "C18-worker-activation",
      "file": "cmd/dev-health-worker/provider_sync.go",
      "find": "cfg.WorkerGitlabCICDEnabled ||",
      "replace": "false ||",
      "rationale": "enabling only gitlab/cicd must construct the provider-sync worker family",
      "proof": [["go", "test", "-count=1", "-run", "^TestBuildProviderSyncWorkerConstructsForEveryRouteReadySwitch$/gitlab_cicd$", "./cmd/dev-health-worker/"]]
    },
    {
      "id": "C19-duplicate-natural-key-rejection",
      "file": "internal/providersync/gitlab_cicd_effects_clickhouse.go",
      "find": "if _, duplicate := seen[key]; duplicate {",
      "replace": "if _, duplicate := seen[key]; duplicate && false {",
      "rationale": "one atomic effect cannot contain duplicate tenant, repository, and run keys",
      "build": ["go", "test", "-tags", "integration", "-run", "^$", "./internal/providersync/"],
      "proof": [["go", "test", "-count=1", "-tags", "integration", "-run", "^TestGitLabCICDEffectsAreAtomicDeduplicatedTenantScopedAndRetrySafe$", "./internal/providersync/"]]
    },
    {
      "id": "C20-final-readback-tenant-predicate",
      "file": "internal/providersync/gitlab_cicd_effects_clickhouse.go",
      "find": "WHERE org_id = ? AND repo_id = ? AND run_id = ?",
      "replace": "WHERE org_id != ? AND repo_id = ? AND run_id = ?",
      "rationale": "recovery readback must select the owning tenant when identical pipeline natural keys collide",
      "build": ["go", "test", "-tags", "integration", "-run", "^$", "./internal/providersync/"],
      "proof": [["go", "test", "-count=1", "-tags", "integration", "-run", "^TestGitLabCICDEffectsAreAtomicDeduplicatedTenantScopedAndRetrySafe$", "./internal/providersync/"]]
    },
    {
      "id": "C21-active-python-maximum",
      "file": "internal/providersync/gitlab_cicd_route.go",
      "find": "defaultGitLabCICDMaxPipelines = 1_000",
      "replace": "defaultGitLabCICDMaxPipelines = 999",
      "rationale": "the default pipeline window must be derived from the BATCH_SIZE argument at the active Python process_gitlab_project call",
      "proof": [["bash", "ci/check_go.sh", "live-python-oracles"]]
    },
    {
      "id": "C22-successful-retry-request-evidence",
      "file": "internal/providersync/gitlab_cicd_route.go",
      "find": "Requests: requestAttempts, Pages: page.Pages, Records: len(rows),",
      "replace": "Requests: page.Pages + 1, Pages: page.Pages, Records: len(rows),",
      "rationale": "successful project and list retries must report every physical provider attempt consistently with accepted soft failures",
      "proof": [["go", "test", "-count=1", "-run", "^(TestGitLabCICDRouteCountsPhysicalAttemptOnSuccessfulRetry|TestGitLabCICDRouteCountsPhysicalProjectAttemptOnSuccessfulRetry)$", "./internal/providersync/"]]
    }
  ]
}
