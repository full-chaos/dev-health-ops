-func stopDonorTableMerges(t *testing.T, ctx context.Context, conn driver.Conn) {
-	t.Helper()
-	for _, table := range donorTables {
-		mustExec(t, ctx, conn, "SYSTEM STOP MERGES "+table)
-	}
-}
