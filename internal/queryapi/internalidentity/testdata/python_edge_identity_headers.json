{
  "cases": [
    {
      "name": "member",
      "headers": {
        "X-DH-Internal-Org-Id": "org-1",
        "X-DH-Internal-Role": "member",
        "X-DH-Internal-Superuser": "false",
        "X-DH-Internal-Impersonation-Active": "false"
      },
      "expected": {
        "OrgID": "org-1",
        "Role": "member",
        "IsSuperuser": false,
        "ImpersonationActive": false
      }
    },
    {
      "name": "superuser",
      "headers": {
        "X-DH-Internal-Org-Id": "org-1",
        "X-DH-Internal-Role": "owner",
        "X-DH-Internal-Superuser": "true",
        "X-DH-Internal-Impersonation-Active": "false"
      },
      "expected": {
        "OrgID": "org-1",
        "Role": "owner",
        "IsSuperuser": true,
        "ImpersonationActive": false
      }
    },
    {
      "name": "admin",
      "headers": {
        "X-DH-Internal-Org-Id": "11111111-1111-4111-8111-111111111111",
        "X-DH-Internal-Role": "admin",
        "X-DH-Internal-Superuser": "false",
        "X-DH-Internal-Impersonation-Active": "false"
      },
      "expected": {
        "OrgID": "11111111-1111-4111-8111-111111111111",
        "Role": "admin",
        "IsSuperuser": false,
        "ImpersonationActive": false
      }
    },
    {
      "name": "non-ascii org and role",
      "headers": {
        "X-DH-Internal-Org-Id": "org-ü",
        "X-DH-Internal-Role": "rôle-é",
        "X-DH-Internal-Superuser": "false",
        "X-DH-Internal-Impersonation-Active": "false"
      },
      "expected": {
        "OrgID": "org-ü",
        "Role": "rôle-é",
        "IsSuperuser": false,
        "ImpersonationActive": false
      }
    },
    {
      "name": "impersonating",
      "headers": {
        "X-DH-Internal-Org-Id": "org-target",
        "X-DH-Internal-Role": "viewer",
        "X-DH-Internal-Superuser": "false",
        "X-DH-Internal-Impersonation-Active": "true"
      },
      "expected": {
        "OrgID": "org-target",
        "Role": "viewer",
        "IsSuperuser": false,
        "ImpersonationActive": true
      }
    }
  ]
}
