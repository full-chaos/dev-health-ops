{
  "description": "Golden corpus for organization-list.v1. No client-only rule in this corpus: every rule here is a schema rule; the rules a schema cannot say are in golden/read-api.",
  "accept": [
    {
      "file": "valid-first-page.json",
      "why": "A first page: each item pairs an organization with the principal's membership."
    },
    {
      "file": "valid-last-page.json",
      "why": "The last page: no cursor."
    },
    {
      "file": "valid-empty.json",
      "why": "A principal with no organization."
    }
  ],
  "reject": [
    {
      "file": "invalid-item-membership-absent.json",
      "expect_instance_location": "/items/0",
      "expect_keyword": "required",
      "why": "An item pairs both bodies."
    },
    {
      "file": "invalid-item-extra-member.json",
      "expect_instance_location": "/items/0",
      "expect_keyword": "additionalProperties",
      "why": "An item holds the two bodies only."
    },
    {
      "file": "invalid-items-over-100.json",
      "expect_instance_location": "/items",
      "expect_keyword": "maxItems",
      "why": "At most 100 items a page."
    },
    {
      "file": "invalid-next-cursor-empty.json",
      "expect_instance_location": "/next_cursor",
      "expect_keyword": "pattern",
      "why": "An empty cursor says nothing."
    }
  ]
}
