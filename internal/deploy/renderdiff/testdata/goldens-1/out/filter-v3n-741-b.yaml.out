apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app.kubernetes.io/component: query-api
    app.kubernetes.io/instance: dev-health
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/name: ops
    app.kubernetes.io/part-of: dev-health
    app.kubernetes.io/version: 0.1.0
    helm.sh/chart: ops-0.1.0
  name: dev-health-ops-query-api
  namespace: dev-health
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/component: query-api
      app.kubernetes.io/instance: dev-health
      app.kubernetes.io/name: ops
  strategy:
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
    type: RollingUpdate
  template:
    metadata:
      annotations:
        checksum/secret: fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffaae
      labels:
        app.kubernetes.io/component: query-api
        app.kubernetes.io/instance: dev-health
        app.kubernetes.io/name: ops
    spec:
      automountServiceAccountToken: false
      containers:
      - args:
        - query-api
        env:
        - name: QUERY_API_ADDR
          value: :8090
        - name: AUTH_DATABASE_SCHEMA
          value: auth
        - name: AUTH_PROXY_SESSIONS
          value: 'true'
        - name: QUERY_API_MCP_ADDR
          value: :8092
        - name: QUERY_API_MCP_BOUNDARY
          value: networkpolicy
        - name: CLICKHOUSE_URI
          valueFrom:
            secretKeyRef:
              key: CLICKHOUSE_NATIVE_URI
              name: dev-health-ops
        - name: GO_API_REGISTRY_POSTGRES_URI
          valueFrom:
            secretKeyRef:
              key: GO_API_REGISTRY_POSTGRES_URI
              name: dev-health-ops
        - name: GO_API_ENVELOPE_JWKS_PATH
          value: /secrets/envelope-jwks.json
        - name: GO_API_ENVELOPE_ISSUER
          value: dev-health-ops-edge
        - name: GO_API_ENVELOPE_AUDIENCE
          value: query-api
        - name: QUERY_API_DATABASE_ROLE
          value: devhealth_query_api
        - name: OTEL_ENABLED
          value: 'true'
        - name: OTEL_EXPORTER_OTLP_ENDPOINT
          value: http://10.0.0.151:4317
        - name: OTEL_SAMPLE_RATE
          value: '1'
        - name: LLM_PROVIDER
          valueFrom:
            secretKeyRef:
              key: LLM_PROVIDER
              name: dev-health-ops
        - name: OPENAI_API_KEY
          valueFrom:
            secretKeyRef:
              key: OPENAI_API_KEY
              name: dev-health-ops
        - name: LLM_MODEL
          valueFrom:
            secretKeyRef:
              key: LLM_MODEL
              name: dev-health-ops
        - name: LLM_MODEL_EXPLAIN
          valueFrom:
            secretKeyRef:
              key: LLM_MODEL_EXPLAIN
              name: dev-health-ops
              optional: true
        - name: SETTINGS_ENCRYPTION_KEY
          valueFrom:
            secretKeyRef:
              key: SETTINGS_ENCRYPTION_KEY
              name: dev-health-ops
        - name: GO_API_INVESTMENT_EXPLAIN_ENABLED
          value: 'true'
        - name: QUERY_API_INTERNAL_ADDR
          value: :8091
        - name: GO_API_PROOF_WRITE_ROUTE_ENABLED
          value: 'true'
        - name: GO_API_QUADRANT_ENABLED
          value: 'true'
        - name: GO_API_FILTER_OPTIONS_ENABLED
          value: 'true'
        - name: GO_API_DRILLDOWN_PRS_ENABLED
          value: 'true'
        - name: GO_API_DRILLDOWN_ISSUES_ENABLED
          value: 'true'
        - name: GO_API_META_ENABLED
          value: 'true'
        - name: GO_API_EXPLAIN_ENABLED
          value: 'true'
        - name: GO_API_PEOPLE_SEARCH_ENABLED
          value: 'true'
        - name: GO_API_PEOPLE_SUMMARY_ENABLED
          value: 'true'
        - name: GO_API_PEOPLE_METRIC_ENABLED
          value: 'true'
        - name: GO_API_FLAME_ENABLED
          value: 'true'
        - name: GO_API_PEOPLE_DRILLDOWN_PRS_ENABLED
          value: 'true'
        - name: GO_API_PEOPLE_DRILLDOWN_ISSUES_ENABLED
          value: 'true'
        - name: GO_API_FLAME_AGGREGATED_ENABLED
          value: 'true'
        - name: GO_API_HEATMAP_ENABLED
          value: 'true'
        - name: GO_API_SANKEY_ENABLED
          value: 'true'
        - name: GO_API_INVESTMENT_ENABLED
          value: 'true'
        - name: GO_API_INVESTMENT_FLOW_ENABLED
          value: 'true'
        - name: GO_API_INVESTMENT_SUNBURST_ENABLED
          value: 'true'
        - name: GO_API_HOME_ENABLED
          value: 'true'
        - name: GO_API_OPPORTUNITIES_ENABLED
          value: 'true'
        - name: GO_API_WORK_UNITS_ENABLED
          value: 'true'
        - name: GO_API_WORK_UNIT_EXPLAIN_ENABLED
          value: 'true'
        - name: GO_API_EDGE_JWT_SECRET
          valueFrom:
            secretKeyRef:
              key: JWT_SECRET_KEY
              name: dev-health-hs256
        - name: CORS_ALLOWED_ORIGINS
          valueFrom:
            secretKeyRef:
              key: CORS_ALLOWED_ORIGINS
              name: dev-health-ops
        image: ghcr.io/full-chaos/dev-health-go-dho@sha256:7ddfb0f85e5aba9f89782f0007f292a7513c668d3e401c1e60805ac13e89a75c
        imagePullPolicy: IfNotPresent
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /readyz
            port: http
          initialDelaySeconds: 10
          periodSeconds: 15
          timeoutSeconds: 2
        name: query-api
        ports:
        - containerPort: 8090
          name: http
          protocol: TCP
        - containerPort: 8092
          name: mcp
          protocol: TCP
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /readyz
            port: http
          initialDelaySeconds: 5
          periodSeconds: 10
          timeoutSeconds: 2
        resources:
          limits:
            cpu: '1'
            memory: 2Gi
          requests:
            cpu: 25m
            memory: 512Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
          runAsGroup: 65532
          runAsNonRoot: true
          runAsUser: 65532
          seccompProfile:
            type: RuntimeDefault
        volumeMounts:
        - mountPath: /secrets/envelope-jwks.json
          name: envelope-jwks
          readOnly: true
          subPath: envelope-jwks.json
      imagePullSecrets:
