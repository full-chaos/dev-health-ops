            "description": "dev_health_api_shadow_enabled (latest). 1 = the shadow PDP runs.",
            "name": "Shadow enabled"
          },
          "links": null,
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
