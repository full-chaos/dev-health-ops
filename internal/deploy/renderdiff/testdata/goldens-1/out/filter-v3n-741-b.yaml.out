apiVersion: batch/v1
kind: Job
metadata:
  annotations:
    helm.sh/hook: post-install,pre-upgrade,pre-rollback
    helm.sh/hook-delete-policy: before-hook-creation
    helm.sh/hook-weight: '10'
  labels:
    app.kubernetes.io/component: river-migrate
    app.kubernetes.io/instance: dev-health
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/name: ops
    app.kubernetes.io/part-of: dev-health
    app.kubernetes.io/version: 0.1.0
    helm.sh/chart: ops-0.1.0
  name: dev-health-ops-river-migrate
  namespace: dev-health
spec:
  activeDeadlineSeconds: 1800
  backoffLimit: 2
  template:
    metadata:
      labels:
        app.kubernetes.io/component: river-migrate
        app.kubernetes.io/instance: dev-health
        app.kubernetes.io/name: ops
    spec:
      automountServiceAccountToken: false
      containers:
      - args:
        - migrate
        - river
        - --apply-and-check
        env:
        - name: RIVER_DATABASE_SCHEMA
          value: river
        - name: RIVER_DOMAIN_DATABASE_ROLE
          value: devhealth_domain
        - name: RIVER_QUEUE_DATABASE_ROLE
          value: devhealth_queue
        - name: RIVER_COORDINATOR_DATABASE_ROLE
          value: devhealth_coordinator
        - name: QUERY_API_DATABASE_ROLE
          value: devhealth_query_api
        - name: AUTH_DATABASE_SCHEMA
          value: auth
        - name: AUTH_PROXY_SESSIONS
          value: 'true'
        envFrom:
        - secretRef:
            name: dev-health-ops-migrate
        image: ghcr.io/full-chaos/dev-health-go-operator@sha256:fa9b7cd250de6f5f2f86646427b7e16454cbebf8cef4db5225932aaa51640ca3
        imagePullPolicy: IfNotPresent
        name: river-migrate
        resources:
          limits:
            cpu: 500m
            memory: 1Gi
          requests:
            cpu: 100m
            memory: 256Mi
        securityContext:
          allowPrivilegeEscalation: false
      imagePullSecrets:
      - name: ghcr-pull
      restartPolicy: Never
      securityContext:
        runAsNonRoot: true
