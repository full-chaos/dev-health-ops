        - name: RIVER_DOMAIN_DATABASE_ROLE
          value: devhealth_domain
        - name: RIVER_QUEUE_DATABASE_ROLE
          value: devhealth_queue
        - name: RIVER_COORDINATOR_DATABASE_ROLE
          value: devhealth_coordinator
        - name: RIVER_DOMAIN_DATABASE_PASSWORD
          valueFrom:
            secretKeyRef:
              key: RIVER_DOMAIN_DATABASE_PASSWORD
              name: dev-health-ops-go-pgbouncer
        - name: RIVER_QUEUE_DATABASE_PASSWORD
          valueFrom:
            secretKeyRef:
              key: RIVER_QUEUE_DATABASE_PASSWORD
              name: dev-health-ops-go-pgbouncer
        - name: RIVER_COORDINATOR_DATABASE_PASSWORD
          valueFrom:
            secretKeyRef:
              key: RIVER_COORDINATOR_DATABASE_PASSWORD
              name: dev-health-ops-go-pgbouncer
        - name: RIVER_KEDA_READONLY_DATABASE_ROLE
          value: devhealth_keda_readonly
        - name: RIVER_DATABASE_SCHEMA
          value: river
        - name: RIVER_KEDA_READONLY_PASSWORD
          valueFrom:
            secretKeyRef:
              key: RIVER_KEDA_READONLY_PASSWORD
              name: dev-health-ops-go-pgbouncer
        envFrom:
        - secretRef:
            name: dev-health-ops-migrate
        image: ghcr.io/full-chaos/dev-health-go-operator@sha256:fa9b7cd250de6f5f2f86646427b7e16454cbebf8cef4db5225932aaa51640ca3
        imagePullPolicy: IfNotPresent
        name: provision-roles
        resources:
          limits:
            cpu: 500m
            memory: 1Gi
          requests:
            cpu: 100m
            memory: 256Mi
        securityContext:
          allowPrivilegeEscalation: false
      imagePullSecrets:
      - name: ghcr-pull
      restartPolicy: Never
      securityContext:
        runAsNonRoot: true
