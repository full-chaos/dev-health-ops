{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.fullchaos.dev/jobs/v1/schemas/sync.bucket_sweep.v1.schema.json",
  "title": "sync.bucket_sweep payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["org_id", "provider", "cost_class"],
  "properties": {
    "org_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "provider": {
      "type": "string",
      "enum": ["github", "gitlab", "jira", "launchdarkly", "linear", "pagerduty"]
    },
    "cost_class": {
      "type": "string",
      "enum": ["light", "medium", "heavy"]
    }
  }
}
