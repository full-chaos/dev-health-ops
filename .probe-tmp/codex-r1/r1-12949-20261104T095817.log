     1	package investment
     2	
     3	// repoattribution.go wires CHAOS-5458's per-run repo-attribution telemetry.
     4	//
     5	// materialize.go's "investment repo attribution" log line already computes
     6	// this partition every run; before this file, it was written to the log and
     7	// nowhere else -- "is repo attribution degrading" could only be answered by
     8	// grepping worker logs across a fleet, and even then the team-fallback half
     9	// of the partition (CHAOS-5460) lived in a SEPARATE log line ("investment
    10	// team repository fallback"), correlated only by run_id. This exposes the
    11	// SAME partition as a single Prometheus counter.
    12	
    13	import (
    14		"github.com/full-chaos/dev-health-ops/internal/jobruntime"
    15	)
    16	
    17	// RepoAttributionSource is the closed vocabulary the
    18	// dev_health_investment_repo_attribution_total counter's `source` label
    19	// takes. Mirrors jobruntime.InvestmentRepoAttributionSource's string values
    20	// as a distinct type in this package -- the codebase's standing convention
    21	// (see jobruntime's TeamRepoOwnershipResolutionArm doc comment) for a label
    22	// vocabulary a lower-level telemetry package must not import the producing
    23	// package to share.
    24	type RepoAttributionSource string
    25	
    26	const (
    27		RepoAttributionSourceOwn        RepoAttributionSource = "own"
    28		RepoAttributionSourceAncestor   RepoAttributionSource = "ancestor"
    29		RepoAttributionSourceChildren   RepoAttributionSource = "children"
    30		RepoAttributionSourceUnassigned RepoAttributionSource = "unassigned"
    31	)
    32	
    33	// RepoAttributionCounts partitions every component ONE run materialized by
    34	// how (or whether) its repository was resolved. Own + Ancestor + Children +
    35	// Unassigned always sum to the run's Components. There is no team bucket: a
    36	// unit with no repository evidence is unassigned (CHAOS-12949, chris: "Drop
    37	// fallback"); a team's repositories are never a unit's repository.
    38	type RepoAttributionCounts struct {
    39		Own, Ancestor, Children, Unassigned int
    40	}
    41	
    42	// RepoAttributionCountsFromStats derives the closed 4-way partition from a
    43	// completed run's Stats.
    44	func RepoAttributionCountsFromStats(stats Stats) RepoAttributionCounts {
    45		return RepoAttributionCounts{
    46			Own:        stats.RepoCascadeOwn,
    47			Ancestor:   stats.RepoCascadeAncestor,
    48			Children:   stats.RepoCascadeChildren,
    49			Unassigned: stats.RepoCascadeUnassigned,
    50		}
    51	}
    52	
    53	// RepoAttributionObserver receives one run's closed repo-attribution
    54	// partition. A narrow interface, same pattern as remaining.MembershipObserver,
    55	// so Materializer.Run and NativeExecutor.Execute stay free of the telemetry
    56	// package's shape.
    57	type RepoAttributionObserver interface {
    58		ObserveRepoAttribution(RepoAttributionCounts)
    59	}
    60	
    61	// CollectorRepoAttributionObserver adapts the metrics collector to
    62	// RepoAttributionObserver -- same pattern as
    63	// remaining.CollectorMembershipObserver. Every source is reported on every
    64	// call, including zero, matching
    65	// jobruntime.InvestmentRepoAttributionObserver's contract.
    66	type CollectorRepoAttributionObserver struct {
    67		Collector *jobruntime.MetricsCollector
    68	}
    69	
    70	func (observer CollectorRepoAttributionObserver) ObserveRepoAttribution(counts RepoAttributionCounts) {
    71		if observer.Collector == nil {
    72			return
    73		}
    74		pairs := []struct {
    75			source jobruntime.InvestmentRepoAttributionSource
    76			count  int
    77		}{
    78			{jobruntime.InvestmentRepoAttributionSourceOwn, counts.Own},
    79			{jobruntime.InvestmentRepoAttributionSourceAncestor, counts.Ancestor},
    80			{jobruntime.InvestmentRepoAttributionSourceChildren, counts.Children},
    81			{jobruntime.InvestmentRepoAttributionSourceUnassigned, counts.Unassigned},
    82		}
    83		for _, pair := range pairs {
    84			_ = observer.Collector.ObserveInvestmentRepoAttribution(pair.source, pair.count)
    85		}
    86	}
