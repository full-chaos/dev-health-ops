apiVersion: v1
data:
  API_HOST: 0.0.0.0
  API_PORT: '8000'
  AUTO_RUN_MIGRATIONS: 'false'
  BATCH_SIZE: '100'
  GITHUB_APP_ID: ''
  GITHUB_APP_INSTALLATION_ID: ''
  GITHUB_APP_PRIVATE_KEY_PATH: <redacted>
  GITHUB_BASE_URL: https://api.github.com
  GITHUB_FETCH_COMMENTS: 'true'
  GITHUB_FETCH_MILESTONES: 'true'
  GITHUB_INCLUDE_PRS: 'true'
  GITHUB_LINEAR_LINKBACK_BOTS: linear[bot]
  GITLAB_URL: https://gitlab.com
  GO_API_PLANE_HEADER_ENABLED: ''
  GO_API_QUERY_API_URL: http://dev-health-ops-query-api:8090
  GRAPHQL_QUERY_TIMEOUT: '30'
  HIDE_MIGRATED_CHILD_CONFIGS: 'true'
  JIRA_FETCH_COMMENTS: '1'
  JIRA_TRUSTED_SCM_HOSTS: ''
  LINEAR_BACKFILL_MAX_WINDOW_DAYS: '14'
  LINEAR_TRUSTED_SCM_HOSTS: ''
  LOG_LEVEL: INFO
  MAX_WORKERS: '4'
  OTEL_ENABLED: 'true'
  OTEL_EXPORTER_OTLP_ENDPOINT: http://10.0.0.151:4317
  OTEL_METRIC_EXPORT_INTERVAL: '60000'
  OTEL_SERVICE_NAME: dev-health-ops
  PROVIDER_SYNC_QUEUES_ENABLED: 'true'
  REDIS_URL: redis://dev-health-ops-valkey:6379/1
  RIVER_COORDINATOR_DATABASE_ROLE: devhealth_coordinator
  RIVER_DATABASE_SCHEMA: river
  RIVER_DOMAIN_DATABASE_ROLE: devhealth_domain
  RIVER_KEDA_READONLY_DATABASE_ROLE: devhealth_keda_readonly
  RIVER_QUEUE_DATABASE_ROLE: devhealth_queue
  SYNC_BUDGET_BUCKET_LIMITS: '{"github:rest_core":250,"github:graphql_cost":500,"github:contents_blob":100,"github:secondary_abuse_risk":25,"linear:graphql_cost":500}'
  SYNC_BUDGET_DEFAULT_LIMIT: '1000000'
  SYNC_BUDGET_DEFERRAL_JITTER_SECONDS: '5'
  SYNC_BUDGET_DEFERRAL_SECONDS: '60'
  SYNC_BUDGET_DRY_RUN_DEFAULT_LIMIT: '1000000'
  SYNC_BUDGET_DRY_RUN_DEFERRAL_SECONDS: '60'
  SYNC_COST_CLASS_QUEUES: 'true'
  SYNC_DISPATCH_REDISPATCH_COUNTDOWN: '10'
  SYNC_OUTBOX_CLAIM_TIMEOUT_SECONDS: '300'
  SYNC_UNIT_CONCURRENCY_PER_BUCKET: '8'
  SYNC_UNIT_DISPATCH_STALE_SECONDS: '900'
  SYNC_UNIT_EXPIRED_LEASE_MAX_RETRIES: '1'
  SYNC_UNIT_EXPIRED_LEASE_RETRY_BACKOFF_SECONDS: '60'
  SYNC_UNIT_RUNNING_STALE_SECONDS: '3600'
  SYNC_UNRECLAIMABLE_SWEEP: active
  SYNC_WATERMARK_OVERLAP: '0'
  VALKEY_URI: <redacted>
kind: ConfigMap
metadata:
  annotations:
    helm.sh/hook: post-install,pre-upgrade
    helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
    helm.sh/hook-weight: '-5'
  labels:
    app.kubernetes.io/component: migrate
    app.kubernetes.io/instance: dev-health
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/name: ops
    app.kubernetes.io/part-of: dev-health
    app.kubernetes.io/version: 0.1.0
    helm.sh/chart: ops-0.1.0
  name: dev-health-ops-migrate-config
  namespace: dev-health
---
apiVersion: batch/v1
kind: Job
metadata:
  annotations:
    helm.sh/hook: post-install,pre-upgrade
    helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
    helm.sh/hook-weight: '1'
  labels:
    app.kubernetes.io/component: auth-migrate
    app.kubernetes.io/instance: dev-health
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/name: ops
    app.kubernetes.io/part-of: dev-health
    app.kubernetes.io/version: 0.1.0
    helm.sh/chart: ops-0.1.0
  name: dev-health-ops-auth-grants
  namespace: dev-health
spec:
  activeDeadlineSeconds: 600
  backoffLimit: 0
  template:
    metadata:
      labels:
        app.kubernetes.io/component: auth-migrate
        app.kubernetes.io/instance: dev-health
        app.kubernetes.io/name: ops
    spec:
      automountServiceAccountToken: false
      containers:
      - args:
        - grants
        env:
        - name: AUTH_MIGRATION_DATABASE_URI
          valueFrom:
            secretKeyRef:
              key: AUTH_MIGRATION_DATABASE_URI
              name: auth-migrate-database
        - name: AUTH_DATABASE_SCHEMA
          value: auth
        - name: AUTH_RUNTIME_DATABASE_ROLE
          value: devhealth_auth
        image: ghcr.io/full-chaos/dev-health-go-auth-migrate@sha256:fb85ad259e765ac43f67e49b8d7c0c7e330da947dda46e5b2c81bc1380d845c7
        imagePullPolicy: IfNotPresent
        name: auth-grants
        resources:
          limits:
            cpu: 250m
            memory: 128Mi
          requests:
            cpu: 20m
            memory: 32Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
          runAsGroup: 65532
          runAsNonRoot: true
          runAsUser: 65532
          seccompProfile:
            type: RuntimeDefault
      imagePullSecrets:
      - name: ghcr-pull
      restartPolicy: Never
      securityContext:
        runAsGroup: 65532
        runAsNonRoot: true
        runAsUser: 65532
        seccompProfile:
          type: RuntimeDefault
---
