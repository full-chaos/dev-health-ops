{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fullchaos.dev/contracts/auth/v1/jsonschema/credential-entry.v1.schema.json",
  "title": "Auth Control Plane credential registry entry (v1 wire format)",
  "description": "One registry entry; also what POST /v1/credentials/{id}/revoke returns (status revoked). Secret values are returned ONCE (TRD section 12), by the receipt schema only. This schema describes registry METADATA: owner, class, domain authority, audiences, scopes, fingerprint and display prefix, status, timestamps and rotation lineage. A secret is unrepresentable here, not merely optional: the object is closed and has no secret, hash or token member. The members are the columns of credential_registry (migration 0003 plus 0007) minus the secret-bearing secret_hash and hash_algorithm, plus the derived status; TestCredentialEntryMatchesTheRegistryColumnsInBothDirections derives both sets from the migrations and fails on any difference. Scope: ACR and External Push credentials appear only as metadata projections (ACP-ADR-08/09).",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "principal_id",
    "credential_class",
    "display_prefix",
    "domain_owner",
    "audiences",
    "scopes",
    "status",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "credential-entry.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^crd_[A-Za-z0-9_-]{1,64}$",
      "description": "Server-minted credential id (the registry row's id). New prefix introduced by this contract."
    },
    "principal_id": {
      "type": "string",
      "pattern": "^prn_[A-Za-z0-9_-]{1,64}$",
      "description": "The principal the credential authenticates."
    },
    "credential_class": {
      "enum": [
        "acr_client_credential",
        "acr_device_flow_code",
        "acr_web_assertion",
        "acr_workload_identity_exchange",
        "auth_js_browser_session",
        "effective_principal_envelope",
        "email_verification_token",
        "external_push_ingest_token",
        "github_app_installation_token",
        "github_webhook_signature",
        "gitlab_webhook_signature",
        "impersonation_session",
        "infrastructure_deployment_credentials",
        "internal_svc_acr_token",
        "internal_svc_authsess_token",
        "internal_svc_worker_token",
        "jira_webhook_signature",
        "legacy_ingest_api_key",
        "legacy_ingest_hmac_signature",
        "license_key",
        "llm_api_keys",
        "ops_access_token_hs256",
        "ops_refresh_token",
        "org_context_header",
        "org_invite_token",
        "pagerduty_oauth_credential",
        "password_reset_token",
        "refresh_credential",
        "social_oauth_exchange",
        "sso_oidc_exchange",
        "sso_saml_exchange",
        "stripe_webhook_signature",
        "user_access_token",
        "worker_operational_bridge_token",
        "workload_token"
      ],
      "description": "The platform's closed credential-class vocabulary, the same enum principal.v1 carries; a test fails if the two drift."
    },
    "display_prefix": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]{0,16}$",
      "description": "The ONLY fragment of a secret that may appear anywhere but the one-time receipt: at most 16 characters, pinned by the schema rather than left to a producer. Not secret, not sufficient to authenticate."
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "Non-secret fingerprint of the credential's public identifier: 16 lowercase hex characters. Required on a new credential (receipts); absent only on rows that predate migration 0007."
    },
    "domain_owner": {
      "enum": [
        "platform",
        "acr",
        "external_push"
      ],
      "description": "Which validator owns the credential. ACR and External Push keep their domain validators (ACP-ADR-08/09): this is a metadata projection, never a second validator or writer."
    },
    "external_reference": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "description": "The domain system's own id for a projected credential. Opaque; present exactly when domain_owner is not platform."
    },
    "audiences": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._:-]{0,63}$"
      },
      "description": "Exact audiences; a set."
    },
    "scopes": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(:[a-z][a-z0-9_]*)+$",
        "maxLength": 64
      },
      "description": "Scopes in principal.v1's shape (colon-separated); a set."
    },
    "rotation_parent_id": {
      "type": "string",
      "pattern": "^crd_[A-Za-z0-9_-]{1,64}$",
      "description": "The credential this one rotated from (TRD section 12). Required on a rotate receipt, absent on an issue receipt."
    },
    "status": {
      "enum": [
        "active",
        "expired",
        "revoked"
      ],
      "description": "DERIVED, not stored: revoked_at set -> revoked; else expires_at <= now -> expired; else active. The schema pins status to the timestamps' shape; the comparison with the clock is a client rule."
    },
    "created_at": {
      "type": "string",
      "pattern": "^([0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?(Z|[+-](0[0-9]|1[0-9]|2[0-3]):[0-5][0-9])$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^([0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?(Z|[+-](0[0-9]|1[0-9]|2[0-3]):[0-5][0-9])$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^([0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?(Z|[+-](0[0-9]|1[0-9]|2[0-3]):[0-5][0-9])$"
    },
    "last_used_at": {
      "type": "string",
      "pattern": "^([0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?(Z|[+-](0[0-9]|1[0-9]|2[0-3]):[0-5][0-9])$"
    },
    "revoked_at": {
      "type": "string",
      "pattern": "^([0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?(Z|[+-](0[0-9]|1[0-9]|2[0-3]):[0-5][0-9])$"
    },
    "revoked_reason": {
      "type": "string",
      "enum": [
        "compromised",
        "owner_request"
      ],
      "description": "A reason code from a CLOSED vocabulary (contracts/auth/v1/vocabulary/reason-codes.json), never prose: the database column is free text, the wire form is not. A pattern would admit a secret-shaped lowercase value, so the set is an enum. A new value arrives with the producer that emits it and its own migration."
    },
    "created_by": {
      "type": "string",
      "pattern": "^prn_[A-Za-z0-9_-]{1,64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "domain_owner": {
            "const": "platform"
          }
        },
        "required": [
          "domain_owner"
        ]
      },
      "then": {
        "not": {
          "required": [
            "external_reference"
          ],
          "properties": {
            "external_reference": {}
          }
        }
      },
      "else": {
        "required": [
          "external_reference"
        ],
        "properties": {
          "external_reference": {}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "revoked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "revoked_at",
          "revoked_reason"
        ],
        "properties": {
          "revoked_at": {},
          "revoked_reason": {}
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "revoked_at"
              ]
            },
            {
              "required": [
                "revoked_reason"
              ]
            }
          ],
          "properties": {
            "revoked_at": {},
            "revoked_reason": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "expired"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "expires_at"
        ],
        "properties": {
          "expires_at": {}
        }
      }
    }
  ]
}
