apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app.kubernetes.io/component: web
    app.kubernetes.io/instance: dev-health
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/name: ops
    app.kubernetes.io/part-of: dev-health
    app.kubernetes.io/version: 0.1.0
    helm.sh/chart: ops-0.1.0
  name: dev-health-ops-web
  namespace: dev-health
spec:
  selector:
    matchLabels:
      app.kubernetes.io/component: web
      app.kubernetes.io/instance: dev-health
      app.kubernetes.io/name: ops
  strategy:
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
    type: RollingUpdate
  template:
    metadata:
      labels:
        app.kubernetes.io/component: web
        app.kubernetes.io/instance: dev-health
        app.kubernetes.io/name: ops
    spec:
      automountServiceAccountToken: false
      containers:
      - env:
        - name: HOSTNAME
          value: '::'
        - name: BACKEND_URL
          value: http://ingress-nginx-controller.ingress-nginx.svc.cluster.local
        - name: AUTH_SECRET
          valueFrom:
            secretKeyRef:
              key: AUTH_SECRET
              name: dev-health-web-auth
        - name: NODE_ENV
          value: production
        - name: REDIS_URL
          value: redis://dev-health-ops-valkey:6379/1
        - name: TRUST_PROXY
          value: 'true'
        - name: TRUSTED_PROXY_HOPS
          value: '1'
        - name: AUTH_URL
          value: https://www.fullchaos.dev
        - name: AUTH_GITHUB_ID
          valueFrom:
            secretKeyRef:
              key: GITHUB_APP_CLIENT_ID
              name: dev-health-ops
              optional: true
        - name: AUTH_GITHUB_SECRET
          valueFrom:
            secretKeyRef:
              key: GITHUB_APP_CLIENT_SECRET
              name: dev-health-ops
              optional: true
        - name: AUTH_GOOGLE_ID
          valueFrom:
            secretKeyRef:
              key: GOOGLE_CLIENT_ID
              name: dev-health-ops
              optional: true
        - name: AUTH_GOOGLE_SECRET
          valueFrom:
            secretKeyRef:
              key: GOOGLE_CLIENT_SECRET
              name: dev-health-ops
              optional: true
        - name: ACR_API_ORIGIN
          value: http://dev-health-acr.dev-health.svc.cluster.local:8080
        - name: ACR_WEB_ASSERTION_ISSUER
          value: https://www.fullchaos.dev
        - name: ACR_WEB_ASSERTION_AUDIENCE
          value: acr-api
        - name: ACR_WEB_ASSERTION_KID
          value: web-2026-09
        - name: ACR_WEB_ASSERTION_KEY_FILE
          value: /var/run/acr/web-assertion/web-assertion.pem
        image: ghcr.io/full-chaos/dev-health-web@sha256:228c3e9bd0506492c538a68d992f87634e4523130089272cb086a6c96b2be5bd
        imagePullPolicy: IfNotPresent
        livenessProbe:
          httpGet:
            path: /health
            port: http
          initialDelaySeconds: 30
          periodSeconds: 10
        name: web
        ports:
        - containerPort: 3000
          name: http
          protocol: TCP
        readinessProbe:
          httpGet:
            path: /health
            port: http
          initialDelaySeconds: 5
          periodSeconds: 5
        resources:
          limits:
            cpu: '1'
            memory: 512Mi
          requests:
            cpu: 50m
            memory: 256Mi
        volumeMounts:
        - mountPath: /var/run/acr/web-assertion/web-assertion.pem
          name: acr-web-assertion-key
          readOnly: true
          subPath: web-assertion.pem
      imagePullSecrets:
      - name: ghcr-pull
      serviceAccountName: dev-health-ops-web
      volumes:
      - name: acr-web-assertion-key
        secret:
          defaultMode: 256
          items:
          - key: web-assertion.pem
            path: web-assertion.pem
          secretName: acr-web-assertion-key
