apiVersion: keda.sh/v1alpha1
kind: ScaledObject
metadata:
  labels:
    app.kubernetes.io/component: go-worker-keda
    app.kubernetes.io/instance: dev-health
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/name: ops
    app.kubernetes.io/part-of: dev-health
    app.kubernetes.io/version: 0.1.0
    dev-health.io/worker-group: heavy
    helm.sh/chart: ops-0.1.0
  name: dev-health-ops-go-heavy
  namespace: dev-health
spec:
  advanced:
    horizontalPodAutoscalerConfig:
      behavior:
        scaleDown:
          stabilizationWindowSeconds: 600
  cooldownPeriod: 600
  maxReplicaCount: 3
  minReplicaCount: 1
  pollingInterval: 30
  scaleTargetRef:
    name: dev-health-ops-go-heavy
  triggers:
  - authenticationRef:
      name: dev-health-ops-go-worker-river-ro
    metadata:
      dbName: placeholder
      host: dev-health-ops-go-pgbouncer-transaction.dev-health.svc.cluster.local
      port: '6432'
      query: SELECT count(*) FROM river.river_job WHERE queue IN ('investment','metrics','reports','workgraph')
        AND state IN ('available', 'scheduled', 'retryable') AND (scheduled_at IS
        NULL OR scheduled_at <= now())
      sslmode: disable
      targetQueryValue: '10'
      userName: devhealth_keda_readonly
    type: postgresql
---
