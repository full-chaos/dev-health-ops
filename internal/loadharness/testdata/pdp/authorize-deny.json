{
  "base_url": "http://127.0.0.1:8095",
  "targets": [
    {
      "name": "authorize-deny",
      "method": "POST",
      "path": "/v1/authorize",
      "weight": 1,
      "headers": {
        "Content-Type": "application/json"
      },
      "header_env": {
        "Authorization": {
          "env": "AUTH_LOADTEST_WORKLOAD_TOKEN",
          "prefix": "Bearer "
        }
      },
      "body": "{\"schema_version\":\"authorization_request.v1\",\"principal_reference\":\"${ENV:AUTH_LOADTEST_PRINCIPAL_REFERENCE}\",\"action\":\"admin.users\",\"resource\":{\"type\":\"platform\",\"key\":\"platform\"},\"context\":{\"request_id\":\"req_LOADTEST0000000000000PDP01\",\"client_service\":\"dev-health-ops-api\"}}",
      "expect_status": [
        200
      ],
      "forbid_5xx": true,
      "max_error_rate": 0
    }
  ]
}
