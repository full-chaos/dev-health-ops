{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "rollingUpdate": {
      "type": "object",
      "description": "Deployment strategy.rollingUpdate parameters (CHAOS-6647): maxSurge and maxUnavailable, each a non-negative integer or a percentage string; empty keeps the chart default {maxUnavailable: 0, maxSurge: 1}. Kubernetes rejects both being 0, and this schema refuses that too.",
      "properties": {
        "maxSurge": { "oneOf": [ { "type": "integer", "minimum": 0 }, { "type": "string", "pattern": "^[0-9]+%$" } ] },
        "maxUnavailable": { "oneOf": [ { "type": "integer", "minimum": 0 }, { "type": "string", "pattern": "^[0-9]+%$" } ] }
      },
      "additionalProperties": false
    },
    "envFromEntry": {
      "type": "object",
      "description": "One Kubernetes envFrom source: exactly one of configMapRef or secretRef, each carrying only a Secret/ConfigMap name -- matches the shape go-workers.yaml builds for their own two hardcoded entries, so an extraEnvFrom entry can't carry a key (e.g. a typo'd field) the chart would silently drop when it toYaml's the combined list.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "configMapRef": {
              "type": "object",
              "properties": { "name": { "type": "string" } },
              "required": ["name"],
              "additionalProperties": false
            }
          },
          "required": ["configMapRef"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "secretRef": {
              "type": "object",
              "properties": { "name": { "type": "string" } },
              "required": ["name"],
              "additionalProperties": false
            }
          },
          "required": ["secretRef"],
          "additionalProperties": false
        }
      ]
    },
    "extraEnvFrom": {
      "type": "array",
      "items": { "$ref": "#/definitions/envFromEntry" }
    }
  },
  "properties": {
    "goApi": {
      "type": "object",
      "properties": {
        "drain": {
          "description": "CHAOS-10718: seconds the old go-api pod keeps serving before SIGTERM (native preStop sleep, Kubernetes >= 1.30). 0 renders no hook.",
          "type": "object",
          "properties": { "preStopSeconds": { "type": "integer", "minimum": 0, "maximum": 600 } }
        },
        "sessionIssue": {
          "description": "CHAOS-11217: the Secret and key go-api reads AUTH_SESSION_ISSUE_TOKEN from. Empty secretName keeps the shared Secret.",
          "type": "object",
          "additionalProperties": false,
          "required": ["secretName", "secretKey"],
          "properties": {
            "secretName": { "type": "string", "maxLength": 253, "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$" },
            "secretKey": { "type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,252}$" }
          }
        },
        "shutdownTimeout": { "type": "string", "pattern": "^[1-9][0-9]{0,4}s$" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "authProxy": {
          "description": "CHAOS-10231: the /api/v1/auth/* proxy flags. YAML booleans only: a string such as \"false\" is refused, never read as on.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sessions": { "type": "boolean" },
            "localLogin": { "type": "boolean" },
            "credentials": { "type": "boolean" },
            "social": { "type": "boolean" },
            "oidc": { "type": "boolean" },
            "saml": { "type": "boolean" }
          }
        }
      }
    },
    "migrations": {
      "type": "object",
      "properties": {
        "hook": {
          "type": "object",
          "properties": {
            "events": {
              "type": "array",
              "oneOf": [
                { "const": ["pre-install", "pre-upgrade"] },
                { "const": ["post-install", "pre-upgrade"] }
              ]
            },
            "localBundledPostgres": { "type": "boolean" },
            "classDecisionLiveSchemaDigest": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$",
              "description": "CHAOS-8744: the schema_digest of the running query-api's GET /registry, read before the upgrade; the migrate Job gets it as env DHO_CLASS_DECISION_LIVE_SCHEMA_DIGEST (Postgres migration 0146). Empty means unset."
            },
            "clickhouseCloud": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "secretName": { "type": "string" },
                "hostKey": { "type": "string", "minLength": 1 },
                "userKey": { "type": "string", "minLength": 1 },
                "passwordKey": { "type": "string", "minLength": 1 },
                "port": { "type": ["integer", "string"] },
                "database": { "type": "string", "minLength": 1 }
              },
              "description": "CHAOS-10754: the migrate Job's CLICKHOUSE_URI composed from a Secret by Kubernetes env expansion. The password must be URL-safe (no percent-encoding happens)."
            },
            "routeActivate": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Gates the CHAOS-4272/CHAOS-4455 route-activate hook Job. Helm's own --set coercion accepts any truthy/falsy value on an untyped key (codex review, r2 P3 -- executed: `--set-string …enabled=maybe` rendered clean); this key is boolean-only."
                }
              },
              "required": ["enabled"],
              "description": "codex review (r3, P1 -- executed, fixed): a null override (--set-json …enabled=null) DELETES this key during Helm's values coalescing rather than failing type validation against it -- the type:boolean guard above never even runs, since there is then no value left to check. The missing key then reads as Go-template-false, silently disabling activation with exit 0, unlike simply OMITTING an override (which leaves values.yaml's own default of true in the merged result, present and required-satisfying). `required` closes exactly the null-deletes-the-key gap without rejecting the normal absent-override case."
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Shared application secrets must never contain the elevated migration DSN.",
          "not": {
            "anyOf": [
              {
                "required": ["MIGRATION_DATABASE_URI"]
              },
              {
                "required": ["MIGRATION_DATABASE_URI_FILE"]
              }
            ]
          }
        }
      }
    },
    "goWorkers": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "extraEnvFrom": { "$ref": "#/definitions/extraEnvFrom" },
        "secretKeys": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "enum": ["APP_BASE_URL", "CLICKHOUSE_URI", "EMAIL_API_KEY", "EMAIL_FROM_ADDRESS", "EMAIL_PROVIDER", "EXPECTED_WORKER_GROUPS", "INVESTMENT_LLM_BATCH_MODE", "INVESTMENT_LLM_BATCH_TIMEOUT_SECONDS", "LICENSE_PRIVATE_KEY", "LINEAR_API_KEY", "LLM_MODEL", "LLM_PROVIDER", "OPENAI_API_KEY", "PAGER_DUTY_CLIENT_ID", "PAGER_DUTY_REDIRECT_URI", "PAGER_DUTY_SECRET", "SETTINGS_ENCRYPTION_KEY", "STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET", "WORKER_GITHUB_WORK_ITEMS_STATUS_MAPPING_PATH"] }, "uniqueItems": true },
        "pgbouncer": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "image": { "type": "string" },
            "transaction": {
              "type": "object",
              "properties": {
                "extraUsers": {
                  "type": "array",
                  "description": "Roles the transaction pooler authenticates in addition to its own. Both fields are required and neither may be empty: the chart writes each entry as one `\"role\" \"password\"` userlist line, so a missing role would emit a line PgBouncer silently reads as a blank user, and a missing passwordKey has no Secret value to resolve.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "role": { "type": "string", "minLength": 1 },
                      "passwordKey": { "type": "string", "minLength": 1 }
                    },
                    "required": ["role", "passwordKey"],
                    "additionalProperties": false
                  }
                }
              }
            },
            "postgres": {
              "type": "object",
              "properties": {
                "host": { "type": "string" },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "database": { "type": "string" },
                "networkPolicyCIDR": { "type": "string" }
              }
            },
            "secret": {
              "type": "object",
              "properties": {
                "create": { "type": "boolean" },
                "externalSecretName": { "type": "string" },
                "data": {
                  "type": "object",
                  "description": "Go PgBouncer secrets contain only role passwords and endpoint DSNs; migration DSNs are prohibited.",
                  "not": {
                    "anyOf": [
                      { "required": ["MIGRATION_DATABASE_URI"] },
                      { "required": ["MIGRATION_DATABASE_URI_FILE"] }
                    ]
                  }
                }
              }
            }
          }
        },
        "keda": {
          "type": "object",
          "properties": {
            "namespace": { "type": "string" }
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "subcommand": { "type": "string", "enum": ["reconciler", "scheduler", "stream-runner", "worker"] },
              "runtimeProfile": { "type": "string", "enum": ["ingest", "external", "pagerduty"] },
              "extraEnv": { "type": "array", "items": { "type": "object", "required": ["name"] } },
              "autoscaling": {
                "type": "object",
                "required": ["enabled"],
                "properties": {
                  "enabled": { "type": "boolean" },
                  "minReplicas": { "type": "integer", "minimum": 1 },
                  "maxReplicas": { "type": "integer", "minimum": 1 },
                  "queueDepthPerReplica": { "type": "integer", "minimum": 1 },
                  "cooldownPeriod": { "type": "integer", "minimum": 300 },
                  "pollingInterval": { "type": "integer", "minimum": 1 },
                  "extraTriggers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["name", "query", "targetQueryValue"],
                      "additionalProperties": false,
                      "properties": {
                        "name": { "type": "string", "minLength": 1 },
                        "query": { "type": "string", "minLength": 1 },
                        "targetQueryValue": { "type": "integer", "minimum": 1 }
                      }
                    }
                  }
                }
              },
              "livenessProbe": { "type": "object" },
              "readinessProbe": { "type": "object" },
              "preclaimReadinessTimeout": { "type": "string" },
              "rollingUpdate": { "$ref": "#/definitions/rollingUpdate" }
            }
          }
        },
        "rollingUpdate": { "$ref": "#/definitions/rollingUpdate" },
        "defaultProbes": {
          "type": "object",
          "properties": {
            "livenessProbe": { "type": "object" },
            "readinessProbe": { "type": "object" }
          }
        },
        "defaultPreclaimReadinessTimeout": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "goWorkers": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          }
        },
        "required": ["goWorkers"]
      },
      "then": {
        "properties": {
          "goWorkers": {
            "properties": {
              "pgbouncer": {
                "properties": { "enabled": { "const": true } },
                "required": ["enabled"]
              }
            },
            "required": ["pgbouncer"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "migrations": {
            "properties": {
              "hook": {
                "properties": {
                  "events": { "const": ["post-install", "pre-upgrade"] }
                },
                "required": ["events"]
              }
            },
            "required": ["hook"]
          }
        },
        "required": ["migrations"]
      },
      "then": {
        "properties": {
          "migrations": {
            "properties": {
              "hook": {
                "properties": {
                  "localBundledPostgres": { "const": true }
                },
                "required": ["localBundledPostgres"]
              }
            }
          },
          "postgresql": {
            "properties": {
              "enabled": { "const": true }
            },
            "required": ["enabled"]
          }
        },
        "required": ["postgresql"]
      }
    }
  ]
}
