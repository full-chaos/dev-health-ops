      "replace": "case provider == \"gitlab\" && dataset == \"commit-stats\":\n\t\tdescriptor.Destinations = []string{\"git_commit_stats\"}\n\t\tdescriptor.RouteReady = false\n\t\tdescriptor.RouteEnabled = switches.GitlabCommitStats",
      "rationale": "the completed pair must be visible through the canonical descriptor and checked-in matrix rather than dead handler code",
