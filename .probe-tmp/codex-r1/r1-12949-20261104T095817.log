    26	// Linear-only coverage is banned by contract: jira/github/gitlab work items
    27	// carry native_team_key=None, so their attribution rides entirely on the
    28	// autoimport team/project/member dimension, which is a different code path
    29	// from Linear's native team key.
    30	var wtiProviders = []string{"jira", "gitlab", "github", "linear"}
    31	
    32	// wtiEntities is the entity half. Each (provider, entity) cell below is
    33	// asserted by name in this test and the coverage ledger fails the test if a
    34	// cell is never reached -- an unasserted cell that silently reads as covered
    35	// is the exact failure AGENTS.md's "a test that cannot fail is worse than no
    36	// test" rule exists to stop.
    37	var wtiEntities = []string{"teams", "projects", "members", "issues"}
    38	
    39	// attributionSourceFor is the eligible primary attribution source each
    40	// provider actually emits for its issues. Rotating them proves the allocator
    41	// never branches on provider AND covers all four eligible sources.
    42	var attributionSourceFor = map[string]string{
    43		"linear": "native_team",
    44		"jira":   "issue_project",
    45		"gitlab": "project_ownership",
    46		"github": "repo_ownership",
    47	}
    48	
    49	// repoHostFor maps a work-tracking provider to the provider stamped on its
    50	// repos and on team_repo_ownership. They are NOT the same axis: the
    51	// derivation writer stamps the REPO's provider, so a Jira team legitimately
    52	// owns GitHub repositories. A join that confused the two would pass a
    53	// single-provider fixture and fail here.
    54	var repoHostFor = map[string]string{
    55		"linear": "github",
    56		"jira":   "github",
    57		"gitlab": "gitlab",
    58		"github": "github",
    59	}
    60	
    61	// ownershipSourceFor gives each provider's two donor teams a different
    62	// eligible team_repo_ownership source, covering all four across the matrix.
    63	// The "projects" arm is the `inferred` source -- the sync-derived producer
    64	// that turns team_project_ownership into repository ownership. GitHub has no
    65	// native project entity (the repo is the scope), so its second arm is
    66	// `native` and its projects cell is recorded n/a instead.
    67	var ownershipSourceFor = map[string][2]string{
    68		"jira":   {"jira_legacy", "inferred"},
    69		"gitlab": {"provider_access", "inferred"},
    70		"linear": {"native", "inferred"},
    71		"github": {"provider_access", "native"},
    72	}
    73	
    74	type matrixCoverage struct {
    75		t    *testing.T
    76		seen map[string]string
    77	}
    78	
    79	func newMatrixCoverage(t *testing.T) *matrixCoverage {
    80		t.Helper()
    81		return &matrixCoverage{t: t, seen: map[string]string{}}
    82	}
    83	
    84	func (c *matrixCoverage) cover(provider, entity, how string) {
    85		c.t.Helper()
    86		c.seen[provider+"/"+entity] = how
    87	}
    88	
    89	func (c *matrixCoverage) assertComplete() {
    90		c.t.Helper()
    91		var missing []string
    92		for _, provider := range wtiProviders {
    93			for _, entity := range wtiEntities {
    94				if _, ok := c.seen[provider+"/"+entity]; !ok {
    95					missing = append(missing, provider+"/"+entity)
    96				}
    97			}
    98		}
    99		sort.Strings(missing)
   100		if len(missing) > 0 {
   101			c.t.Fatalf("provider x entity matrix cells never asserted: %v", missing)
   102		}
   103		keys := make([]string, 0, len(c.seen))
   104		for key := range c.seen {
   105			keys = append(keys, key)
   106		}
   107		sort.Strings(keys)
   108		for _, key := range keys {
   109			c.t.Logf("matrix %s: %s", key, c.seen[key])
   110		}
   111	}
   112	
   113	func matrixRepoID(providerIndex, n int) string {
   114		return fmt.Sprintf("%08d-0000-4000-8000-%012d", providerIndex+1, n)
   115	}
   116	
   117	// TestTeamOwnershipFallbackProviderEntityMatrix runs the production
   118	// materializer against a real ClickHouse over the whole {jira, gitlab, github,
   119	// linear} x {teams, projects, members, issues} matrix.
   120	//
   121	// Per provider it asserts, through persisted rows only:
   122	//   - issues: an eligible primary attribution on each member issue produces the
   123	//     distinct union of its teams' repositories, equal shares, effort conserved.
   124	//   - teams: only an is_active team donates; an inactive team's repository never
   125	//     receives a share, even though its ownership row is live.
   126	//   - projects: the sync-derived `inferred` ownership arm (the producer that
   127	//     turns team_project_ownership into repository ownership) donates like any
   128	//     other eligible source. GitHub has no native project entity, recorded n/a.
   129	//   - members: membership-derived attribution (assignee_membership,
   130	//     author_membership) and team_memberships rows NEVER donate. This is the
   131	//     cell that must stay negative -- team authorization is ownership-derived,
   132	//     never person -> membership -> team.
   133	//
   134	// TestNoTeamOwnershipRepositoryFallbackProviderEntityMatrix (CHAOS-12949, chris:
   135	// "Drop fallback"): the same provider x entity fixtures that used to make the
   136	// team-ownership fallback allocate a donor team's repositories now leave every
   137	// unit without repository evidence unattributed -- an 'empty' row (effort 0) or
   138	// an 'active_hours_unassigned' row (effort > 0), repo_id NULL, never a
   139	// team_ownership row. Units with direct repository evidence keep it.
   140	func TestNoTeamOwnershipRepositoryFallbackProviderEntityMatrix(t *testing.T) {
   141		t.Parallel()
   142		ctx, cancel := context.WithTimeout(context.Background(), 6*time.Minute)
   143		t.Cleanup(cancel)
   144		instance, err := containers.StartClickHouse(ctx)
   145		if err != nil {
   146			t.Fatal(err)
   147		}
   148		t.Cleanup(func() { _ = instance.Close(context.Background()) })
   149		chschema.Apply(ctx, t, instance)
   150		conn, err := clickhousestore.Open(ctx, clickhousestore.DefaultConfig(instance.URI))
   151		if err != nil {
   152			t.Fatal(err)
   153		}
   154		t.Cleanup(func() { _ = conn.Close() })
   155		reader, err := chquery.NewReader(conn)
   156		if err != nil {
   157			t.Fatal(err)
   158		}
   159		writer, err := chwrite.NewWriter(conn)
   160		if err != nil {
   161			t.Fatal(err)
   162		}
   163		logs := &bytes.Buffer{}
   164		materializer, err := NewMaterializer(reader, writer, categorize.MockProvider{}, slog.New(slog.NewTextHandler(logs, nil)))
   165		if err != nil {
   166			t.Fatal(err)
   167		}
   168		coverage := newMatrixCoverage(t)
   169		at := time.Date(2026, 1, 5, 0, 0, 0, 0, time.UTC)
   170	
   171		// wantRepos[provider][issue] is the sorted set of repositories the issue's
   172		// donor team owns, and wantTeams[provider][issue] the team id that must
   173		// appear in the persisted provenance for each of them. An issue -> issue
   174		// link is a reference, not membership, so each positive issue is its own
   175		// one-node unit and allocates only its own team's repositories.
   176		// persisted provenance for that repository.
   177		wantRepos := map[string]map[string][]string{}
   178		wantTeams := map[string]map[string]string{}
   179	
   180		for providerIndex, provider := range wtiProviders {
   181			host := repoHostFor[provider]
   182			attrSource := attributionSourceFor[provider]
   183			sources := ownershipSourceFor[provider]
   184			teamA, teamB := provider+"-team-a", provider+"-team-b"
   185			teamInactive, teamMembers := provider+"-team-inactive", provider+"-team-members"
   186			r1, r2, r3 := matrixRepoID(providerIndex, 1), matrixRepoID(providerIndex, 2), matrixRepoID(providerIndex, 3)
   187			rInactive, rMembers, rManual := matrixRepoID(providerIndex, 4), matrixRepoID(providerIndex, 5), matrixRepoID(providerIndex, 6)
   188			rExpiring := matrixRepoID(providerIndex, 7)
   189	
   190			for n, repo := range map[string]string{r1: "r1", r2: "r2", r3: "r3", rInactive: "r-inactive", rMembers: "r-members", rManual: "r-manual", rExpiring: "r-expiring"} {
   191				mustTeamOwnershipExec(t, ctx, conn, `INSERT INTO repos (id, repo, provider, org_id) VALUES (?, ?, ?, ?)`,
   192					n, "acme/"+provider+"-"+repo, host, hierarchyCascadeTestOrg)
   193			}
   194			// teams: three active donors and one deactivated team, all on this
   195			// provider. Only the active ones may donate.
   196			for _, team := range []string{teamA, teamB, teamMembers} {
   197				mustTeamOwnershipExec(t, ctx, conn, `INSERT INTO teams (id, team_uuid, name, provider, is_active, updated_at, org_id) VALUES (?, generateUUIDv4(), ?, ?, 1, ?, ?)`,
   198					team, team, provider, at, hierarchyCascadeTestOrg)
   199			}
   200			mustTeamOwnershipExec(t, ctx, conn, `INSERT INTO teams (id, team_uuid, name, provider, is_active, updated_at, org_id) VALUES (?, generateUUIDv4(), ?, ?, 0, ?, ?)`,
   201				teamInactive, teamInactive, provider, at, hierarchyCascadeTestOrg)
   202	
   203			// team A owns r1 and r2 by NAME only (repo_id NULL) -- the shape the
   204			// GitHub provider_access producer actually writes. Two ownership
   205			// generations prove a ReplacingMergeTree duplicate cannot double-count.
   206			for _, name := range []string{"acme/" + provider + "-r1", "acme/" + provider + "-r2"} {
   207				for _, version := range []time.Time{at, at.Add(time.Minute)} {
   208					seedRepoOwnershipByName(t, ctx, conn, host, teamA, name, sources[0], version)
   209				}
   210			}
   211			// team B owns r2 and r3 by explicit repo_id -- the other join arm.
   212			for _, repo := range []string{r2, r3} {
   213				seedRepoOwnershipByID(t, ctx, conn, host, teamB, repo, "acme/"+provider+"-"+map[string]string{r2: "r2", r3: "r3"}[repo], sources[1], at)
   214			}
   215			// Ownership that is live at the run's ComputedAt but EXPIRED by wall
   216			// clock. It only donates if the interval is evaluated at the run's own
   217			// timestamp; substituting time.Now() drops it.
   218			seedExpiringRepoOwnership(t, ctx, conn, host, teamA, rExpiring, "acme/"+provider+"-r-expiring", sources[0], at, at.Add(3*time.Hour))
   219			// Negative ownership: an inactive team, a membership-only team, and a
   220			// manual mapping. None of the three may reach an allocation.
   221			seedRepoOwnershipByID(t, ctx, conn, host, teamInactive, rInactive, "acme/"+provider+"-r-inactive", sources[0], at)
   222			seedRepoOwnershipByID(t, ctx, conn, host, teamMembers, rMembers, "acme/"+provider+"-r-members", sources[0], at)
   223			seedRepoOwnershipByID(t, ctx, conn, host, teamA, rManual, "acme/"+provider+"-r-manual", "manual", at)
   224	
   225			// members: real membership rows exist for the membership team. They are
   226			// data the fallback must ignore, never a donation path.
   227			for _, member := range []string{"person-1", "person-2"} {
   228				mustTeamOwnershipExec(t, ctx, conn, `INSERT INTO team_memberships (org_id, provider, team_id, member_id, source, valid_from, updated_at) VALUES (?, ?, ?, ?, 'provider_access', ?, ?)`,
   229					hierarchyCascadeTestOrg, provider, teamMembers, member, at, at)
   230			}
   231			// projects: the project ownership the `inferred` repository-ownership
   232			// producer derives from. GitHub has no native project entity.
   233			if provider != "github" {
   234				mustTeamOwnershipExec(t, ctx, conn, `INSERT INTO team_project_ownership (org_id, provider, team_id, project_id, project_key, source, valid_from, updated_at) VALUES (?, ?, ?, ?, ?, 'provider_access', ?, ?)`,
   235					hierarchyCascadeTestOrg, provider, teamB, provider+"-project", provider+"-PROJ", at, at)
   236			}
   237	
   238			// issues. Component 1 allocates; components 2 and 3 must not.
   239			positives := map[string]string{provider + ":a": teamA, provider + ":b": teamB}
   240			memberOnly := []string{provider + ":m1", provider + ":m2"}
   241			inactiveOnly := []string{provider + ":i1", provider + ":i2"}
   242			for issue, team := range positives {
   243				seedMatrixWorkItem(t, ctx, conn, issue, provider, at)
   244				seedAttribution(t, ctx, conn, issue, provider, team, attrSource, 1, at)
   245			}
   246			// An eligible donor team, live ownership and 12 active hours: the unit has
   247			// positive effort and no repository evidence, so it must keep its 12 hours
   248			// as UNATTRIBUTED effort (active_hours_unassigned), not as a team share.
   249			hoursIssue := provider + ":h"
   250			seedMatrixWorkItem(t, ctx, conn, hoursIssue, provider, at)
   251			seedAttribution(t, ctx, conn, hoursIssue, provider, teamA, attrSource, 1, at)
   252			mustTeamOwnershipExec(t, ctx, conn, `INSERT INTO work_item_cycle_times (org_id, work_item_id, provider, type, active_time_hours, created_at, computed_at) VALUES (?, ?, ?, 'task', 12, ?, ?)`,
   253				hierarchyCascadeTestOrg, hoursIssue, provider, at, at)
   254			for i, issue := range memberOnly {
   255				seedMatrixWorkItem(t, ctx, conn, issue, provider, at)
   256				source := "assignee_membership"
   257				if i == 1 {
   258					source = "author_membership"
   259				}
   260				seedAttribution(t, ctx, conn, issue, provider, teamMembers, source, 1, at)
   261			}
   262			for _, issue := range inactiveOnly {
   263				seedMatrixWorkItem(t, ctx, conn, issue, provider, at)
   264				seedAttribution(t, ctx, conn, issue, provider, teamInactive, attrSource, 1, at)
   265			}
   266			// A pair whose work items sit entirely outside the run window. It is a
   267			// real component that MaterializeComponent skips, so window_skipped is
   268			// measured against data rather than pinned at a constant zero.
   269			outOfWindow := []string{provider + ":w1", provider + ":w2"}
   270			for _, issue := range outOfWindow {
   271				seedMatrixWorkItem(t, ctx, conn, issue, provider, at.AddDate(0, 0, -60))
   272				seedAttribution(t, ctx, conn, issue, provider, teamA, attrSource, 1, at)
   273			}
   274			// F3 (codex r1): two more components that DO have direct repository
   275			// evidence, so `own_repo` and `direct_repo_evidence` are measured
   276			// end-to-end through Run's switch rather than pinned at zero. Both
   277			// carry a full eligible attribution AND live ownership, so what they
   278			// prove is PRECEDENCE -- direct evidence wins while a donor was
   279			// available -- not merely the absence of donors.
   280			ownEdge := []string{provider + ":e1", provider + ":e2"}
   281			ambiguous := []string{provider + ":g1", provider + ":g2"}
   282			for _, issue := range append(append([]string{}, ownEdge...), ambiguous...) {
   283				seedMatrixWorkItem(t, ctx, conn, issue, provider, at)
   284				seedAttribution(t, ctx, conn, issue, provider, teamA, attrSource, 1, at)
   285			}
   286			seedPullRequestLinks(t, ctx, conn, r1+"#pr1", r1, at, ownEdge[0], ownEdge[1])
   287			seedPullRequestLinks(t, ctx, conn, r1+"#pr2", r1, at, ambiguous[0], ambiguous[1])
   288			seedPullRequestLinks(t, ctx, conn, r2+"#pr3", r2, at, ambiguous[1])
   289	
   290			seedIssueEdge(t, ctx, conn, provider+":a", provider+":b", "", at)
   291			seedIssueEdge(t, ctx, conn, memberOnly[0], memberOnly[1], "", at)
   292			seedIssueEdge(t, ctx, conn, inactiveOnly[0], inactiveOnly[1], "", at)
   293			seedIssueEdge(t, ctx, conn, outOfWindow[0], outOfWindow[1], "", at)
   294	
   295			wantRepos[provider] = map[string][]string{
   296				provider + ":a": {r1, r2, rExpiring},
   297				provider + ":b": {r2, r3},
   298			}
   299			for _, repos := range wantRepos[provider] {
   300				sort.Strings(repos)
   301			}
   302			wantTeams[provider] = map[string]string{provider + ":a": teamA, provider + ":b": teamB}
   303		}
   304	
   305		stats, err := materializer.Run(ctx, Config{
   306			OrgID: hierarchyCascadeTestOrg, FromTS: at.Add(-time.Hour), ToTS: at.Add(2 * time.Hour),
   307			RunID: "team-ownership-matrix", ComputedAt: at.Add(2 * time.Hour), ProviderName: "mock",
   308		})
   309		if err != nil {
   310			t.Fatal(err)
   311		}
   312	
   313		if stats.Components == 0 {
   314			t.Fatal("the run materialized no components")
   315		}
   316		for _, provider := range wtiProviders {
   317			// issues + teams: eligible donor teams with live ownership. No unit takes
   318			// a repository from them; each keeps an unattributed row.
   319			for _, issue := range []string{provider + ":a", provider + ":b"} {
   320				unit := units.WorkUnitID([]units.NodeKey{{Type: "issue", ID: issue}})
   321				assertUnattributedOnly(t, ctx, conn, provider, issue, unit, "empty", 0)
   322			}
   323			coverage.cover(provider, "issues", "primary "+attributionSourceFor[provider]+" attribution on a one-node issue unit with an owning team allocates no repository")
   324			coverage.cover(provider, "teams", "team_repo_ownership from two is_active teams donates nothing")
   325			if provider == "github" {
   326				coverage.cover(provider, "projects", "n/a -- GitHub has no native project entity, the repository is the scope")
   327			} else {
   328				coverage.cover(provider, "projects", "team_project_ownership-derived repository ownership donates nothing")
   329			}
   330			// positive effort: 12 active hours stay as unattributed effort.
   331			hoursUnit := units.WorkUnitID([]units.NodeKey{{Type: "issue", ID: provider + ":h"}})
   332			assertUnattributedOnly(t, ctx, conn, provider, provider+":h", hoursUnit, "active_hours_unassigned", 12)
   333			// members, inactive team: still nothing.
   334			for _, issue := range []string{provider + ":m1", provider + ":m2", provider + ":i1", provider + ":i2"} {
   335				unit := units.WorkUnitID([]units.NodeKey{{Type: "issue", ID: issue}})
   336				assertUnattributedOnly(t, ctx, conn, provider, issue, unit, "empty", 0)
   337			}
   338			coverage.cover(provider, "members", "assignee_membership + author_membership attributions and team_memberships rows donate nothing")
   339		}
   340		coverage.assertComplete()
   341	
   342		// Total allocated effort of the org is unchanged by the drop: no
   343		// team_ownership row exists anywhere after the run.
   344		var teamRows uint64
   345		if err := conn.QueryRow(ctx, `SELECT count() FROM work_unit_repo_effort FINAL WHERE org_id = ? AND allocation_source = 'team_ownership'`, hierarchyCascadeTestOrg).Scan(&teamRows); err != nil {
   346			t.Fatal(err)
   347		}
   348		if teamRows != 0 {
   349			t.Fatalf("%d work_unit_repo_effort rows carry allocation_source team_ownership", teamRows)
   350		}
   351	
   352		// Skip-existing path (Force=false, unchanged units): a later run writes a
   353		// NEWER allocation generation and still no team_ownership row.
   354		second := at.Add(4 * time.Hour)
   355		if _, err := materializer.Run(ctx, Config{
   356			OrgID: hierarchyCascadeTestOrg, FromTS: at.Add(-time.Hour), ToTS: at.Add(2 * time.Hour),
   357			RunID: "team-ownership-matrix-rerun", ComputedAt: second, ProviderName: "mock",
   358		}); err != nil {
   359			t.Fatal(err)
   360		}
   361		for _, provider := range wtiProviders {
   362			unit := units.WorkUnitID([]units.NodeKey{{Type: "issue", ID: provider + ":a"}})
   363			var newest time.Time
   364			if err := conn.QueryRow(ctx, `SELECT max(computed_at) FROM work_unit_repo_effort WHERE org_id = ? AND work_unit_id = ?`, hierarchyCascadeTestOrg, unit).Scan(&newest); err != nil {
   365				t.Fatal(err)
   366			}
   367			if !newest.Equal(second) {
   368				t.Errorf("%s: newest allocation generation of %s is %s, want the rerun %s", provider, unit, newest, second)
   369			}
   370			assertUnattributedOnly(t, ctx, conn, provider, provider+":a", unit, "empty", 0)
   371		}
   372	}
   373	
   374	// assertUnattributedOnly reads the NEWEST generation of the unit's allocation
   375	// rows and requires exactly one row: repo_id NULL, the given source and effort,
   376	// and no team_ownership row.
   377	func assertUnattributedOnly(t *testing.T, ctx context.Context, conn driver.Conn, provider, issue, workUnitID, wantSource string, wantEffort float64) {
   378		t.Helper()
   379		rows, err := conn.Query(ctx, `
   380			SELECT repo_id IS NULL, allocation_source, effort_value
   381			FROM work_unit_repo_effort
   382			WHERE org_id = ? AND work_unit_id = ? AND computed_at = (SELECT max(computed_at) FROM work_unit_repo_effort WHERE org_id = ? AND work_unit_id = ?)`,
   383			hierarchyCascadeTestOrg, workUnitID, hierarchyCascadeTestOrg, workUnitID)
   384		if err != nil {
   385			t.Fatal(err)
   386		}
   387		defer func() { _ = rows.Close() }()
   388		n := 0
   389		for rows.Next() {
   390			var isNull bool
   391			var source string
   392			var effort float64
   393			if err := rows.Scan(&isNull, &source, &effort); err != nil {
   394				t.Fatal(err)
   395			}
   396			n++
   397			if source == "team_ownership" || !isNull || source != wantSource || effort != wantEffort {
   398				t.Errorf("%s %s: newest allocation row repo_null=%v source=%q effort=%g, want repo NULL, source %q, effort %g",
   399					provider, issue, isNull, source, effort, wantSource, wantEffort)
   400			}
   401		}
   402		if err := rows.Err(); err != nil {
   403			t.Fatal(err)
   404		}
   405		if n != 1 {
   406			t.Errorf("%s %s: %d newest allocation rows, want exactly 1", provider, issue, n)
   407		}
   408	}
   409	
   410	func indexOfProvider(provider string) int {
   411		for i, candidate := range wtiProviders {
   412			if candidate == provider {
   413				return i
   414			}
   415		}
   416		return -1
   417	}
   418	
   419	func readRepoEffort(t *testing.T, ctx context.Context, conn driver.Conn, workUnitID string) (repos []string, provenance map[string]string, weightSum, effortSum float64) {
   420		t.Helper()
   421		provenance = map[string]string{}
   422		rows, err := conn.Query(ctx, `
   423			SELECT toString(repo_id), allocation_weight, effort_value, allocation_source, ifNull(repo_source, '')
   424			FROM work_unit_repo_effort FINAL
   425			WHERE org_id = ? AND work_unit_id = ? AND repo_id IS NOT NULL AND allocation_source = 'team_ownership'
   426			ORDER BY repo_id`, hierarchyCascadeTestOrg, workUnitID)
   427		if err != nil {
   428			t.Fatal(err)
   429		}
   430		defer func() { _ = rows.Close() }()
   431		for rows.Next() {
   432			var repo, source, evidence string
   433			var weight, effort float64
   434			if err := rows.Scan(&repo, &weight, &effort, &source, &evidence); err != nil {
   435				t.Fatal(err)
   436			}
   437			if evidence == "" {
   438				t.Errorf("%s: repo %s allocated with no provenance", workUnitID, repo)
   439			}
   440			repos = append(repos, repo)
   441			provenance[repo] = evidence
   442			weightSum += weight
   443			effortSum += effort
   444		}
   445		if err := rows.Err(); err != nil {
   446			t.Fatal(err)
   447		}
   448		return repos, provenance, weightSum, effortSum
   449	}
   450	
   451	func lastLogLine(t *testing.T, logs, message string) string {
   452		t.Helper()
   453		var found string
