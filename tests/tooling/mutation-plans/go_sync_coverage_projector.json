{
  "schema_version": 1,
  "name": "native sync coverage projector",
  "$comment": "CHAOS-3768 clause-level closure for native schedule ownership, bounded production, priority, atomic invalidation clearing, retry classification, production wiring, durable routing, and least-privilege storage.",
  "build": [
    "env",
    "GOTOOLCHAIN=go1.25.9",
    "GOWORK=off",
    "GOCACHE=/tmp/go-sync-coverage-mutation-cache",
    "go",
    "test",
    "-tags=integration",
    "-run",
    "^$",
    "./internal/synccoverage/",
    "./internal/jobs/synccoverage/",
    "./internal/scheduler/fixed/",
    "./cmd/dev-health-scheduler/",
    "./cmd/dev-health-worker/",
    "./internal/storage/postgres/",
    "./internal/storage/river/"
  ],
  "mutations": [
    {
      "id": "SCP01-native-schedule-owner",
      "file": "internal/scheduler/fixed/inventory.go",
      "find": "Native:           true,",
      "replace": "Native:           false,",
      "expect_occurrences": 1,
      "rationale": "the retired Python Beat entry requires an explicitly native fixed-schedule owner",
      "proof": [["env", "GOCACHE=/tmp/go-sync-coverage-mutation-cache", "go", "test", "-count=1", "-run", "^TestSyncCoverageRefreshHasAConstructedFixedScheduleOwner$", "./internal/scheduler/fixed/"]]
    },
    {
      "id": "SCP02-production-scheduler-construction",
      "file": "cmd/dev-health-scheduler/fixed.go",
      "find": "schedulerfixed.NewSyncCoverageRefreshProducer(),",
      "replace": "schedulerfixed.NewHeartbeatProducer(),",
      "expect_occurrences": 1,
      "rationale": "the production scheduler binary must construct the coverage producer, not only declare ownership",
      "proof": [["env", "GOCACHE=/tmp/go-sync-coverage-mutation-cache", "go", "test", "-count=1", "-run", "^TestFixedScheduleProducersAreConstructedForEveryDeclaredSchedule$", "./cmd/dev-health-scheduler/"]]
    },
    {
      "id": "SCP03-bounded-sweep",
      "file": "internal/scheduler/fixed/producers.go",
      "find": "return SyncCoverageRefreshProducer{limit: 100}",
      "replace": "return SyncCoverageRefreshProducer{limit: 1}",
      "expect_occurrences": 1,
      "rationale": "the native producer must preserve the former task's reviewed 100-configuration batch",
      "proof": [["env", "GOCACHE=/tmp/go-sync-coverage-mutation-cache", "go", "test", "-count=1", "-run", "^TestSyncCoverageRefreshProducerEmitsOneBoundedDeterministicSweep$", "./internal/scheduler/fixed/"]]
    },
    {
      "id": "SCP04-invalidated-priority",
      "file": "internal/synccoverage/projector.go",
      "find": "WHEN projection.invalidated_at IS NOT NULL THEN 0",
      "replace": "WHEN projection.invalidated_at IS NOT NULL THEN 2",
      "expect_occurrences": 1,
      "rationale": "invalidated projections must be selected ahead of missing and merely old warm rows",
      "proof": [["env", "GOCACHE=/tmp/go-sync-coverage-mutation-cache", "go", "test", "-tags=integration", "-count=1", "-timeout=8m", "-run", "^TestProjectorPostgresLifecycle$/^refresh_priority_is_invalidated_then_missing_then_oldest$", "./internal/synccoverage/"]]
    },
    {
      "id": "SCP05-atomic-invalidation-clear",
      "file": "internal/synccoverage/projector.go",
      "find": "    invalidated_at = NULL,",
      "replace": "    invalidated_at = sync_coverage_projections.invalidated_at,",
      "expect_occurrences": 1,
      "rationale": "a successful atomic replacement must clear the invalidation marker",
      "proof": [["env", "GOCACHE=/tmp/go-sync-coverage-mutation-cache", "go", "test", "-tags=integration", "-count=1", "-timeout=8m", "-run", "^TestProjectorPostgresLifecycle$/^invalidated_refresh_clears_marker$", "./internal/synccoverage/"]]
    },
    {
      "id": "SCP06-partial-failed-count",
      "file": "internal/jobs/synccoverage/handler.go",
      "find": "result.Failed > 0",
      "replace": "false",
      "expect_occurrences": 1,
      "rationale": "a sweep with a failed configuration must remain retryable even when the query completed",
      "proof": [["env", "GOCACHE=/tmp/go-sync-coverage-mutation-cache", "go", "test", "-count=1", "-run", "^TestHandlerDoesNotReportAPartialSweepAsSuccess$/^failed_count$", "./internal/jobs/synccoverage/"]]
    },
    {
      "id": "SCP07-partial-failure-detail",
      "file": "internal/jobs/synccoverage/handler.go",
      "find": "len(result.Failures) > 0",
      "replace": "false",
      "expect_occurrences": 1,
      "rationale": "failure detail cannot be ignored if an implementation forgets to increment the aggregate count",
      "proof": [["env", "GOCACHE=/tmp/go-sync-coverage-mutation-cache", "go", "test", "-count=1", "-run", "^TestHandlerDoesNotReportAPartialSweepAsSuccess$/^failure_detail_without_count$", "./internal/jobs/synccoverage/"]]
    },
    {
      "id": "SCP08-production-worker-construction",
      "file": "cmd/dev-health-worker/operational.go",
      "find": "case jobcontract.KindSyncCoverageRefresh:",
      "replace": "case \"system.sync_coverage_refresh_disabled\":",
      "expect_occurrences": 1,
      "rationale": "the ops worker must construct and register the executable handler for the checked-in River kind",
      "proof": [["env", "GOCACHE=/tmp/go-sync-coverage-mutation-cache", "go", "test", "-count=1", "-run", "^TestProductionOpsBuilderConstructsNativeSyncCoverageRefresh$", "./cmd/dev-health-worker/"]]
    },
    {
      "id": "SCP09-domain-update-posture",
      "file": "internal/storage/postgres/domain_authorization.go",
      "find": "{\"sync_coverage_projections\", true, true, false}",
      "replace": "{\"sync_coverage_projections\", true, false, false}",
      "expect_occurrences": 1,
      "rationale": "the domain role needs UPDATE to replace an existing projection and clear invalidation",
      "proof": [["env", "GOCACHE=/tmp/go-sync-coverage-mutation-cache", "go", "test", "-count=1", "-run", "^TestDomainPostureInventoriesNativeSyncCoveragePrivileges$", "./internal/storage/postgres/"]]
    },
    {
      "id": "SCP10-runtime-update-grant",
      "file": "internal/storage/river/migrate.go",
      "find": "GRANT SELECT, INSERT, UPDATE ON TABLE public.sync_coverage_projections",
      "replace": "GRANT SELECT, INSERT ON TABLE public.sync_coverage_projections",
      "expect_occurrences": 1,
      "rationale": "runtime provisioning must grant the UPDATE privilege required by the reviewed domain posture",
      "proof": [["env", "GOCACHE=/tmp/go-sync-coverage-mutation-cache", "go", "test", "-count=1", "-run", "^TestRuntimeGrantStatementsMatchProvisionedLeastPrivilegePolicy$", "./internal/storage/river/"]]
    },
    {
      "id": "SCP11-live-payload-parity",
      "file": "internal/synccoverage/payload.go",
      "find": "\"gap_count\":              gapCount,",
      "replace": "\"gap_count\":              gapCount + 1,",
      "expect_occurrences": 1,
      "rationale": "the Go payload's semantic leaves must remain exactly equal to the executed production Python builder",
      "proof": [["bash", "ci/check_go.sh", "live-python-oracles"]]
    },
    {
      "id": "SCP12-durable-native-route",
      "file": "src/dev_health_ops/alembic/versions/0094_seed_sync_coverage_refresh_route.py",
      "find": "_TRANSPORT = \"river\"",
      "replace": "_TRANSPORT = \"celery\"",
      "expect_occurrences": 1,
      "rationale": "existing and fresh databases must seed the new no-Celery kind directly onto its executable River route",
      "proof": [[".venv/bin/pytest", "-q", "tests/test_worker_job_route_baseline_migration.py::test_0094_seeds_only_the_native_coverage_route_and_is_idempotent"]]
    }
  ]
}
