        "provenance": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "repository_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Repository Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "dev_evidence_ref.v1",
          "default": "dev_evidence_ref.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_system": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Source System",
          "type": "string"
        },
        "source_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "valid_entity_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Valid Entity Ids",
          "type": "array"
        }
