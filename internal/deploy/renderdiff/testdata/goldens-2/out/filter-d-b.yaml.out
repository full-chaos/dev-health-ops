apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app: web
  name: web
spec:
  added:
    deep:
      er:
      - 1
      - 2
  flag: 1
  gone1: []
  gone2: {}
  keep: x
  nanv: .nan
  ratio: 1.0
  removedempty: null
  replicas: true
  same: 2.0
  template:
    metadata:
      annotations:
        checksum/config: abd
      labels:
        app: web
        v: '2'
    spec:
      containers:
      - args:
        - <redacted>
        - --plain
        command:
        - run
        - <redacted>
        env:
        - name: PLAIN
          value: v2
        - name: DB_PASSWORD
          value: <redacted>
        - name: API_TOKEN
          value: <redacted>
        - name: SOME_URI
          value: <redacted>
        - name: LINK
          value: see https://example.com/a@c
        - name: X_KEY
          value: <redacted>
        - name: NOVALUE
          valueFrom:
            secretKeyRef:
              key: k2
              name: s
        image: app:2
        name: app
        ports:
        - containerPort: 8080
          protocol: TCP
        - containerPort: 9091
        volumeMounts:
        - mountPath: /data
          name: data
      initContainers: []
      volumes:
      - emptyDir: {}
        name: data
---
apiVersion: v1
binaryData:
  cert.token: <redacted>
data:
  API_KEY: <redacted>
  DB_DSN: <redacted>
  LOG_LEVEL: debug
  PLAIN: three
  monkey: <redacted>
kind: ConfigMap
metadata:
  name: cfg
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: dev-health-ops-postgresql
spec:
  ports:
  - port: 5433
    protocol: UDP
  - port: 5432
  replicas: 2
---
apiVersion: v1
kind: Service
metadata:
  name: svc
spec:
  ports:
  - port: 80
    targetPort: 8081
  - port: 1
